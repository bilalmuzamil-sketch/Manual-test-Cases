# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class

# OS junk
.DS_Store
Thumbs.db

# Ephemeral per-round TestRail update artifacts (dry-run output of gen_update.py,
# overwritten each round; regenerated on demand). Do NOT ignore the real import
# files (fees-discounts-v1-testrail-import.*, simple-flow-v1-testrail-import.*).
testrail-import/*-UPDATE.xml
testrail-import/*-UPDATE.csv
push.err

# Secret fingerprints for scan_secrets.py's FULL mode. Generated by
# build/testing-tools/make_secret_fingerprints.py into /tmp ONLY. This entry is a
# belt-and-braces guard: a SHA-256 of a short or weak secret is brute-forceable, so
# even the HASHES must never enter this PUBLIC repository.
secret-fingerprints.json

# Live log of the detached Global Search capture waiter -- it is appended to while the
# waiter runs, so tracking it makes the tree dirty every few minutes. A final snapshot is
# committed as GS3-wait-final.log when the waiter exits.
build/global-search/tickets-2026-09-14/GS3-wait.log
