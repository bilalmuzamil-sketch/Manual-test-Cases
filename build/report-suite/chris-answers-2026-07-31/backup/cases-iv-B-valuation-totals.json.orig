 {
  "id": "IV-COL-05",
  "area": "IV — Valuation & Columns",
  "title": "Category and Vendor show their names, and an em dash (\"—\") when the part has none",
  "priority": "Medium",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
