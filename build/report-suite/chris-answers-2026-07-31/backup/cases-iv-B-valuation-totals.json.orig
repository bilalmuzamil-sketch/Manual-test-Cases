[
 {
  "id": "IV-COL-01",
  "area": "IV — Valuation & Columns",
  "title": "With every column turned on, the columns appear in the fixed left-to-right order with the specified alignment",
  "priority": "High",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. The Inventory Value report is open with rows loaded.",
   "3. Every column (including Margin and Total Sell) is turned on in the column-selection control."
  ],
  "steps": [
   "1. Read the column headers from left to right.",
   "2. Look at how the values in each column are aligned."
  ],
  "expected": [
   "1. The columns appear in this order: Part #, Description, Category, Vendor, Qty on Hand, Unit Cost, Unit Sell, Margin, Margin %, Total Sell, Total Cost.",
   "2. Part #, Description, Category, and Vendor are left-aligned.",
   "3. Every other column is right-aligned."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 3 S3-R1; S3-R2",
  "viu_status": "VIU-Pending",
  "notes": "",
  "api_related": false
 },
 {
  "id": "IV-COL-02",
  "area": "IV — Valuation & Columns",
  "title": "Value formats: Qty on Hand to two decimals with no currency symbol (fractional supported), money values as US-dollar currency",
  "priority": "High",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. The report shows a part with a fractional on-hand quantity (for example 2.50), one with values over $1,000, and (if producible) one with a negative money value."
  ],
  "steps": [
   "1. Read the Qty on Hand cell of the fractional-quantity part.",
   "2. Read a money value over one thousand dollars (Unit Cost, Unit Sell, Total Sell, or Total Cost).",
   "3. Read a genuine zero money value and a negative one if present."
  ],
  "expected": [
   "1. Qty on Hand shows the on-hand quantity to two decimal places, with no currency symbol; fractional quantities display correctly.",
   "2. Unit Cost and Unit Sell show per-unit prices as US-dollar currency.",
   "3. Money values show a leading \"$\", two decimal places, and thousands separators (for example \"$1,234.56\"); a negative value shows a leading minus before the \"$\" (\"-$1,234.56\"); a genuine zero shows \"$0.00\"."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 3 S3-R3; S3-R4; S3-R5 (display); S3-R10; §4 Terminology (On-hand quantity)",
  "viu_status": "VIU-Pending",
  "notes": "",
  "api_related": false
 },
 {
  "id": "IV-CALC-01",
  "area": "IV — Valuation & Columns",
  "title": "Unit Sell uses the part's fixed sell price when one is set",
  "priority": "Critical",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. A ZZAUTOTEST in-stock part exists with a known unit cost, a known FIXED sell price, and a category whose pricing-matrix markup would give a DIFFERENT figure."
  ],
  "steps": [
   "1. Open the Inventory Value report and find the part's row.",
   "2. Read its Unit Sell value.",
   "3. Compare it to the part's fixed sell price and to the figure the category markup would have produced."
  ],
  "expected": [
   "1. Unit Sell equals the part's fixed sell price.",
   "2. The pricing-matrix markup is NOT applied when a fixed sell price is set — the fixed price wins."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 3 S3-R5 (fixed-price branch); §3 Key Decisions (unit sell resolved like the parts list)",
  "viu_status": "VIU-Pending",
  "notes": "First step of the sell-price fallback chain: fixed price → matrix markup → cost.",
  "api_related": false
 },
 {
  "id": "IV-CALC-02",
  "area": "IV — Valuation & Columns",
  "title": "With no fixed sell price, Unit Sell is the shop's pricing-matrix markup on cost for the part's category",
  "priority": "Critical",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. A ZZAUTOTEST in-stock part exists with a known unit cost, NO fixed sell price, and a category covered by the shop's pricing matrix with a known markup."
  ],
  "steps": [
   "1. Open the Inventory Value report and find the part's row.",
   "2. Read its Unit Sell value.",
   "3. Compare it to the pricing-matrix markup applied to the part's cost for its category."
  ],
  "expected": [
   "1. Unit Sell equals the shop's pricing-matrix markup on cost for that part's category (the same way the parts list resolves it)."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 3 S3-R5 (matrix branch); §5 Assumptions",
  "viu_status": "VIU-Pending",
  "notes": "Second step of the sell-price fallback chain.",
  "api_related": false
 },
 {
  "id": "IV-CALC-03",
  "area": "IV — Valuation & Columns",
  "title": "With no fixed sell price and no category, Unit Sell equals Unit Cost — the stock is valued at cost with a $0.00 / 0.0% margin",
  "priority": "Critical",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. A ZZAUTOTEST in-stock part exists with a known unit cost, NO fixed sell price, and NO category.",
   "3. The Margin and Total Sell columns are turned on."
  ],
  "steps": [
   "1. Open the Inventory Value report and find the part's row.",
   "2. Read its Unit Sell and compare to its Unit Cost.",
   "3. Read its Margin and Margin % cells."
  ],
  "expected": [
   "1. A part with no category takes no markup, so its Unit Sell equals its Unit Cost.",
   "2. Such a part shows a Margin of $0.00 and a Margin % of 0.0% — the stock is valued at cost."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 3 S3-R5 (no-category fallback) + context note; §5 Assumptions",
  "viu_status": "VIU-Pending",
  "notes": "Final step of the sell-price fallback chain — do NOT file the zero margin as a defect; it is the specified cost-valuation fallback.",
  "api_related": false
 },
 {
  "id": "IV-CALC-04",
  "area": "IV — Valuation & Columns",
  "title": "Total Sell is quantity × Unit Sell and Total Cost is quantity × Unit Cost",
  "priority": "Critical",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. A ZZAUTOTEST in-stock part exists with a known on-hand quantity (include a fractional quantity if possible), unit cost, and unit sell.",
   "3. The Total Sell column is turned on."
  ],
  "steps": [
   "1. Open the Inventory Value report and find the part's row.",
   "2. Multiply the on-hand quantity by Unit Sell and compare to Total Sell.",
   "3. Multiply the on-hand quantity by Unit Cost and compare to Total Cost."
  ],
  "expected": [
   "1. Total Sell equals the part's on-hand quantity × Unit Sell, shown as US-dollar currency.",
   "2. Total Cost equals the part's on-hand quantity × Unit Cost, shown as US-dollar currency."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 3 S3-R6; S3-R7; §4 Terminology",
  "viu_status": "VIU-Pending",
  "notes": "",
  "api_related": false
 },
 {
  "id": "IV-CALC-05",
  "area": "IV — Valuation & Columns",
  "title": "Margin is the extended figure — Total Sell minus Total Cost for the whole on-hand quantity, not a per-unit number",
  "priority": "High",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. A ZZAUTOTEST in-stock part exists with a quantity greater than 1 and different unit cost and unit sell values.",
   "3. The Margin and Total Sell columns are turned on."
  ],
  "steps": [
   "1. Open the Inventory Value report and find the part's row.",
   "2. Subtract Total Cost from Total Sell and compare to the Margin cell.",
   "3. Also compute the per-unit difference (Unit Sell − Unit Cost) and confirm Margin is NOT that per-unit figure."
  ],
  "expected": [
   "1. Margin equals Total Sell − Total Cost for the part's whole on-hand quantity, shown as US-dollar currency.",
   "2. Margin is the extended (total) margin, not the per-unit difference."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 3 S3-R8; §3 Key Decisions (extended margin); §4 Terminology",
  "viu_status": "VIU-Pending",
  "notes": "",
  "api_related": false
 },
 {
  "id": "IV-CALC-06",
  "area": "IV — Valuation & Columns",
  "title": "Margin % is Margin as a share of Total Sell to one decimal with a percent sign, showing \"—\" when Total Sell is zero or negative",
  "priority": "High",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. The report shows: a part with a normal positive margin, a part whose Margin % computes negative (unit sell below unit cost), and — if producible — a part whose Total Sell is zero."
  ],
  "steps": [
   "1. Read the normal part's Margin % and check it against Margin ÷ Total Sell × 100.",
   "2. Read the negative-margin part's Margin %.",
   "3. Read the zero-Total-Sell part's Margin % if one exists."
  ],
  "expected": [
   "1. Margin % shows Margin as a percentage of Total Sell, to one decimal place followed by a percent sign — for example \"39.7%\".",
   "2. A Margin % that computes to a real number, including a negative one, shows its signed value.",
   "3. Margin % shows \"—\" when Total Sell is zero or negative (the percentage is undefined)."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 3 S3-R9; S3-E3",
  "viu_status": "VIU-Pending",
  "notes": "",
  "api_related": false
 },
 {
