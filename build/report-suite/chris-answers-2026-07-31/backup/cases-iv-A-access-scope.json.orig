 },
 {
  "id": "IV-NAV-04",
  "area": "IV — Access & Display",
  "title": "Changing the date, location, Category, Vendor, part search, or sort reloads the rows from the server with the standard loading indicator",
  "priority": "High",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. The Inventory Value report is open with rows loaded."
  ],
  "steps": [
   "1. Change the date range and watch the data area.",
   "2. Change the location selection, then the Category filter, then the Vendor filter.",
   "3. Type in the part search, then click a column header to change the sort — watching the data area each time."
  ],
  "expected": [
   "1. Each change — date range, location, Category, Vendor, part search, sort — reloads the report's rows from the server.",
   "2. While loading, the data area shows the standard reports loading indicator.",
   "3. Existing rows are replaced only when the new data returns."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 1 S1-R4; S1-R5; S1-R7",
  "viu_status": "Retired 2026-07-28 (merged into IV-FLT-02 per user-authorized consolidation; delete_case authorized 2026-07-28)",
  "notes": "Every filter on this report is server-side (Story 6 context note) — only the column selection is client-side. VIU-confirm the loading indicator's appearance.",
  "api_related": false
 },
 {
  "id": "IV-NAV-05",
  "area": "IV — Access & Display",
  "title": "The report is server-paginated: one page of rows at a time, and any filter/search/sort change returns to the first page",
  "priority": "Critical",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. The selected location(s) hold more in-stock parts than fit on one page (seed ZZAUTOTEST parts if needed)."
  ],
  "steps": [
   "1. Open the Inventory Value report and find the pagination control.",
   "2. Move to page 2 (and further) and watch the rows.",
   "3. From a later page, change a server-side filter (for example select a Category), then check which page is shown.",
   "4. Repeat from a later page with a part search and with a sort change."
  ],
  "expected": [
   "1. The server returns one page of rows at a time; the user moves through pages with the reports suite's standard pagination control.",
   "2. Changing any server-side filter (Date, Location, Category, Vendor), the part search, or the sort returns the FIRST page of the new result set."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 1 S1-R8; §2 Scale and data model",
  "viu_status": "VIU-Pending",
  "notes": "The report is built for ~50–60k parts per org across locations, fully server-side (§2). VIU-confirm the page size and the pagination control's exact appearance (suite standard).",
  "api_related": false
 },
 {
  "id": "IV-NAV-06",
  "area": "IV — Access & Display",
  "title": "No qualifying parts, day or location: the no-data message shows and no totals",
  "priority": "High",
  "type": "Negative",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. Three causes can be produced: (a) a location you can access holds no in-stock parts, (b) a past range ends entirely before nightly recording began (or its covered dates were pruned by retention), (c) the filters can be set so nothing qualifies."
  ],
  "steps": [
   "1. Scope the report to the empty location and read the data area.",
   "2. Select a Custom range ending before nightly recording began and read the data area and the bottom of the report.",
   "3. Set the filters so nothing qualifies and re-read."
  ],
  "expected": [
   "1. In every case the report shows the standard reports no-data message \"Empty bays, endless possibilities. Get Going!\" instead of rows.",
   "2. No totals row is shown in any of the cases."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 1 S1-N2; Story 5 S5-N1; Story 7 S7-N2; Story 12; §7 User Feedback Summary",
  "viu_status": "VIU-Pending",
  "notes": "No-data message text is verbatim from §7. MERGED 2026-07-28 (user-authorized consolidation, MERGE-PLAN G-IV-EMPTY): absorbed IV-DATE-07, IV-LOC-05. Members retired locally + deleted from TestRail; bodies kept in cases/ marked Retired.",
  "api_related": false
 },
 {
  "id": "IV-SCOPE-01",
  "area": "IV — Row Scope",
  "title": "A part appears only if not a core charge and on-hand quantity is above zero",
  "priority": "Critical",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. ZZAUTOTEST parts exist at your active location: a normal part with positive on-hand quantity, a core-charge part with a positive quantity, a part with exactly zero on-hand quantity, and (if producible) one with a negative on-hand quantity."
  ],
  "steps": [
   "1. Open the Inventory Value report scoped to the location.",
   "2. Look for the normal in-stock part.",
   "3. Search for the core-charge part, the zero-quantity part, and the negative-quantity part by part number; check the totals row."
  ],
  "expected": [
   "1. The normal, positive-quantity, non-core part appears as one row.",
   "2. The core-charge part is never listed — even with a positive quantity — and its value is not counted in the totals row.",
   "3. The zero-quantity and negative-quantity parts are not listed — only quantities greater than zero are valued.",
   "4. Only parts meeting BOTH conditions — not a core charge, and on-hand quantity greater than zero — are listed."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 2 S2-R1; S2-R2; S2-N1; S2-N2; §3 Key Decisions",
  "viu_status": "VIU-Pending",
  "notes": "MERGED 2026-07-28 (user-authorized consolidation, MERGE-PLAN G-IV-SCOPE): absorbed IV-SCOPE-03, IV-SCOPE-04. Members retired locally + deleted from TestRail; bodies kept in cases/ marked Retired.",
  "api_related": false
 },
 {
  "id": "IV-SCOPE-02",
  "area": "IV — Row Scope",
  "title": "A part stocked at two selected locations appears as two rows (one per location), not merged — expected, do not file",
  "priority": "High",
  "type": "Functional",
  "permissions_required": "A user with access to at least two locations and the inventory-reports permission.",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser as a user with access to at least two locations.",
   "2. The same ZZAUTOTEST part is in stock (positive quantity) at two of those locations."
  ],
  "steps": [
   "1. Open the Inventory Value report and select both locations in the Location filter.",
   "2. Search for the part and count its rows."
  ],
  "expected": [
   "1. The part appears twice — one row per location, each with that location's own quantity and values.",
   "2. The rows are NOT merged into one combined row; this is the documented v1 behavior."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 2 S2-R3; §2 Known Limitations (v1)",
  "viu_status": "VIU-Pending",
  "notes": "DOCUMENTED LIMITATION — DO NOT FILE. One row per part per location is a deliberate v1 boundary.",
  "api_related": false
 },
 {
