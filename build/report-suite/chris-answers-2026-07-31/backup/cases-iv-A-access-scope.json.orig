[
 {
  "id": "IV-NAV-01",
  "area": "IV — Access & Display",
  "title": "Inventory Value appears in the reports navigation under the Parts group",
  "priority": "Critical",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (the report reuses it and adds no new permission — Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. Your role has the existing inventory-reports permission."
  ],
  "steps": [
   "1. Open the reports navigation.",
   "2. Look inside the Parts group of reports.",
   "3. Click the \"Inventory Value\" entry."
  ],
  "expected": [
   "1. The reports navigation lists a report labeled \"Inventory Value\" under the Parts group.",
   "2. Clicking it opens the Inventory Value report."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 1 S1-R1",
  "viu_status": "VIU-Pending",
  "notes": "VIU-confirm the exact reports-navigation structure and the Parts group's on-screen label live. COMPANION-VIDEO 2026-07-30 (C2a/C3, 00:35-01:18): IV under the new Parts section confirmed ('Parts Velocity and Inventory Value will live under here'); order inside the section PO-flexible — do not fail on PV-vs-IV order.",
  "api_related": false
 },
 {
  "id": "IV-NAV-02",
  "area": "IV — Access & Display",
  "title": "Opening the report shows one row per in-stock part at the selected location(s), valued as of the resolved date",
  "priority": "Critical",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser.",
   "2. Several ZZAUTOTEST parts with positive on-hand quantity exist at your active location."
  ],
  "steps": [
   "1. Open the Inventory Value report.",
   "2. Compare the rows shown to the in-stock parts at the selected location(s).",
   "3. Note the date range in the toolbar and which date the values represent."
  ],
  "expected": [
   "1. The report shows one row for each in-stock part at the selected location(s).",
   "2. The values are valued as of the resolved date (the current stock for a range reaching today, or the closest recorded nightly snapshot for an earlier date — see the IV — As-of Date & Snapshots cases)."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 1 S1-R2; S1-R6",
  "viu_status": "VIU-Pending",
  "notes": "",
  "api_related": false
 },
 {
  "id": "IV-NAV-03",
  "area": "IV — Access & Display",
  "title": "On a first visit the report defaults to the current calendar month and the user's currently active location",
  "priority": "High",
  "type": "Functional",
  "permissions_required": "A role with the existing inventory-reports permission (Story 1 prerequisite).",
  "preconditions": [
   "1. You are signed in to the ShopView App on a desktop browser that has never saved settings for this report (fresh browser profile or cleared site data)."
  ],
  "steps": [
   "1. Open the Inventory Value report.",
   "2. Read the date-range control's value.",
   "3. Read the Location filter's selection."
  ],
  "expected": [
   "1. The date range defaults to the current calendar month.",
   "2. The location defaults to the user's currently active location."
  ],
  "design_ref": "none — design not yet available (spec-only authoring)",
  "spec_ref": "specs/inventory-value.md Story 1 S1-R3; Story 7 S7-R2",
  "viu_status": "VIU-Pending",
  "notes": "",
