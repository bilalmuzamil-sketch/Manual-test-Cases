      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Returning it: "
        },
        {
         "type": "text",
         "text": "POST /api/work-orders/part/make-return-request {part_id, work_order_id, quantity, return_reason}",
         "marks": [
          {
           "type": "code"
          }
         ]
        },
        {
         "type": "text",
         "text": " \u2192 200. Two traps: "
