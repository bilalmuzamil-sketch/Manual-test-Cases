://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":["FS-Schedule","QAComplete_Ayesha_Khan"],"customfield_10016":null,"customfield_10019":"0|i01vap:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32069","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32069","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54709","key":"SV-8687","self":"https://shopview.atlassian.net/rest/api/3/issue/54709","fields":{"summary":"Work Order Sidebar & Mini Calendar","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10006","description":"(Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/","name":"TESTING QA","id":"10006","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-05T19:00:57.365-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10006","description":"(Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/","name":"TESTING QA","id":"10006","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"The work order filters on the left of the Schedule can be switched on one at a time but not switched off in one go - there is no 'Clear all'. There is also nothing on the Filters button to show that filters are currently applied or how many, so a planner can easily be looking at a filtered list and not realise it, and then has to hunt through three groups of tick boxes to undo it."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Branch / Environment"}]},{"type":"paragraph","content":[{"type":"text","text":"Branch tested: https://sv8685.qa.shopview.com/schedule · API host: https://sv8685api.qa.shopview.com · Build marker (meta app-version): v3.5-4873abe · index.html last-modified Tue, 04 Aug 2026 14:47:39 GMT, etag 9b4b1fc776ebbfb04a9a0ca051d847f7 · Organisation d55bc308-e61a-438d-b5f1-c7a73c89d49f · Location: Staging Heavy Duty - 9919 (b3c8c820-f815-4cf1-8938-10956c5ee71a, timezone America/Edmonton) · Signed in as admin@shopview.com (Administrator) · Observed 2026-08-04, 16:00-19:00 UTC."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"orderedList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the Schedule."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Click 'Filters' in the left-hand panel."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Tick 'Unassigned' under Assignment and 'Approved' under Status."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Close the popover and note the work order list is now narrowed."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Look at the Filters button for any badge or count showing that filters are on."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the popover again and look for a 'Clear all' control."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The Filters button carries a small count of how many filters are applied, and the popover has a 'Clear all' that resets every filter in one click."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"There is no count on the button and no 'Clear all' anywhere in the popover. Each tick box has to be unticked individually."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Images"}]},{"type":"paragraph","content":[{"type":"text","text":"No screenshot is attached. The evidence for this ticket is a captured DOM/state reading rather than a visual difference; the exact values are in the technical section below."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Technical details for developers"}]},{"type":"paragraph","content":[{"type":"text","text":"Enumerated the popover's contents: heading 'FILTERS' then checkbox_sidebar_assignment_unassigned / _assigned, checkbox_sidebar_status_{estimate,approved,in_progress,declined,ready_for_review,complete,invoiced,paid} and checkbox_sidebar_priority_{high,medium,low}, each with its live count. No clear-all button and no badge element on button_sidebar_filters. Spec section 5.1: 'Filters live behind a \"Filter\" button (with an active-count badge); there are no assignment tabs. Applying a filter narrows the flat card list, and \"Clear all\" resets in one click.'"}]}]},"customf