i/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T02:49:13.129-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3,"localId":"48900ac55f4c"},"content":[{"type":"text","text":"Environment"}]},{"type":"paragraph","content":[{"type":"text","text":"QA branch https://sv8785.qa.shopview.com/workorders "}],"attrs":{"localId":"fd385ac0ba5f"}},{"type":"heading","attrs":{"level":3,"localId":"270f4f6e14b9"},"content":[{"type":"text","text":"Steps to Reproduce"}]},{"type":"orderedList","attrs":{"order":1,"localId":"55a71d2674ef"},"content":[{"type":"listItem","attrs":{"localId":"878a641b4192"},"content":[{"type":"paragraph","content":[{"type":"text","text":"On a phone (or a browser window 390 pixels wide), sign in and open this address: https://sv8785.qa.shopview.com/workorders?status=declined&tab=all"}],"attrs":{"localId":"c6adc8f1072d"}}]},{"type":"listItem","attrs":{"localId":"29637dc19a06"},"content":[{"type":"paragraph","content":[{"type":"text","text":"Look at the filter buttons above the list."}],"attrs":{"localId":"8fc406542baf"}}]},{"type":"listItem","attrs":{"localId":"9be128b8a422"},"content":[{"type":"paragraph","content":[{"type":"text","text":"Look at the status shown on the work order cards below them."}],"attrs":{"localId":"4492fe5554b4"}}]}]},{"type":"heading","attrs":{"level":3,"localId":"e4977aef988b"},"content":[{"type":"text","text":"Expected Result"}]},{"type":"paragraph","content":[{"type":"text","text":"The page opens with the Declined filter already applied and the cards below show only Declined work orders, exactly as it does on a desktop screen."}],"attrs":{"localId":"e19cbbb51422"}},{"type":"heading","attrs":{"level":3,"localId":"18098471599e"},"content":[{"type":"text","text":"Current Result"}]},{"type":"paragraph","content":[{"type":"text","text":"The filter buttons say filters are on — \"All Filters (1)\" and \"Status (1)\" are both highlighted in blue — but the cards listed are all Estimate work orders for the customer Aagate Landscaping, starting with S2-15017, S2-14846 and S2-13145. "}],"attrs":{"localId":"3731306aa6b5"}},{"type":"heading","attrs":{"level":3,"localId":"fa37f0502e65"}},{"type":"heading","attrs":{"level":3,"localId":"70701395d6f5"},"content":[{"type":"text","text":"Technical detail"}]},{"type":"paragraph","content":[{"type":"text","text":"With the URL above, the list request the phone sends is GET /api/work-orders?...&filters[0][field]=status&filters[0][value]=estimate&search=&showMyWorkOrders=0 — the value is \"estimate\", not the \"declined\" the URL asked for. The same happens with a second filter in the URL: the buttons read \"All Filters (2)\" / \"Status (1)\" / \"Customer (1)\" while the request is still status=estimate. Tapping the Status button then Paid sends filters[0][value]=paid correctly and the cards change to Paid, so the fault is specific to filter state arriving from the address bar. Specification reference S11-R2."}],"attrs":{"localId":"5b76eee68a98"}},{"type":"mediaSingle","attrs":{"width":412,"widthType":"pixel","localId":"e870d96bd011","layout":"align-start"},"content":[{"type":"media","attrs":{"type":"file","id":"7d8081e6-e8ae-498d-ad5f-a028429046bc","alt":"image-20260805-025923.png","collection":"","localId":"52fd4530752c","height":787,"width":412}}]},{"type":"paragraph","attrs":{"localId":"a4554c6627e3"}},{"type":"mediaSingle","attrs":{"width":402,"widthType":"pixel","localId":"6d694337d711","layout":"align-start"},"content":[{"type":"media","attrs":{"type":"file","id":"79cea153-1115-48bd-85a2-550147615ccd","alt":"image-20260805-025741.png","collection":"","localId":"92b0c3ce294b","height":791,"width":402}}]},{"type":"paragraph","content":[{"type":"text","text":" "}]},{"type":"paragraph","content":[{"type":"text","text":"Where this expected behaviour comes from: the Filters specification, version 18, requirement S11-R2, which says: \"When a user opens a URL that contains filter state, the Work Orders page loads with those filters pre-applied and the table already filtered\"."}]},{"type":"paragraph","content":[{"type":"text","text":"That the same must hold on a phone comes from requirement S12-R2, which says: \"The filter chips behave like desktop with one exception (see S12-R5): tapping a chip opens its dropdown, selections update the chip appearance, and “Clear filters” appears when active\". The one exception it names is about staging selections behind an Apply button, not about which records are listed."}]}]},"customfield_10252":null,"timetracking":{},"customfield_10015":null,"security":null,"attachment":[{"self":"https://shopview.atlassian.net/rest/api/3/attachment/59318","id":"59318","filename":"image-20260805-025741.png","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finit