west-2.prod.public.atl-paas.net%2Finitials%2FSM-1.png"},"displayName":"Slavcho Mitrov","active":true,"timeZone":"America/Bogota","accountType":"atlassian"},"body":"[~accountid:712020:aa00b8d6-a71f-4259-8919-82a304227c20] two details:\n\n# After arrowing onto a group header and tabbing out and back in, focus returns to a work order row, not the header, while any row is shown.\n# On Board View, if the last-focused card has scrolled out of its column, Tab lands on the first card in view.\n\nOK?","updateAuthor":{"self":"https://shopview.atlassian.net/rest/api/2/user?accountId=712020%3A1b27a800-7b5a-43f3-982a-81e7071a4fdb","accountId":"712020:1b27a800-7b5a-43f3-982a-81e7071a4fdb","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/32366c118499b215991a54cfdb2cb1c4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSM-1.png","24x24":"https://secure.gravatar.com/avatar/32366c118499b215991a54cfdb2cb1c4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSM-1.png","16x16":"https://secure.gravatar.com/avatar/32366c118499b215991a54cfdb2cb1c4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSM-1.png","32x32":"https://secure.gravatar.com/avatar/32366c118499b215991a54cfdb2cb1c4?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FSM-1.png"},"displayName":"Slavcho Mitrov","active":true,"timeZone":"America/Bogota","accountType":"atlassian"},"created":"2026-10-16T10:01:56.379-0500","updated":"2026-10-16T10:01:56.379-0500","jsdPublic":true},{"self":"https://shopview.atlassian.net/rest/api/2/issue/57916/comment/78893","id":"78893","author":{"self":"https://shopview.atlassian.net/rest/api/2/user?accountId=712020%3Aaa00b8d6-a71f-4259-8919-82a304227c20","accountId":"712020:aa00b8d6-a71f-4259-8919-82a304227c20","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/b59acd73249e0b9e1cc3b64c79748f37?d=https%3A%2F%2Favatar-mana