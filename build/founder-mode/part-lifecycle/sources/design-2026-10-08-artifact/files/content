; background: #ffffff; position: relative; min-height: 17px; }\n    .field--req { border-color: #2563EB; }\n    .flabel { position: absolute; top: 4px; left: 12px; font-size: 9.5px; color: #6b7480; }\n    .flabel--req { color: #2563EB; }\n    .caret { position: absolute; right: 11px; top: 17px; }\n    .btn { font-size: 13px; font-weight: 600; padding: 8px 18px; border-radius: 5px; display: inline-block; }\n    .btn--primary { background: #2563EB; color: #ffffff; }\n    .btn--danger { background: #D32F2F; color: #ffffff; }\n    .btn--ok { background: #1FA65A; color: #ffffff; }\n    .btn--flat { color: #3d4654; }\n    .btn--out { border: 1px solid #2563EB; color: #2563EB; }\n    .secthd { font-size: 15px; font-weight: 700; color: #1f2430; margin-top: 4px; }\n    .pill { display: inline-block; border-radius: 4px; padding: 3px 9px; font-size: 11px; font-weight: 700; color: #ffffff; }\n    .cap { font-size: 12px; color: #5b6472; line-height: 1.6; }\n    .note { background: #f8f9fb; border: 1px solid #eceef1; border-radius: 6px; padding: 13px 15px; font-size: 12px; color: #5b6472; line-height: 1.6; }\n    .sect { border: 1px solid #e6e9ed; border-radius: 6px; padding: 12px 13px; }\n    .secttitle { font-size: 10.5px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #6b7480; margin-bottom: 9px; }\n    .tracktitle { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #2563EB; margin-bottom: 11px; }\n    .trackhint { font-size: 11.5px; color: #2563EB; margin-top: 7px; }\n    .colhd { font-size: 10.5px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #9aa2ad; }\n    .badgebar { padding: 10px 20px 0; }\n    .badge { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: 0.06em; padding: 3px 9px; border-radius: 3px; color: #ffffff; }\n    .badge--before { background: #C10015; }\n    .badge--after { background: #1FA65A; }\n    .badge--new { background: #2563EB; }\n  </style>\n</helmet>\n\n\n<div class=\"badgebar\"><span class=\"badge badge--before\">BEFORE &middot; WHAT IS ON STAGING TODAY</span></div>\n\n<div style=\"padding: 14px 20px 22px; display: flex; flex-direction: column; gap: 14px;\">\n\n  <div>\n    <div class=\"ptitle\">New Part Request, on a work order</div>\n    <div class=\"cap\" style=\"margin-top: 3px;\">The part number field is the lookup. This is the screen the whole feature is for: everything else exists so that this list gets shorter.</div>\n  </div>\n\n  <div style=\"display: grid; grid-template-columns: minmax(0, 520px) minmax(0, 1fr); gap: 26px; align-items: start;\">\n\n    <div class=\"modal\">\n      <div class=\"mhd\">\n        <div class=\"mtitle\">New Part Request</div>\n        <svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#2563EB\" stroke-width=\"2.2\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\"></path></svg>\n      </div>\n\n      <div style=\"background: #eceef1; border-bottom: 2px solid #2563EB; border-radius: 4px 4px 0 0; padding: 9px 11px 7px; position: relative;\">\n        <span style=\"position: absolute; top: 3px; left: 11px; font-size: 9px; color: #2563EB;\">Part Number</span>\n        <div style=\"font-size: 13px; color: #1f2430;\">oil filter</div>\n        <svg class=\"caret\" style=\"top: 14px;\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#6b7480\" stroke-width=\"2.4\" stroke-linecap=\"round\"><polyline points=\"18 15 12 9 6 15\"></polyline></svg>\n      </div>\n\n      <div style=\"border: 1px solid #e2e5ea; border-radius: 0 0 6px 6px; box-shadow: 0 6px 18px rgba(20,24,33,0.10);\">\n        <div style=\"padding: 11px 13px; border-bottom: 1px solid #f4f5f7;\">\n          <div style=\"display: flex; justify-content: space-between; gap: 14px;\"><span style=\"font-size: 13px; color: #1f2430;\">ENGINE OIL FILTER, CUMMINS 6BT</span><span style=\"font-size: 13px; color: #1f2430; white-space: nowrap;\">LF3349</span><