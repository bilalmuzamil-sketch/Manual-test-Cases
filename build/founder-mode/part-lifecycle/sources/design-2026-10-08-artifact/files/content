n { padding: 6px 16px; font-size: 11.5px; color: #2563EB; font-weight: 600; display: flex; align-items: center; gap: 8px; }\n    .dot { width: 11px; height: 11px; border-radius: 2px; background: #c6ccd4; flex: 0 0 11px; }\n    .doton { width: 11px; height: 11px; border-radius: 2px; background: #2563EB; flex: 0 0 11px; }\n    .ptitle { font-size: 16px; font-weight: 700; color: #1f2430; }\n    .ctrl { font-size: 11.5px; color: #3d4654; display: flex; align-items: center; gap: 5px; }\n    .primary { background: #2563EB; color: #ffffff; font-size: 11.5px; font-weight: 600; border-radius: 6px; padding: 7px 14px; }\n    .tbl { width: 100%; border-collapse: collapse; background: #ffffff; }\n    .tbl th { text-align: left; font-size: 10.5px; font-weight: 700; color: #3d4654; padding: 8px 10px; border-bottom: 1px solid #eceef1; white-space: nowrap; }\n    .tbl td { font-size: 11px; color: #1f2430; padding: 8px 10px; border-bottom: 1px solid #f4f5f7; white-space: nowrap; }\n    .qty { display: inline-block; background: #E98B3A; color: #ffffff; border-radius: 4px; padding: 2px 7px; font-size: 9.5px; font-weight: 700; }\n    .qty--ok { background: #1FA65A; }\n    .untracked { font-size: 10.5px; color: #9aa2ad; }\n    .bin { display: inline-flex; align-items: center; border: 1px solid #e2e5ea; border-radius: 4px; overflow: hidden; font-size: 9.5px; color: #3d4654; }\n    .bin span { padding: 2px 6px; }\n    .bin span + span { border-left: 1px solid #e2e5ea; }\n    .cbox { width: 12px; height: 12px; border: 1px solid #aeb5bf; border-radius: 2px; display: inline-block; }\n    .cboxon { width: 12px; height: 12px; border-radius: 2px; background: #2563EB; display: inline-block; }\n    .link { color: #2563EB; }\n    .tab { font-size: 12px; color: #6b7480; margin-right: 18px; display: inline-block; }\n    .tabon { font-size: 12px; color: #2563EB; margin-right: 18px; display: inline-block; }\n    .modal { background: #ffffff; border-radius: 8px; box-shadow: 0 8px 30px rgba(20,24,33,0.16); padding: 20px 22px 18px; display: flex; flex-direction: column; gap: 13px; }\n    .mhd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2px; }\n    .mtitle { font-size: 17px; font-weight: 700; color: #1f2430; }\n    .field { border: 1px solid #d8dce2; border-radius: 5px; padding: 15px 12px 8px; font-size: 13px; color: #1f2430; background: #ffffff; position: relative; min-height: 17px; }\n    .field--req { border-color: #2563EB; }\n    .flabel { position: absolute; top: 4px; left: 12px; font-size: 9.5px; color: #6b7480; }\n    .flabel--req { color: #2563EB; }\n    .caret { position: absolute; right: 11px; top: 17px; }\n    .btn { font-size: 13px; font-weight: 600; padding: 8px 18px; border-radius: 5px; display: inline-block; }\n    .btn--primary { background: #2563EB; color: #ffffff; }\n    .btn--danger { background: #D32F2F; color: #ffffff; }\n    .btn--ok { background: #1FA65A; color: #ffffff; }\n    .btn--flat { color: #3d4654; }\n    .btn--out { border: 1px solid #2563EB; color: #2563EB; }\n    .secthd { font-size: 15px; font-weight: 700; color: #1f2430; margin-top: 4px; }\n    .pill { display: inline-block; border-radius: 4px; padding: 3px 9px; font-size: 11px; font-weight: 700; color: #ffffff; }\n    .cap { font-size: 12px; color: #5b6472; line-height: 1.6; }\n    .note { background: #f8f9fb; border: 1px solid #eceef1; border-radius: 6px; padding: 13px 15px; font-size: 12px; color: #5b6472; line-height: 1.6; }\n    .sect { border: 1px solid #e6e9ed; border-radius: 6px; padding: 12px 13px; }\n    .secttitle { font-size: 10.5px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: #6b7480; margin-bottom: 9px; }\n    .tracktitle { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #2563EB; margin-bottom: 11px; }\n    .trackhint { font-size: 11.5px; color: #2563EB; margin-top: 7px; }\n    .colhd { font-size: 10.5px; font-weight: 700; letter-spacing: 0.05em; text-