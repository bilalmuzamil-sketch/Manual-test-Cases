{
 "height": 900,
 "themes": {
  "light": {
   "color_scheme": "light",
   "eval": [
    "window.ShopviewTheme && ShopviewTheme.set('light')"
   ]
  },
  "dark": {
   "color_scheme": "dark",
   "eval": [
    "window.ShopviewTheme && ShopviewTheme.set('dark')"
   ]
  }
 },
 "token_prefer": [
  "--sv-text-",
  "--sv-accent",
  "--sv-surface",
  "--sv-border-",
  "--sv-success",
  "--sv-warning",
  "--sv-danger",
  "--sv-info",
  "--sv-cat-",
  "--sv-elev-",
  "--sv-"
 ],
 "icon_registry_js": "window.SV_LUCIDE",
 "icon_registry_files": [
  {
   "file": "lucide-icons.js",
   "var": "SV_LUCIDE"
  }
 ],
 "token_prefer_bg": [
  "--sv-surface",
  "--sv-accent",
  "--sv-border-",
  "--sv-success",
  "--sv-warning",
  "--sv-danger",
  "--sv-info",
  "--sv-cat-",
  "--sv-elev-",
  "--sv-text-",
  "--sv-"
 ],
 "regions": [
  [
   "tooltip",
   "[role=tooltip]"
  ],
  [
   "row menu",
   "[role=menu]"
  ],
  [
   "dialog",
   "[role=dialog]"
  ],
  [
   "toast",
   "[role=status]"
  ],
  [
   "open popover",
   ".sv-popover, #__open_popover"
  ],
  [
   "display switcher",
   "[role=group][aria-label=View]"
  ],
  [
   "toolbar",
   "div[data-popover-host][style*='padding: 16px 24px']"
  ],
  [
   "app header",
   "header"
  ],
  [
   "Tech View column header row",
   "div[style*='grid-template-columns'][style*='position: sticky']"
  ],
  [
   "Tech View group header",
   "section[data-group-id] > div[data-gdrag]"
  ],
  [
   "Tech View work order row",
   "div[data-wo][style*='grid-template-columns']"
  ],
  [
   "Board column header",
   "section[data-group-id] > div > div[data-gdrag]"
  ],
  [
   "Board card",
   "div[data-wo][style*='flex-direction: column']"
  ],
  [
   "Board column",
   "section[data-group-id]"
  ],
  [
   "minimap",
   "[data-mm]"
  ],
  [
   "List table header",
   "thead"
  ],
  [
   "List row",
   "tbody tr"
  ],
  [
   "drag drop line / refusal pill",
   "div[style*='z-index: 350'], div[style*='z-index: 400']"
  ]
 ],
 "column_header_rows": [
  "thead tr",
  "div[style*='grid-template-columns'][style*='position: sticky']"
 ],
 "cell_rows": [
  "tbody tr",
  "div[data-wo][style*='grid-template-columns']"
 ],
 "row_types": {
  "Tech View group header": "section[data-group-id] > div[data-gdrag]",
  "Tech View work order row": "div[data-wo][style*='grid-template-columns']",
  "Board column header": "section[data-group-id] > div > div[data-gdrag]",
  "Board card": "div[data-wo][style*='flex-direction: column']",
  "Empty group or column": "section[data-group-id] div[style*='dashed'], section[data-group-id] > div[style*='justify-content: center']",
  "Empty / first-run state": "div[style*='min-height: 420px'], div[style*='min-height: 320px'], div[style*='padding: 32px 24px']",
  "List row": "tbody tr",
  "Filter chip": "div[data-popover-host] button[aria-expanded], div[data-popover-host] > div > div > button",
  "Toolbar button": "button[title='Columns'], button[title='Row height'], button[title='Card size']"
 },
 "frame_targets": [
  {
   "name": "Tech View table (column header row)",
   "selector": "div[style*='grid-template-columns'][style*='position: sticky']"
  },
  {
   "name": "Tech View first group header",
   "selector": "section[data-group-id] > div[data-gdrag]"
  },
  {
   "name": "Board View column strip",
   "selector": "div[style*='width: max-content'][style*='gap: 16px']"
  },
  {
   "name": "Board View first column",
   "selector": "section[data-group-id] > div[style*='border-radius: 12px']"
  },
  {
   "name": "List table",
   "selector": "table"
  },
  {
   "name": "Toolbar",
   "selector": "div[data-popover-host][style*='padding: 16px 24px']"
  },
  {
   "name": "Empty state block",
   "selector": "div[style*='min-height: 320px'], div[style*='min-height: 420px']"
  }
 ],
 "overlay_selectors": [
  "[role=tooltip]",
  "[role=menu]",
  "[role=dialog]",
  ".sv-popover",
  "#__open_popover",
  "span[style*='bottom: calc(100% + 6px)']",
  "[role=status]",
  "div[style*='z-index: 400']",
  "div[style*='z-index: 350']"
 ],
 "sticky_probes": [
  {
   "name": "Tech View column header row (scroll down 400)",
   "selector": "div[style*='grid-template-columns'][style*='position: sticky']",
   "dy": 400
  },
  {
   "name": "Tech View 'Esther Howard' group header (scroll down 200)",
   "selector": "section[data-group-id='esther'] > div[data-gdrag]",
   "dy": 200
  },
  {
   "name": "Tech View Unassigned group header (scroll down 200)",
   "selector": "section[data-group-id='unassigned'] > div[data-gdrag]",
   "dy": 200
  },
  {
   "name": "Board 'Unassigned' column (scroll right 800)",
   "selector": "section[data-group-id='unassigned']",
   "dx": 800,
   "dy": 0
  },
  {
   "name": "Board 'Esther Howard' column header (scroll its cards down 300)",
   "selector": "section[data-group-id='esther'] > div > div[data-gdrag]",
   "dy": 300
  }
 ],
 "accent_token": "--sv-accent",
 "max_rows": 40,
 "row_key_attr": "data-wo",
