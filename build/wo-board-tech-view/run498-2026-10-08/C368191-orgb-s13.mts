/** 16 Oct 2026 (batch 40) — read only, Analyst 1's company: what is the "Deleted user" on work order S1-3? Its lines' labor entries (staff
 *  ids, names, minutes), whether each staff id still exists (staff view / staff list), the line logs, and the company's technicians.
 *  Pictures EV/C368191-orgb-s13-*.png. */
import fs from 'node:fs'; import path from 'node:path';
import { analystBrowser } from './analyst.mts'; import { EV, t } from './wob.mts';
const A = await analystBrowser('/workorders?tab=all'); const p = A.page, a = A.api; const o: any = {};
const wl = ((await a.get('/api/work-orders?tab=all&pagination[rowsPerPage]=200&search=S1-3')).body?.data?.work_orders ?? []) as any[]; const w = wl.find((x) => x.number === 'S1-3'); o.wo = w ? { n: w.number, s: w.status, lead: w.techAssignedFirstName, co: w.companyName } : 'not found';
if (w) { const d = (await a.get(`/api/work-orders/lines/${w.id}`)).body?.data; const ls: any[] = Array.isArray(d) ? d : d?.collection ?? [];
  const ids = new Set<string>(); const ent: any[] = [];
  const walk = (x: any, at: string) => { if (!x || typeof x !== 'object') return; if (Array.isArray(x)) return x.forEach((y, i) => walk(y, `${at}[${i}]`)); const sid = x.staff_id ?? x.staffId ?? x.tech_assigned_id ?? x.technician_id ?? null; if (sid && typeof sid === 'string') { ids.add(sid); ent.push({ at: at.slice(0, 60), sid: sid.slice(0, 8), name: x.name ?? x.staff_name ?? x.technician_name ?? ([x.first_name, x.last_name].filter(Boolean).join(' ') || null), start: x.start_date ?? x.created_at ?? null, end: x.end_date ?? null, mins: x.minutes ?? x.total_time ?? x.duration ?? null }); } for (const [k, v] of Object.entries(x)) if (v && typeof v === 'object') walk(v, `${at}.${k}`); };
  ls.forEach((l, i) => walk(l, `line${i + 1}`)); o.lines = ls.map((l: any) => `${String(l.line_name ?? '').trim()} ${l.status} est=${l.time_estimate} labour=${l.total_labour_time}`); o.entries = ent.slice(0, 20);
  o.staff = {}; for (const sid of ids) { const v = await a.get(`/api/staff/${sid}/view`); o.staff[sid.slice(0, 8)] = `${v.status} ${JSON.stringify(v.body?.data ? { n: `${v.body.data.first_name ?? ''} ${v.body.data.last_name ?? ''}`, act: v.body.data.is_active, del: v.body.data.deleted_at ?? null } : v.body).slice(0, 140)}`; }
  await p.goto(`${A.APP}/workorders/${w.id}/lines`, { waitUntil: 'domcontentloaded' }); await p.waitForTimeout(7000); o.labor = await p.evaluate(`[...document.querySelectorAll('[data-test-id^="line_labor_name_"]')].map(e => e.getAttribute('data-test-id').slice(-8) + '=' + e.innerText.replace(/\\s+/g, ' ').trim())`);
  await p.screenshot({ path: path.join(EV, 'C368191-orgb-s13-lines.png') });
  // the line's own Audit log (line number > Audit log, visible menu)
  const nums = await p.evaluate(`[...document.querySelectorAll('[data-test-id^="line_number_"]')].map(e => e.getAttribute('data-test-id').replace('line_number_', ''))`) as string[]; o.lineIds = nums.map((x) => x.slice(0, 8));
  for (const [i, lid] of nums.entries()) { await p.locator(`[data-test-id="line_number_${lid}"]`).click().catch(() => {}); await p.waitForTimeout(1200);
    await p.evaluate(`(() => { const it = [...document.querySelectorAll('.q-menu .q-item')].filter(e => e.getBoundingClientRect().width > 20).filter(e => /^Audit log$/i.test(e.innerText.trim())).pop(); if (it) it.click(); })()`); await p.waitForTimeout(3000);
    o[`log${i + 1}`] = await p.evaluate(`(() => { const d = [...document.querySelectorAll('.q-dialog')].filter(e => e.getBoundingClientRect().width > 0).pop(); return d ? [...d.querySelectorAll('tbody tr')].map(r => r.innerText.replace(/\\s+/g, ' ').trim()).slice(0, 15) : null; })()`); await p.screenshot({ path: path.join(EV, `C368191-orgb-s13-line${i + 1}-log.png`) }); await p.keyboard.press('Escape'); await p.waitForTimeout(800); }
  // the work order log
  await p.locator('[data-test-id="button_work_order_nav_bar_menu"]').click().catch(() => {}); await p.waitForTimeout(1000); await p.evaluate(`(() => { const it = [...document.querySelectorAll('.q-menu .q-item')].filter(e => e.getBoundingClientRect().width > 20).filter(e => /^(Audit Log|Timesheets.*)$/i.test(e.innerText.trim()))[0]; if (it) it.click(); })()`); await p.waitForTimeout(3000);
  o.woLog = await p.evaluate(`(() => { const d = [...document.querySelectorAll('.q-dialog')].filter(e => e.getBoundingClientRect().width > 0).pop(); return d ? [...d.querySelectorAll('tbody tr')].map(r => r.innerText.replace(/\\s+/g, ' ').trim()).slice(0, 25) : null; })()`); await p.screenshot({ path: path.join(EV, 'C368191-orgb-s13-wo-log.png') }); }
o.cands = ((await a.get('/api/work-orders/lead-technician-candidates')).body?.data?.technicians ?? []).map((x: any) => `${x.firstName} ${x.lastName}`);
o.staffList = (((await a.get('/api/staff?limit=200')).body?.data?.collection ?? []) as any[]).map((x) => `${x.first_name} ${x.last_name}|${x.role_label}|active=${x.is_active}|clock=${x.clockable}|deps=${(x.departments ?? []).map((d: any) => d.name ?? d).join('/')}`);
fs.writeFileSync(path.join(EV, 'C368191-orgb-s13.json'), JSON.stringify(o, null, 1)); console.log(t(), 'S13', JSON.stringify(o).slice(0, 5000)); await A.browser.close(); process.exit(0);
