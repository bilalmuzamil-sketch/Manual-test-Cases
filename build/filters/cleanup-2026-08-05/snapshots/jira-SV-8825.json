            }
           ]
          },
          {
           "type": "text",
           "text": " button; selections apply on tap (batch). See screenshot."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Desktop:",
           "marks": [
            {
             "type": "strong"
            }
           ]
          },
          {
           "type": "text",
           "text": " each filter is its own dropdown; selections apply live, no Apply button."
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "What the PRD Says",
       "marks": [
        {
         "type": "strong"
        }
       ]
      }
     ]
    },
    {
     "type": "bulletList",
     "content": [
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "S2-R6:",
           "marks": [
            {
             "type": "strong"
            }
           ]
          },
          {
           "type": "text",
           "text": " desktop filters in real time, no confirm/apply button."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "S12-R2:",
           "marks": [
            {
             "type": "strong"
            }
           ]
          },
          {
           "type": "text",
           "text": " mobile chips \"behave identically to desktop.\""
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "\"Apply Filters\" / batch-apply appears "
          },
          {
           "type": "text",
           "text": "nowhere",
           "marks": [
            {
             "type": "strong"
            }
           ]
          },
          {
           "type": "text",
           "text": " in the PRD. The batch model exists only in the engineering implementation-decisions comment and the mobile test cases (C29622 / C29623 / C29624), not the ratified spec."
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "Questions",
       "marks": [
        {
         "type": "strong"
        }
       ]
      }
     ]
    },
    {
     "type": "orderedList",
     "attrs": {
      "order": 1
     },
     "content": [
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Is the intended model: mobile combined \"All Filters\" sheet = batch Apply, individual chips = real-time, desktop = real-time (S2-R6)?"
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "If yes, Story 12 should be updated to document the \"All Filters\" sheet and Apply button \u2014 S12-R2 currently says \"identical to desktop,\" which contradicts it."
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Confirm desktop is "
          },
          {
           "type": "text",
           "text": "not",
           "marks": [
            {
             "type": "strong"
            }
           ]
          },
          {
           "type": "text",
           "text": " getting an Apply button (stays real-time)."
          }
         ]
        }
       ]
      }
     ]
    },
