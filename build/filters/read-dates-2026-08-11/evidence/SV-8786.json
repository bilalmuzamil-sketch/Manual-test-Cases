    {
     "type": "taskList",
     "content": [
      {
       "type": "taskItem",
       "content": [
        {
         "type": "text",
         "text": "Given I'm on the Work Orders page, when the page loads, then I see a filter bar with 5 chips below the tab navigation"
        }
       ],
       "attrs": {
        "localId": "b912b9cb-7f60-4471-89ad-ded28867d578",
        "state": "TODO"
       }
      },
      {
       "type": "taskItem",
       "content": [
        {
         "type": "text",
         "text": "Given the filter bar is visible, when I click the collapse toggle in the toolbar, then the bar hides and the table takes the freed space"
        }
       ],
       "attrs": {
        "localId": "ceb09091-9499-457d-8f7e-090dbaba350b",
        "state": "TODO"
       }
      },
      {
       "type": "taskItem",
       "content": [
        {
         "type": "text",
         "text": "Given the filter bar is collapsed, when I click the toggle again, then the bar reappears with any active filters intact"
        }
       ],
       "attrs": {
        "localId": "5eddcafc-5b27-4c7a-b1a3-9faf130d35af",
        "state": "TODO"
       }
      },
      {
       "type": "taskItem",
       "content": [
        {
         "type": "text",
         "text": "Given I collapse the filter bar, when I navigate away and return, then the bar remains collapsed"
        }
       ],
       "attrs": {
        "localId": "cbbf7f7a-2cc8-4c10-9d74-1f798c995367",
        "state": "TODO"
       }
      },
      {
       "type": "taskItem",
       "content": [
        {
         "type": "text",
         "text": "Given the Estimates tab hides the Status chip, the filter bar still displays the remaining four chips"
        }
       ],
       "attrs": {
        "localId": "e6459b3b-f708-47f3-87b8-184c1c58bb18",
        "state": "TODO"
       }
      }
