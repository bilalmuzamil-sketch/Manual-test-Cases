  "components": [],
  "description": {
   "type": "doc",
   "version": 1,
   "content": [
    {
     "type": "heading",
     "attrs": {
      "level": 2
     },
     "content": [
      {
       "type": "text",
       "text": "Summary"
      }
     ]
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "Users get a visible filter bar on the Work Orders page so they can immediately access filtering without hunting through menus. The bar sits in a consistent location below the tab navigation and can be collapsed to reclaim vertical space."
      }
     ]
    },
    {
     "type": "heading",
     "attrs": {
      "level": 2
     },
     "content": [
      {
       "type": "text",
       "text": "Context"
      }
     ]
    },
    {
     "type": "bulletList",
     "content": [
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "The user is on the Work Orders page and has access to it"
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "The filter bar is displayed by default on first visit"
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "The page toolbar already contains other controls (primary CTA, etc.)"
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "type": "heading",
     "attrs": {
      "level": 2
     },
     "content": [
      {
       "type": "text",
       "text": "Requirements"
      }
     ]
    },
    {
     "type": "orderedList",
     "attrs": {
      "order": 1
     },
     "content": [
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "The filter bar is displayed below the tab navigation row (All, Estimates, Completed, My Work Orders) by default \u2014 ("
          },
          {
           "type": "text",
           "text": "PRD: Story 1, S1-R1",
           "marks": [
            {
             "type": "link",
             "attrs": {
              "href": "https://shopview.atlassian.net/wiki/spaces/shopviewapp/pages/572030978/Filters#Story-1:-Filter-Bar-Layout-&-Visibility"
             }
            }
           ]
          },
          {
           "type": "text",
           "text": ")"
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "The filter bar contains five filter chips in this order: Status, Customer, Lead Technician, Service Advisor, Asset on Site \u2014 ("
          },
          {
           "type": "text",
           "text": "PRD: Story 1, S1-R2",
           "marks": [
            {
             "type": "link",
             "attrs": {
              "href": "https://shopview.atlassian.net/wiki/spaces/shopviewapp/pages/572030978/Filters#Story-1:-Filter-Bar-Layout-&-Visibility"
             }
            }
           ]
          },
          {
           "type": "text",
           "text": ")"
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "Each chip displays the filter name and a chevron icon indicating it opens a dropdown \u2014 ("
          },
          {
           "type": "text",
           "text": "PRD: Story 1, S1-R3",
           "marks": [
            {
             "type": "link",
             "attrs": {
              "href": "https://shopview.atlassian.net/wiki/spaces/shopviewapp/pages/572030978/Filters#Story-1:-Filter-Bar-Layout-&-Visibility"
             }
            }
           ]
          },
          {
           "type": "text",
           "text": ")"
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "The page toolbar contains a toggle button that collapses and expands the filter bar \u2014 ("
          },
          {
           "type": "text",
           "text": "PRD: Story 1, S1-R4",
           "marks": [
            {
             "type": "link",
             "attrs": {
              "href": "https://shopview.atlassian.net/wiki/spaces/shopviewapp/pages/572030978/Filters#Story-1:-Filter-Bar-Layout-&-Visibility"
             }
            }
           ]
          },
          {
           "type": "text",
           "text": ")"
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "When collapsed, the bar is hidden and the table expands to use the reclaimed vertical space \u2014 ("
          },
          {
           "type": "text",
           "text": "PRD: Story 1, S1-R5",
           "marks": [
            {
             "type": "link",
             "attrs": {
              "href": "https://shopview.atlassian.net/wiki/spaces/shopviewapp/pages/572030978/Filters#Story-1:-Filter-Bar-Layout-&-Visibility"
             }
            }
           ]
          },
          {
           "type": "text",
           "text": ")"
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "When expanded, the bar reappears in its previous state with any active filters still shown \u2014 ("
          },
          {
           "type": "text",
           "text": "PRD: Story 1, S1-R6",
           "marks": [
            {
             "type": "link",
             "attrs": {
              "href": "https://shopview.atlassian.net/wiki/spaces/shopviewapp/pages/572030978/Filters#Story-1:-Filter-Bar-Layout-&-Visibility"
             }
            }
           ]
          },
          {
           "type": "text",
           "text": ")"
          }
         ]
        }
       ]
      },
      {
       "type": "listItem",
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "The collapsed/expanded state persists across navigation \u2014 ("
          },
          {
           "type": "text",
           "text": "PRD: Story 1, S1-R7",
           "marks": [
            {
             "type": "link",
             "attrs": {
              "href": "https://shopview.atlassian.net/wiki/spaces/shopviewapp/pages/572030978/Filters#Story-1:-Filter-Bar-Layout-&-Visibility"
             }
            }
           ]
          },
          {
           "type": "text",
           "text": ")"
          }
