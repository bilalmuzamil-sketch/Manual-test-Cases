  "updated": "2026-08-05T14:09:37.617-0500",
  "status": {
   "self": "https://shopview.atlassian.net/rest/api/3/status/10351",
   "description": "",
   "iconUrl": "https://shopview.atlassian.net/",
   "name": "QA Complete",
   "id": "10351",
   "statusCategory": {
