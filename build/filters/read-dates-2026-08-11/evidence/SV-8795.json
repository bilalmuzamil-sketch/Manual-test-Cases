  "status": {
   "self": "https://shopview.atlassian.net/rest/api/3/status/10350",
   "description": "",
   "iconUrl": "https://shopview.atlassian.net/",
   "name": "Ready for QA",
   "id": "10350",
   "statusCategory": {
    "self": "https://shopview.atlassian.net/rest/api/3/statuscategory/4",
