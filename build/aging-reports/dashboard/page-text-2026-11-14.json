{"text": "<meta name=\"dash-one-writer\">\n<style>\n.ag { font-family: var(--font-anthropic-sans); color: var(--color-fg); display: flex; flex-direction: column; gap: var(--cds-gap-xl); }\n.ag h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; }\n.ag h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0 0 var(--cds-gap-sm); }\n.ag .lead { font-size: var(--cds-font-size-body); color: var(--color-fg); margin: var(--cds-gap-sm) 0 0; max-width: 60em; line-height: 1.5; }\n.ag .sub { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); margin: var(--cds-gap-xs) 0 0; }\n.ag .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--cds-gap-md); }\n.ag .tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); }\n.ag .tile .lab { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.ag .tile .num { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: 2.4rem; font-variant-numeric: tabular-nums; line-height: 1.1; margin-top: var(--cds-gap-xs); }\n.ag .tile .note { color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); margin-top: var(--cds-gap-xs); }\n.ag .ok { color: var(--color-ok); } .ag .bad { color: var(--color-bad); } .ag .warn { color: var(--color-warn); }\n.ag .card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); }\n.ag .chart { position: relative; min-height: 380px; }\n.ag .chart svg text { fill: var(--cds-text-secondary); font-size: var(--cds-font-size-caption); }\n.ag .legend { display: flex; gap: var(--cds-gap-md); flex-wrap: wrap; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-bottom: var(--cds-gap-sm); }\n.ag .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }\n.ag .tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); box-shadow: var(--cds-shadow-popover); border-radius: var(--cds-radius); padding: var(--cds-pad-sm); font-size: var(--cds-font-size-caption); color: var(--color-fg); white-space: nowrap; }\n.ag .finds { display: grid; gap: var(--cds-gap-md); }\n.ag .find { border-left: 3px solid var(--color-bad); padding-left: var(--cds-pad-md); }\n.ag .find.amber { border-left-color: var(--color-warn); }\n.ag .find.green { border-left-color: var(--color-ok); }\n.ag .find.grey { border-left-color: var(--cds-chart-muted); }\n.ag td a { color: inherit; }\n.ag .find b { display: block; margin-bottom: var(--cds-gap-xs); }\n.ag .find p { margin: 0; line-height: 1.5; color: var(--color-fg); }\n.ag ul.left { margin: 0; padding-left: 1.2em; line-height: 1.6; }\n.ag .tw { overflow-x: auto; }\n.ag table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-caption); }\n.ag th, .ag td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--color-border-line); vertical-align: top; }\n.ag th { color: var(--color-fg-muted); font-weight: var(--cds-font-weight-medium); }\n.ag td.n { text-align: right; font-variant-numeric: tabular-nums; }\n.ag [data-dash-source-state=refreshing] { opacity: .5; }\n</style>\n\n<div class=\"ag\">\n  <header id=\"title\">\n    <h1>A/R and A/P aging reports \u2014 test progress</h1>\n    <p class=\"lead\" data-read lang=\"en\"><b data-draw=\"done\" data-source=\"totals\" data-field=\"run\">\u2014</b> of the <b data-draw=\"total\" data-source=\"totals\" data-field=\"total\">\u2014</b> tests have been run. <b data-draw=\"passed\" data-source=\"by_status\" data-field=\"n\" data-where=\"status=Passed\">\u2014</b> passed, <b data-draw=\"failed\" data-source=\"by_status\" data-field=\"n\" data-where=\"status=Failed\">\u2014</b> failed and <b data-draw=\"blocked\" data-source=\"by_status\" data-field=\"n\" data-where=\"status=Blocked\">\u2014</b> are blocked. On 14 Nov the 22 tests added after Demo Day were run on staging: 17 pass and 5 fail on problems already reported (columns that move, long names) or awaiting your decision (the Vendor menu). The day-count problem (SV-12663) still fails its two tests; the future-date fix (SV-12545) now works.</p>\n    <p class=\"sub\">The new sorting, export and location filter on the six aging reports (A/R Aging Summary, A/R Aging Detail, A/R Aging Collection, A/P Aging Summary, A/P Aging Detail, A/P Unpaid Invoices), on QA site sv11315 (build v26.45.3-34788b2) and on staging (builds v26.45.4-b8c04e2 and, for the 22 new tests, v26.45.4-f3d3d2d). Each test is checked against the written requirements (version 13, 13 Nov 2026). Snapshot taken 14 Nov 2026, 06:58 UTC.</p>\n  </header>\n\n  <section class=\"tiles\" id=\"tiles\" aria-label=\"Headline figures\">\n    <div class=\"tile\"><div class=\"lab\">Tests in the run</div><div class=\"num\" data-draw=\"t_total\" data-source=\"totals\" data-field=\"total\">\u2014</div><div class=\"note\">all six reports</div></div>\n    <div class=\"tile\"><div class=\"lab\">Passed</div><div class=\"num ok\" data-draw=\"t_pass\" data-source=\"by_status\" data-field=\"n\" data-where=\"status=Passed\">\u2014</div><div class=\"note\">works as written</div></div>\n    <div class=\"tile\"><div class=\"lab\">Failed</div><div class=\"num bad\" data-draw=\"t_fail\" data-source=\"by_status\" data-field=\"n\" data-where=\"status=Failed\">\u2014</div><div class=\"note\">each waits on a reported fix</div></div>\n    <div class=\"tile\"><div class=\"lab\">Blocked</div><div class=\"num warn\" data-draw=\"t_block\" data-source=\"by_status\" data-field=\"n\" data-where=\"status=Blocked\">\u2014</div><div class=\"note\">none</div></div>\n    <div class=\"tile\"><div class=\"lab\">Not yet run</div><div class=\"num\" data-draw=\"t_left\" data-source=\"by_status\" data-field=\"n\" data-where=\"status=Not yet run\">\u2014</div><div class=\"note\">none left</div></div>\n    <div class=\"tile\"><div class=\"lab\">Run so far</div><div class=\"num\" data-draw=\"t_pct\" data-source=\"totals\" data-field=\"pct\">\u2014</div><div class=\"note\">of all tests</div></div>\n  </section>\n\n  <section class=\"card\" id=\"by-area\">\n    <h2>Progress by area</h2>\n    <div class=\"legend\"><span><i style=\"background:var(--color-ok)\"></i>Passed</span><span><i style=\"background:var(--color-bad)\"></i>Failed</span><span><i style=\"background:var(--color-warn)\"></i>Blocked</span><span><i style=\"background:var(--cds-chart-muted)\"></i>Not yet run</span></div>\n    <div class=\"chart\" data-draw=\"areas\" data-source=\"by_area\"></div>\n  </section>\n\n  <section class=\"card\" id=\"findings\">\n    <h2>What we found</h2>\n    <div class=\"finds\">\n      <div class=\"find\"><b>Some rows sit one aging column off from the Due Date they show</b><p>On staging, the reports count each document's days from the day in the signed-in location's time zone, but show its dates in Greenwich time. So a document dated late in the day can show, for example, a Due Date 61 days back yet sit under \"31-60 days past due\", or show Past Due 10 for a bill 11 days late. Compared with the copy saved before the release, 18 A/R documents moved one column and 1,255 A/P bills show a Past Due one day different; every amount and every other row is unchanged. Two tests fail on it: the A/R check (<a href=\"https://shopview.testrail.io/index.php?/tests/view/4563616\" target=\"_blank\" rel=\"noopener\">C715471</a>) and the A/P check (<a href=\"https://shopview.testrail.io/index.php?/tests/view/4563617\" target=\"_blank\" rel=\"noopener\">C715472</a>). Reported as <a href=\"https://shopview.atlassian.net/browse/SV-12663\" target=\"_blank\" rel=\"noopener\">SV-12663</a> (Open, filed 12 Nov); both tests run again on staging when it reaches Ready for QA.</p></div>\n      <div class=\"find\"><b>Column headings move when a group opens</b><p>On A/R Detail, A/R Collection, A/P Detail and A/P Unpaid Invoices, opening one bucket or group, or pressing Expand all, moves every column heading sideways (up to about 300 pixels); they return when it closes. The product owner asked for the columns to stay put. Four tests fail on it, already reported as <a href=\"https://shopview.atlassian.net/browse/SV-12763\" target=\"_blank\" rel=\"noopener\">SV-12763</a> (Open); they run again when it reaches Ready for QA.</p></div>\n      <div class=\"find\"><b>Long names with no spaces break two layouts</b><p>In the Customer filter menu a long name with no spaces is cut off and drawn over the next customer (<a href=\"https://shopview.atlassian.net/browse/SV-12722\" target=\"_blank\" rel=\"noopener\">SV-12722</a>, Ready to Fix); on A/R Collection such a name pushes Past Due and Amount off the screen (<a href=\"https://shopview.atlassian.net/browse/SV-12764\" target=\"_blank\" rel=\"noopener\">SV-12764</a>, Open). The Vendor filter menu does the same to a long vendor name; that report names only the Customer menu, so whether it joins it or gets its own ticket is with the QA lead. Three tests fail. Every other long-name and special-character check passes, on screen and in the PDFs.</p></div>\n      <div class=\"find green\"><b>A future as-of date now works</b><p>On staging an as-of date after today can be picked, and the PDF and CSV print it (for example \"As of Dec 31, 2026\"); the fix <a href=\"https://shopview.atlassian.net/browse/SV-12545\" target=\"_blank\" rel=\"noopener\">SV-12545</a> works and its tests pass.</p></div>\n      <div class=\"find green\"><b>Big PDFs work on staging</b><p>On staging the 2,000-line A/P Detail PDF downloads (about 70 seconds, 84 pages) and 2,001 lines is correctly refused with one message. The QA site's PDF service gives up after 30 seconds, which is why this could only be judged on staging. A 2,000-customer A/R Summary PDF also prints on the QA site, and 2,001 is refused.</p></div>\n      \n      <div class=\"find green\"><b>Everything else works as written</b><p>Sorting by any column, PDF and CSV exports, collapse and expand, the customer, vendor, past-due and location filters, the location menu's search box, document links and the switch-location prompt, the load-error messages, and the PDF size limit all pass. On staging, Inventory Value's saved link, PDF and CSV are exactly as before the release. Six reported problems have been fixed and passed their retests.</p></div>\n      <div class=\"find grey\"><b>A question for the product owner, not a bug</b><p>With no internet connection, changing a filter leaves the previous rows on screen until the connection returns; production's reports show an empty table instead. The requirements do not cover this, so it goes to the product owner as a question.</p></div>\n    </div>\n  </section>\n\n  <section class=\"card\" id=\"left\">\n    <h2>What is left, and when</h2>\n    <ul class=\"left\">\n      <li><b>On staging (2 failed):</b> the \"nothing changed\" checks for the A/R and A/P reports, run again when SV-12663 reaches Ready for QA. Inventory Value, the 2,000-line PDF and the overpaid-invoice Totals check passed on staging.</li>\n      <li><b>Columns that move (4 failed):</b> run again when SV-12763 reaches Ready for QA.</li>\n      <li><b>Long names (3 failed):</b> run again when SV-12722 and SV-12764 reach Ready for QA; the Vendor menu waits on the QA lead's decision (join SV-12722 or its own ticket).</li>\n          </ul>\n    <p class=\"sub\">Defect tickets are filed one at a time, only with the QA lead's approval and only after checking the problem is genuine.</p>\n  </section>\n\n  <section class=\"card\" id=\"failed-list\">\n    <h2>Failed tests</h2>\n    <div class=\"tw\"><table data-source=\"results\" data-row-key=\"case\">\n      <thead><tr><th data-field=\"case\">Test</th><th data-field=\"title\">What it checks</th><th data-field=\"area\">Area</th></tr></thead>\n      <tbody data-draw=\"failrows\" data-source=\"results\"></tbody>\n    </table></div>\n  </section>\n\n  <section class=\"card\" id=\"blocked-list\">\n    <h2>Blocked tests</h2>\n    <div class=\"tw\"><table data-source=\"results\" data-row-key=\"case\">\n      <thead><tr><th data-field=\"case\">Test</th><th data-field=\"title\">What it checks</th><th data-field=\"area\">Area</th></tr></thead>\n      <tbody data-draw=\"blockrows\" data-source=\"results\"></tbody>\n    </table></div>\n  </section>\n</div>\n\n<script>\ndash.calc('by_status', {\n  title: 'Tests by result',\n  description: 'How many tests in the run have each result.',\n  inputs: ['results'],\n  fn: (results) => {\n    const order = ['Passed', 'Failed', 'Blocked', 'Retest', 'Not yet run'];\n    const n = {}; for (const r of results) n[r.status] = (n[r.status] || 0) + 1;\n    return order.map((status) => ({ status, n: n[status] || 0 }));\n  }\n});\ndash.calc('totals', {\n  title: 'Totals',\n  description: 'All tests, tests run (passed, failed or blocked), and the share run.',\n  inputs: ['results'],\n  fn: (results) => {\n    const total = results.length;\n    const run = results.filter((r) => r.status !== 'Not yet run' && r.status !== 'Retest').length;\n    return [{ total, run, pct: total ? (Math.floor((run / total) * 1000) / 10) + '%' : '0%' }];\n  }\n});\ndash.calc('by_area', {\n  title: 'Tests by area and result',\n  description: 'For each area of the suite, how many tests passed, failed, are blocked or are not yet run.',\n  inputs: ['results'],\n  fn: (results) => {\n    const m = new Map();\n    for (const r of results) {\n      if (!m.has(r.area)) m.set(r.area, { area: r.area, order: +r.area_order, passed: 0, failed: 0, blocked: 0, left: 0, total: 0 });\n      const a = m.get(r.area); a.total++;\n      if (r.status === 'Passed') a.passed++; else if (r.status === 'Failed') a.failed++; else if (r.status === 'Blocked') a.blocked++; else a.left++;\n    }\n    return [...m.values()].sort((x, y) => x.order - y.order);\n  }\n});\n\nconst fmt = d3.format(',');\nconst one = (id, field, where) => {\n  const g = dash.data(id);\n  if (g.status !== 'ok' || !g.data || !g.data.length) return null;\n  const row = where ? g.data.find((r) => r.status === where) : g.data[0];\n  return row ? row[field] : null;\n};\nconst put = (name, id, field, where, f) => dash.draw(name, (el) => {\n  const v = one(id, field, where);\n  el.textContent = v == null ? '\u2014' : (f ? f(v) : v);\n  if (v != null) el.classList.remove('dash-skeleton');\n});\nput('done', 'totals', 'run', null, fmt);\nput('total', 'totals', 'total', null, fmt);\nput('passed', 'by_status', 'n', 'Passed', fmt);\nput('failed', 'by_status', 'n', 'Failed', fmt);\nput('blocked', 'by_status', 'n', 'Blocked', fmt);\nput('t_total', 'totals', 'total', null, fmt);\nput('t_pass', 'by_status', 'n', 'Passed', fmt);\nput('t_fail', 'by_status', 'n', 'Failed', fmt);\nput('t_block', 'by_status', 'n', 'Blocked', fmt);\nput('t_left', 'by_status', 'n', 'Not yet run', fmt);\nput('t_pct', 'totals', 'pct', null);\n\ndash.draw('areas', (el) => {\n  const g = dash.data('by_area');\n  el.replaceChildren();\n  if (g.status === 'error') { el.textContent = 'Failed to load'; return; }\n  if (g.status !== 'ok' || !g.data) return;\n  const rows = g.data;\n  const W = el.clientWidth || 600;\n  const narrow = W < 560;\n  const barH = 18, gap = narrow ? 30 : 10;\n  const svg = d3.select(el).append('svg').attr('width', '100%').attr('role', 'img')\n    .attr('aria-label', 'Stacked bars per area showing passed, failed, blocked and not yet run tests');\n  // measure the widest label\n  const probe = svg.append('text').attr('x', -999).attr('y', -999);\n  let labW = 0;\n  if (!narrow) for (const r of rows) { probe.text(r.area); labW = Math.max(labW, probe.node().getComputedTextLength()); }\n  probe.remove();\n  const left = narrow ? 0 : labW + 12, right = 40;\n  const rowH = barH + gap + (narrow ? 0 : 0);\n  const H = rows.length * rowH + 4;\n  svg.attr('viewBox', `0 0 ${W} ${H}`).attr('height', H);\n  const max = d3.max(rows, (r) => r.total) || 1;\n  const x = d3.scaleLinear().domain([0, max]).range([0, W - left - right]);\n  const tip = d3.select(el).append('div').attr('class', 'tip').style('opacity', 0);\n  rows.forEach((r, i) => {\n    const y = i * rowH + (narrow ? 16 : 0);\n    if (narrow) svg.append('text').attr('x', 0).attr('y', y - 4).text(r.area);\n    else svg.append('text').attr('x', left - 10).attr('y', y + barH / 2).attr('dy', '0.35em').attr('text-anchor', 'end').text(r.area);\n    let x0 = left;\n    for (const [k, c] of [['passed', 'var(--color-ok)'], ['failed', 'var(--color-bad)'], ['blocked', 'var(--color-warn)'], ['left', 'var(--cds-chart-muted)']]) {\n      const w = x(r[k]);\n      if (w > 0) svg.append('rect').attr('x', x0).attr('y', y).attr('width', w).attr('height', barH).attr('rx', 2).style('fill', c);\n      x0 += w;\n    }\n    svg.append('text').attr('x', x0 + 6).attr('y', y + barH / 2).attr('dy', '0.35em').text(r.total);\n    svg.append('rect').attr('x', 0).attr('y', y - (narrow ? 16 : 2)).attr('width', W).attr('height', rowH).style('fill', 'transparent')\n      .on('pointermove', (ev) => {\n        const [mx, my] = d3.pointer(ev, el);\n        tip.style('opacity', 1).style('left', Math.min(mx + 12, W - 200) + 'px').style('top', (my + 12) + 'px')\n          .text(`${r.area}: ${r.passed} passed, ${r.failed} failed, ${r.blocked} blocked, ${r.left} not yet run`);\n      })\n      .on('pointerleave', () => tip.style('opacity', 0));\n  });\n});\n\nconst rowsOf = (status) => (tb) => {\n  const g = dash.data('results');\n  tb.replaceChildren();\n  if (g.status !== 'ok') return;\n  for (const r of g.data.filter((r) => r.status === status)) {\n    const tr = document.createElement('tr');\n    for (const k of ['case', 'title', 'area']) {\n      const td = document.createElement('td');\n      if (k === 'case') { const a = document.createElement('a'); a.href = 'https://shopview.testrail.io/index.php?/cases/view/' + String(r.case).replace(/^C/, ''); a.target = '_blank'; a.rel = 'noopener'; a.textContent = r.case; td.appendChild(a); }\n      else td.textContent = r[k];\n      tr.appendChild(td);\n    }\n    tb.appendChild(tr);\n  }\n};\ndash.draw('failrows', rowsOf('Failed'));\ndash.draw('blockrows', rowsOf('Blocked'));\n</script>\n"}