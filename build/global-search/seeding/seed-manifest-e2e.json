{
 "_README": "THE E2E UNIVERSE — records the Playwright suite in build/global-search/e2e needs that no other manifest provides. Seeded by `npm run seed` (and automatically before every `npm test`) together with every other manifest in this directory. Same engine, same rules: find-or-create, then verify every declared field. TO ADD DATA FOR A NEW CHECK: add a record here; never edit seed.py.",
 "environment": {
  "workplace_name_hint": "Heavy Duty",
  "tag": "ZZSPEC",
  "_workplace": "The orchestrator sets SEED_WORKPLACE to the same shop the tests sign into, because parts search is scoped by shop (measured 2026-10-02)."
 },
