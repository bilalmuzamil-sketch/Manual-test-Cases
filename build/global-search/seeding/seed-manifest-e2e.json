   "_why": "a value long enough that a cut-off tail can be measured",
   "find": {
    "mode": "search",
    "list": "/api/customers",
    "coll": "collection",
    "field": "name",
    "value": "ZZSPEC Industrial Parts And Equipment Supply Company Of Greater Fernvale 123786",
    "control": "4 Star Truck Repair"
   },
   "create": {
    "endpoint": "/api/customers/create",
    "payload": {
     "name": "ZZSPEC Industrial Parts And Equipment Supply Company Of Greater Fernvale 123786",
     "city": "Fernvale",
     "state_or_province": "Ohio",
     "postal_code": "44872",
     "country_code": "US",
     "address": "21 Result Row Way",
     "phone": "(264) 400-0900"
    }
   },
   "verify": [
    "name",
    "city",
    "address",
    "phone"
   ],
   "read_as": {
    "address": "address_1",
    "phone": "telephone"
   },
   "write": {
    "endpoint": "/api/customers/change",
    "whole_record": true,
    "_why": "A SPARSE PATCH IS IGNORED — send the whole record back. create silently DROPS state_or_province and telephone, so those surface as gaps and are written here."
