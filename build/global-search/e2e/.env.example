# Copy to .env (git-ignored) or export these. NOTHING here is committed.
#
# WHICH ENVIRONMENT ------------------------------------------------------------
# The suite reads whatever this names. Everything else follows from it.
GS_APP=https://app.staging.shopview.com
# The API host is derived from GS_APP (app.x -> api.x). Set it only if that is wrong.
# GS_API=api.staging.shopview.com

# SIGNING IN -------------------------------------------------------------------
# PRODUCTION uses a username and password.
# GS_USER=someone@shopview.com
# GS_PASS=...
#
# STAGING uses Google sign-in, so there is no password to script. Take a live
# session's cookies from a signed-in browser (DevTools > Application > Cookies)
# and put them here. They expire — a Google sign-in screen means take a fresh set.
# GS_SSO=...          # sv_sso_session
# GS_PHPSESSID=...    # PHPSESSID — staging needs this one too, unlike a QA branch
# GS_CF=...           # cf_clearance, only if Cloudflare is in front

# Instead of the above you may point at a file holding SV_USER=/SV_PASS= or
# SV_SSO_SESSION=/PHPSESSID=/CF_CLEARANCE=, kept outside the repository:
# GS_ENVF=/path/to/credentials.env
# GS_STAGING_ENVF=/path/to/staging-cookies.env

# THE PERMISSION CHECKS --------------------------------------------------------
# They compare a full-access person with a lower-permission one. Without this
# second account those checks stand down and say so; everything else still runs.
# GS_LIMITED_ENVF=/path/to/lower-permission-credentials.env

# OPTIONAL ---------------------------------------------------------------------
# GS_SEED_ALLOW_PROD=1   # the seeder refuses production unless this is set
# CHROME_BIN=/path/to/chrome   # only if Playwright's own browser cannot be used
# GS_PROXY=http://127.0.0.1:8080   # only if this machine needs a proxy to reach the app
