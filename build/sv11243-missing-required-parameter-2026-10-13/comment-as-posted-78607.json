    {
     "type": "text",
     "text": " I was able to reproduce this on production."
    }
   ]
  },
  {
   "type": "paragraph",
   "content": [
    {
     "type": "text",
     "text": "What is happening:",
     "marks": [
      {
       "type": "strong"
      }
     ]
    },
    {
     "type": "text",
     "text": " on a work order, a part that was first added from the "
    },
    {
     "type": "text",
     "text": "Catalog",
     "marks": [
      {
       "type": "strong"
      }
     ]
    },
    {
     "type": "text",
     "text": " (to be ordered from a vendor) cannot be switched to the "
    },
    {
     "type": "text",
     "text": "Inventory",
     "marks": [
      {
       "type": "strong"
      }
     ]
    },
    {
     "type": "text",
     "text": " version of the same part number. Clicking "
    },
    {
     "type": "text",
     "text": "Save & Close",
     "marks": [
      {
       "type": "strong"
      }
     ]
    },
    {
     "type": "text",
     "text": " shows \"Missing required parameter. Please try to resolve this.\" and nothing is saved."
    }
   ]
