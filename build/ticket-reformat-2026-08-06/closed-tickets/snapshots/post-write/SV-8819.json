/10551?size=small","16x16":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=xsmall","32x32":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=medium"}},"customfield_10153":{"self":"https://shopview.atlassian.net/rest/api/3/customFieldOption/10566","value":"Reports & Dashboards","id":"10566","color":"GREY_DARKEST"},"customfield_10351":null,"fixVersions":[],"customfield_10352":null,"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/3","id":3,"key":"done","colorName":"green","name":"Done"},"resolution":{"self":"https://shopview.atlassian.net/rest/api/3/resolution/10000","id":"10000","description":"Work has been completed on this work item.","name":"Done"},"resolutiondate":"2026-08-04T08:31:25.712-0500","workratio":-1,"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8819/watchers","watchCount":1,"isWatching":true},"lastViewed":null,"created":"2026-08-04T00:23:25.239-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":["reports-suite"],"customfield_10016":null,"customfield_10019":"0|i01v21:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":{"self":"https://shopview.atlassian.net/rest/api/3/customFieldOption/10498","value":"High","id":"10498","color":"RED_DARKER"},"customfield_10419":null,"issuelinks":[{"id":"32045","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32045","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54666","key":"SV-8645","self":"https://shopview.atlassian.net/rest/api/3/issue/54666","fields":{"summary":"Velocity - Story 5 - Metric Calculations","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T09:08:09.071-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10005","description":"(Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/","name":"Done","id":"10005","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/3","id":3,"key":"done","colorName":"green","name":"Done"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"On the Parts Velocity report the Turns / Yr figure came out slightly too high whenever the date range was set with the This Year shortcut, because the shortcut counted one day too few. Setting the very same period by picking the dates by hand gave the right answer, so the sum itself was correct — it was the shortcut's idea of how long the period is that was wrong."}]},{"type":"paragraph","content":[{"type":"text","text":"This ticket is closed as Done. It is kept as the record of what was fixed, so anyone re-checking the fix can follow the same steps."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: QA branch sv8582 (https://sv8582.qa.shopview.com). Desktop browser, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Reports, then Parts Velocity."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Set the date range with the This Year shortcut and press Apply."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Column Selection and switch Turns / Yr on — it is hidden until you do."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Search for the part BRAKECLEAN and write down its Units Sold, On Hand and Turns / Yr."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Now set the same period by hand on the calendar — 1 January 2026 to 4 August 2026 — press Apply, and look at the same part again."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Compare the two Turns / Yr figures for that part."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The two figures are different even though the period is identical. The shortcut gave 1.40648754422 and the hand-picked dates gave 1.39997602781, and the hand-picked one is the correct one: 1 January to 4 August, counting both the first and the last day, is 216 days, and the shortcut counted 215."}]},{"type":"paragraph","content":[{"type":"text","text":"Nothing on screen shows that anything is wrong, so two people looking at the same period — one using the shortcut, one picking the dates by hand — see different numbers with no way to tell which is right. The shorter the period, the bigger the difference."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"Both the first and the last day of the chosen period are counted, so the shortcut gives exactly the same Turns / Yr figure as picking the same two dates by hand."}]},{"type":"rule"},{"type":"paragraph","content":[{"type":"text","text":"Source","marks":[{"type":"strong"}]},{"type":"text","text":" — the "},{"type":"text","text":"Parts Velocity report specification","marks":[{"type":"link","attrs":{"href":"https://shopview.atlassian.net/wiki/spaces/~712020aa00b8d6a71f4259891982a304227c20/pages/620888066/Parts+Velocity+Report"}}]},{"type":"text","text":" on Confluence, version 5, Story 5 (Metric Calculations), the definition of Window: “Window — the whole-day span of the selected range, inclusive of both the start and end dates, with a floor of 1 day (so a single-day range such as Today has Window = 1). This is the divisor used to annualize Turns / Yr.”"}]},{"type":"paragraph","content":[{"type":"text","text":"The same description, the Turns / Yr column in the same Story 5 table: “(Units Sold ÷ Window days × 365) ÷ On Hand; renders 0.00 when On Hand is 0.”"}]}]},"customfield_10252":null,"timetracking":{},"customfield_10015":null,"security":null,"attachment":[{"self":"https://shopview.atlassian.net/rest/api/3/attachment/59231","id":"59231","filename":"defect-pack-2026-08-04__probe__turns-ab-probe.json","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa