500","issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10008","id":"10008","description":"Bugs track problems or errors. (Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10303?size=medium","name":"Bug","subtask":false,"avatarId":10303,"entityId":"28af1af2-ae8b-4de4-94eb-bcecd7d4031c","hierarchyLevel":0},"timespent":null,"project":{"self":"https://shopview.atlassian.net/rest/api/3/project/10001","id":"10001","key":"SV","name":"ShopView","projectTypeKey":"software","simplified":true,"avatarUrls":{"48x48":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551","24x24":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=small","16x16":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=xsmall","32x32":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=medium"}},"customfield_10153":{"self":"https://shopview.atlassian.net/rest/api/3/customFieldOption/10125","value":"Customers","id":"10125","color":"GREY_DARKER"},"customfield_10351":null,"fixVersions":[],"customfield_10352":null,"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/3","id":3,"key":"done","colorName":"green","name":"Done"},"resolution":{"self":"https://shopview.atlassian.net/rest/api/3/resolution/10000","id":"10000","description":"Work has been completed on this work item.","name":"Done"},"resolutiondate":"2026-08-04T01:02:25.173-0500","workratio":-1,"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8822/watchers","watchCount":1,"isWatching":true},"lastViewed":"2026-08-06T03:06:36.224-0500","created":"2026-08-04T00:23:35.807-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":["api-robustness","customers","qa-found"],"customfield_10016":null,"customfield_10019":"0|i01v2p:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":{"self":"https://shopview.atlassian.net/rest/api/3/customFieldOption/10500","value":"Low","id":"10500","color":"GREEN_DARKER"},"customfield_10419":null,"issuelinks":[{"id":"32049","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32049","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54603","key":"SV-8582","self":"https://shopview.atlassian.net/rest/api/3/issue/54603","fields":{"summary":"Reporting Suite — Technician Utilization, Sales By Customer, Sales By Representative, Inventory Velocity, Inventory Value, WIP","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10006","id":"10006","description":"Epics track collections of related bugs, stories, and tasks. (Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10306?size=medium","name":"Epic","subtask":false,"avatarId":10306,"entityId":"b16adb77-4b77-44c6-9be7-926745903790","hierarchyLevel":1}}}}],"assignee":null,"updated":"2026-08-06T03:06:46.780-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10250","description":"","iconUrl":"https://shopview.atlassian.net/","name":"OBSOLETE","id":"10250","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/3","id":3,"key":"done","colorName":"green","name":"Done"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"1. Description"}]},{"type":"paragraph","content":[{"type":"text","text":"Saving a customer record crashes with a server error if the request includes a sales-representative "},{"type":"text","text":"id","marks":[{"type":"strong"}]},{"type":"text","text":". The same save works normally when it carries the representative's "},{"type":"text","text":"name","marks":[{"type":"strong"}]},{"type":"text","text":" instead — which is what the screen actually sends."}]},{"type":"paragraph","content":[{"type":"text","text":"Modestly, and we would rather say so plainly than overstate it."}]},{"type":"paragraph","content":[{"type":"text","text":"Nobody using the product can hit this.","marks":[{"type":"strong"}]},{"type":"text","text":" The Edit Customer dialog sends the name version, and that works. So there is no user-facing breakage here today."}]},{"type":"paragraph","content":[{"type":"text","text":"What it does mean is that the save is not defending itself: a request carrying an extra or unexpected field brings back a server error rather than a clear \"that field is not valid\" message. That is the kind of thing that turns into a support puzzle later, and it briefly misled our own testing into thinking customer assignments could not be created at all, when in fact they can."}]},{"type":"paragraph","content":[{"type":"text","text":"It also surfaced something worth knowing, which is not a defect but is a design fact: "},{"type":"text","text":"a customer's sales representative is stored as a first-name and last-name pair, not as a link to a staff record.","marks":[{"type":"strong"}]},{"type":"text","text":" Anything that later needs to know whether a customer's representative is still an active member of staff cannot follow a link to find out — it would have to match on the name."}]},{"type":"rule"},{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"2. Branch / Environment"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Branch / environment tested:","marks":[{"type":"strong"}]},{"type":"text","text":" QA branch "},{"type":"text","text":"sv8582","marks":[{"type":"code"}]},{"type":"text","text":" — app "},{"type":"text","text":"https://sv8582.qa.shopview.com","marks":[{"type":"code"}]},{"type":"text","text":", API "},{"type":"text","text":"https://sv8582api.qa.shopview.com","marks":[{"type":"code"}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Build marker:","marks":[{"type":"strong"}]},{"type":"text","text":" "},{"type":"text","text":"v3.4.1-0ed4433","marks":[{"type":"code"}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Organisation:","marks":[{"type":"strong"}]},{"type":"text","text":" "},{"type":"text","text":"d55bc308-e61a-438d-b5f1-c7a73c89d49f","marks":[{"type":"code"}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Customer used:","marks":[{"type":"strong"}]},{"type":"text","text":" "},{"type":"text","text":"Aaborough Works","marks":[{"type":"code"}]},{"type":"text","text":", id "},{"type":"text","text":"7af75d7c-c9f8-4209-860a-e685e9bd7c1c","marks":[{"type":"code"}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Observed:","marks":[{"type":"strong"}]},{"type":"text","text":" 2026-08-04"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Area affected:","marks":[{"type":"strong"}]},{"type":"text","text":" Customers → saving a customer record"}]}]}]},{"type":"rule"},{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"3. Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"This one is only reachable through the interface behind the screen, so there are no on-screen steps — which is exactly why its impact is low. The technical reproduction is below."}]},{"type":"rule"},{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"4. Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"An unrecognised or unsupported field should be answered with a validation error explaining what is wrong, not a server error."}]},{"type":"paragraph","content":[{"type":"text","text":"No written requirement covers this","marks":[{"type":"strong"}]},{"type":"text","text":" — stating that plainly rather than dressing it up. This is a general robustness expectation, not a quoted requirement, and if the team's view is that it does not matter, that is a reasonable answer and this can be closed."}]},{"type":"rule"},{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"5. Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The save comes back as a server error and nothing is saved."}]},{"type":"paragraph","content":[{"type":"text","text":"The same save works normally when the request carries the representative's "},{"type":"text","text":"name","marks":[{"type":"strong"}]},{"type":"text","text":" instead of an id — and the name version is what the Edit Customer screen actually sends, so "},{"type":"text","text":"nobody using the product can hit this today","marks":[{"type":"strong"}]},{"type":"text","text":". What it shows is that the save does not defend itself: an unexpected field produces a server error rather than a clear \"that field is not valid\" message."}]},{"type":"rule"},{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"6. Images"}]},{"type":"paragraph","content":[{"type":"text","text":"No screenshot is attached, because "},{"type":"text","text":"there is nothing to photograph","marks":[{"type":"strong"}]},{"type":"text","text":": this failure cannot be produced from any screen. The Edit Customer dialog sends a different (working) shape, so a picture of the dialog would show a successful save and would mislead. The exact failing request and response are in the technical section below."}]},{"type":"rule"},{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"7. Technical details for developers"}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Reproduction"}]},{"type":"codeBlock","content":[{"type":"text","text":"1. GET /api/customers/view/{id}\n   -> 200   (⚠️ the body nests under data.company, not data)\n\n2. Re-post the same body to POST /api/customers/change WITH sales_rep_id added\n   -> HTTP 500\n\n3. Re-post it WITHOUT sales_rep_id, carrying the name pair instead — the shape the\n   Edit Customer dialog actually sends:\n\nPOST /api/customers/change\n{\"name\":\"Aaborough Works\",\"telephone\":\"573-219-5819\",\"address_1\":\"6622 Donna Knoll Apt. 574\",\n \"city\":\"Michellefort\",\"state_or_province\":\"Nova Scotia\",\"postal_code\":\"A3P7S3\",\"country_code\":\"\",\n \"sales_rep_first_name\":\"Dalton\",\"sales_rep_last_name\":\"Daniel\",\"ibs\":\"\",\"require_po\":false,\n \"credit_term\":\"COD\",\"credit_limit\":0,\"shop_supplies_charge\":null,\"min_shop_supplies_charge\":null,\n \"max_shop_supplies_charge\":null,\"pin_notes\":false,\"notes\":null,\n \"id\":\"7af75d7c-c9f8-4209-860a-e685e9bd7c1c\",\n \"tax\":{\"id\":null,\"isEnabledLabor\":false,\"isEnabledParts\":false,\"isEnabledShopSupplies\":false}}\n   -> HTTP 200\n\n4. GET /api/customers/view/{id}\n   -> 200   sales_rep_first_name = \"Dalton\"\n            sales_rep_last_name  = \"Daniel\"\n            sales_rep_id         = null        <-- stored by NAME, not by id"}]},{"type":"paragraph","content":[{"type":"text","text":"⚠️ Honest limit: no request id was captured for the 500.","marks":[{"type":"strong"}]},{"type":"text","text":" The probe was not logging response ids at that moment. The reproduction above regenerates one in about a minute."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Honest correction — this is not the blocker it was first paired with"}]},{"type":"paragraph","content":[{"type":"text","text":"An earlier framing paired this with the invoice-create 500 as "},{"type":"text","text":"\"what stopped the invoiced-hours pipeline and the sales-rep deactivation prerequisites\"","marks":[{"type":"em"}]},{"type":"text","text":". On the evidence that is not right, and the record should say so: "},{"type":"text","text":"this 500 blocked one API-only shortcut","marks":[{"type":"strong"}]},{"type":"text","text":", which was then completed successfully through the shape the UI uses. "},{"type":"text","text":"The load-bearing blocker is the invoice-create server error","marks":[{"type":"strong"}]},{"type":"text","text":" (filed separately). Nothing depends on this one. It is filed on its own merits and rated Low accordingly."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"A related observation, NOT filed, flagged for your view"}]},{"type":"paragraph","content":[{"type":"text","text":"While inspecting this dialog: the customer's "},{"type":"text","text":"Sales Representative","marks":[{"type":"strong"}]},{"type":"text","text":" dropdown offers the "},{"type":"text","text":"whole staff list, including staff flagged inactive","marks":[{"type":"strong"}]},{"type":"text","text":" ("},{"type":"text","text":"Louis Mccoy","marks":[{"type":"code"}]},{"type":"text","text":", "},{"type":"text","text":"Mary Higgins","marks":[{"type":"code"}]},{"type":"text","text":" both appear), rather than the sales-rep-toggled set that "},{"type":"text","text":"GET /api/sales-reps","marks":[{"type":"code"}]},{"type":"text","text":" returns and that the "},{"type":"text","text":"work-order","marks":[{"type":"strong"}]},{"type":"text","text":" selector correctly uses. That is a genuine inconsistency between two surfaces of the same concept, and arguably more user-visible than the 500 in this ticket — but it is outside what QA was asked to raise, so it has not been filed. Say the word and it will be."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Evidence files (in the QA repo)"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"build/report-suite/viu-2026-08-03/batch-sbc-sbr/evidence/deactivation/customer-edit-dialog.md","marks":[{"type":"code"}]},{"type":"text","text":" — the full dialog inspection, the working payload, and the read-back showing "},{"type":"text","text":"sales_rep_id: null","marks":[{"type":"code"}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"build/report-suite/viu-2026-08-03/batch-sbc-sbr/ENV-DEFECTS.md","marks":[{"type":"code"}]},{"type":"text","text":" §2"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"build/report-suite/viu-2026-08-03/batch-sbc-sbr/VERDICTS.md","marks":[{"type":"code"}]},{"type":"text","text":" finding "},{"type":"text","text":"F50","marks":[{"type":"strong"}]}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Clean-up already done"}]},{"type":"paragraph","content":[{"type":"text","text":"No change was persisted to the customer: the value picked was never in the offered list, so the save carried the customer's original "},{"type":"text","text":"Dalton Daniel","marks":[{"type":"code"}]},{"type":"text","text":" straight back. Verified by re-reading the record afterwards."}]},{"type":"paragraph","content":[{"type":"text","text":" "}]},{"type":"paragraph","content":[{"type":"text","text":"Where this expected behaviour comes from: nothing written down, and the ticket said so when it was filed."}]},{"type":"paragraph","content":[{"type":"text","text":"No specification and no story under this epic says what answer the system should give when a customer is saved with a field it does not recognise. The expectation — a validation error explaining what is wrong, rather than a server error — is a general robustness expectation and not a quoted requirement."}]},{"type":"paragraph","content":[{"type":"text","text":"This ticket has already been withdrawn, for a separate reason: the fault can only be reached by sending the save request directly in a shape the product's own screens never produce, so no customer and no manual tester can see it. It is recorded here so that the record is honest about what the expectation rested on."}]}]},"customfield_10252":null,"timetracking":{},"customfield_10015":null,"security":null,"attachment":[{"self":"https://shopview.atlassian.net/rest/api/3/attachment/59244","id":"59244","filename":"viu-2026-08-03__batch-sbc-sbr__ENV-DEFECTS.md","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Fi