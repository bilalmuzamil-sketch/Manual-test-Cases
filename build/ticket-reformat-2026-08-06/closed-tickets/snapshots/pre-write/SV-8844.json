"name":"Done"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3,"localId":"8e64f91c4265"},"content":[{"type":"text","text":"Environment"}]},{"type":"paragraph","content":[{"type":"text","text":"QA branch https://sv8785.qa.shopview.com/workorders "}],"attrs":{"localId":"1a8b1fc8f3c5"}},{"type":"heading","attrs":{"level":3,"localId":"e348b6c6a122"},"content":[{"type":"text","text":"Steps to Reproduce"}]},{"type":"orderedList","attrs":{"order":1,"localId":"ca54b8761ca4"},"content":[{"type":"listItem","attrs":{"localId":"8cdfe6a18b31"},"content":[{"type":"paragraph","content":[{"type":"text","text":"Open Work Orders on desktop, All tab, with no filters and nothing typed in the page Search."}],"attrs":{"localId":"ea2dc6e2d016"}}]},{"type":"listItem","attrs":{"localId":"7453f1fd444a"},"content":[{"type":"paragraph","content":[{"type":"text","text":"Click the \"Search\" button in the page toolbar (to the left of the columns icon) and type: Lastone"}],"attrs":{"localId":"71d88dba28c5"}}]}]},{"type":"paragraph","content":[{"type":"text","text":"Observe: "},{"type":"hardBreak"},{"type":"text","text":"The Page wont filter the results with Lastone."},{"type":"hardBreak"}],"attrs":{"localId":"71d88dba28c5"}},{"type":"heading","attrs":{"level":3,"localId":"927da5243b50"},"content":[{"type":"text","text":"Expected Result"}]},{"type":"paragraph","content":[{"type":"text","text":"The page should show the data related to Lastone only."},{"type":"hardBreak"}],"attrs":{"localId":"c88a2e15fd8c"}},{"type":"heading","attrs":{"level":3,"localId":"b653a8e229ef"},"content":[{"type":"text","text":"Current Result"}]},{"type":"paragraph","content":[{"type":"text","text":"Page search is not working."}],"attrs":{"localId":"91c8e27497db"}},{"type":"heading","attrs":{"level":3,"localId":"9e1724c1b410"}},{"type":"mediaSingle","attrs":{"width":921,"widthType":"pixel","localId":"f2f957f9d0c8","layout":"align-start"},"content":[{"type":"media","attrs":{"type":"file","id":"471f854b-49ec-4317-a390-f792caa33bea","alt":"image-20260805-024810.png","collection":"","localId":"105d0556031f","height":712,"width":1494}}]},{"type":"mediaSingle","attrs":{"width":320,"widthType":"pixel","localId":"4b6f58c477c7","layout":"align-start"},"content":[{"type":"media","attrs":{"type":"file","id":"4c4ab192-5f42-4708-94cd-ef8ec3119d26","alt":"screen-capture - 2026-08-05T074453.985.webm","collection":"","localId":"fa9d6d26e0bc"}}]},{"type":"paragraph","content":[{"type":"text","text":" "}]},{"type":"paragraph","content":[{"type":"text","text":"Where this expected behaviour comes from: the Filters specification, version 18, requirement S13-R7, which says: \"The query applies as the user types, debounced at 300ms. There is no apply or submit button and Enter is not required.\""}]},{"type":"paragraph","content":[{"type":"text","text":"And requirement S13-R12, which says: \"Results replace the table contents in place. There is no separate results view or results page.\" Together those two mean that typing into the page search must narrow the list on the page itself."}]}]},"customfield_10252":null,"timetracking":{},"customfield_10015":null,"security":null,"attachment":[{"self":"https://shopview.atlassian.net/rest/api/3/attachment/59316","id":"59316","filename":"image-20260805-024810.png","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/a