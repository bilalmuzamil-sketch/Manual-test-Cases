500","issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10008","id":"10008","description":"Bugs track problems or errors. (Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10303?size=medium","name":"Bug","subtask":false,"avatarId":10303,"entityId":"28af1af2-ae8b-4de4-94eb-bcecd7d4031c","hierarchyLevel":0},"timespent":null,"project":{"self":"https://shopview.atlassian.net/rest/api/3/project/10001","id":"10001","key":"SV","name":"ShopView","projectTypeKey":"software","simplified":true,"avatarUrls":{"48x48":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551","24x24":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=small","16x16":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=xsmall","32x32":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=medium"}},"customfield_10153":{"self":"https://shopview.atlassian.net/rest/api/3/customFieldOption/10125","value":"Customers","id":"10125","color":"GREY_DARKER"},"customfield_10351":null,"fixVersions":[],"customfield_10352":null,"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/3","id":3,"key":"done","colorName":"green","name":"Done"},"resolution":{"self":"https://shopview.atlassian.net/rest/api/3/resolution/10000","id":"10000","description":"Work has been completed on this work item.","name":"Done"},"resolutiondate":"2026-08-04T01:02:25.173-0500","workratio":-1,"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8822/watchers","watchCount":1,"isWatching":true},"lastViewed":"2026-08-06T03:06:36.224-0500","created":"2026-08-04T00:23:35.807-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":["api-robustness","customers","qa-found"],"customfield_10016":null,"customfield_10019":"0|i01v2p:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":{"self":"https://shopview.atlassian.net/rest/api/3/customFieldOption/10500","value":"Low","id":"10500","color":"GREEN_DARKER"},"customfield_10419":null,"issuelinks":[{"id":"32049","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32049","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54603","key":"SV-8582","self":"https://shopview.atlassian.net/rest/api/3/issue/54603","fields":{"summary":"Reporting Suite — Technician Utilization, Sales By Customer, Sales By Representative, Inventory Velocity, Inventory Value, WIP","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10006","id":"10006","description":"Epics track collections of related bugs, stories, and tasks. (Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10306?size=medium","name":"Epic","subtask":false,"avatarId":10306,"entityId":"b16adb77-4b77-44c6-9be7-926745903790","hierarchyLevel":1}}}}],"assignee":null,"updated":"2026-08-06T09:08:16.758-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10250","description":"","iconUrl":"https://shopview.atlassian.net/","name":"OBSOLETE","id":"10250","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/3","id":3,"key":"done","colorName":"green","name":"Done"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"Saving a customer came back with a server error when the request carried a sales-representative id. The same save works normally when it carries the representative’s name instead — and the name is what the Edit Customer screen actually sends, so nobody using the product can run into this."}]},{"type":"paragraph","content":[{"type":"text","text":"This ticket was withdrawn because it can only be reached behind the screens, and it is closed as OBSOLETE. It is kept as a record of what was found."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: QA branch sv8582 (https://sv8582.qa.shopview.com). Desktop browser, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Customers and pick Aaborough Works."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Press Edit, choose a Sales Representative, and press Save. The save works normally."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"There are no steps that produce the failure. The Edit Customer screen always sends the representative’s name, and the name version saves correctly, so the failing shape cannot be produced from any screen in the product."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"Sent behind the screens with a representative id, the save comes back as a server error and nothing is saved. Sent with the representative’s name — which is what the screen sends — it saves normally."}]},{"type":"paragraph","content":[{"type":"text","text":"What it shows is that the save does not defend itself: an unexpected field produces a server error rather than a clear \"that field is not valid\" message. It also briefly misled our own testing into thinking customer assignments could not be created at all, when in fact they can."}]},{"type":"paragraph","content":[{"type":"text","text":"One thing worth knowing came out of it, and it is a design fact rather than a fault: a customer’s sales representative is stored as a first name and a last name, not as a link to a staff record. Anything that later needs to know whether that representative is still on the staff has to match on the name."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"An unrecognised or unsupported field is answered with a clear message explaining what is wrong, rather than a general server error."}]},{"type":"rule"},{"type":"paragraph","content":[{"type":"text","text":"Source — none. No written requirement covers this, and that is stated plainly: saving a customer is not a reporting feature and none of the six report descriptions mentions it. The expectation above is ordinary robustness, not a quoted requirement, and if the team’s view is that it does not matter, that is a reasonable answer — which is why the ticket is closed."}]}]},"customfield_10252":null,"timetracking":{},"customfield_10015":null,"security":null,"attachment":[{"self":"https://shopview.atlassian.net/rest/api/3/attachment/59244","id":"59244","filename":"viu-2026-08-03__batch-sbc-sbr__ENV-DEFECTS.md","