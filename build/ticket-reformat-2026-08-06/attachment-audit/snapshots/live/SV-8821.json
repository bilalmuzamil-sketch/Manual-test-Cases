s://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":[],"customfield_10016":null,"customfield_10019":"0|i01v2h:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":{"self":"https://shopview.atlassian.net/rest/api/3/customFieldOption/10498","value":"High","id":"10498","color":"RED_DARKER"},"customfield_10419":null,"issuelinks":[{"id":"32047","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32047","type":{"id":"10000","name":"Blocks","inward":"is blocked by","outward":"blocks","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10000"},"outwardIssue":{"id":"54603","key":"SV-8582","self":"https://shopview.atlassian.net/rest/api/3/issue/54603","fields":{"summary":"Reporting Suite — Technician Utilization, Sales By Customer, Sales By Representative, Inventory Velocity, Inventory Value, WIP","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10006","id":"10006","description":"Epics track collections of related bugs, stories, and tasks. (Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10306?size=medium","name":"Epic","subtask":false,"avatarId":10306,"entityId":"b16adb77-4b77-44c6-9be7-926745903790","hierarchyLevel":1}}}},{"id":"32048","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32048","type":{"id":"10000","name":"Blocks","inward":"is blocked by","outward":"blocks","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10000"},"outwardIssue":{"id":"54613","key":"SV-8592","self":"https://shopview.atlassian.net/rest/api/3/issue/54613","fields":{"summary":"[Reports Suite][A4] Denormalized invoice financial columns + backfill + clock subscriber","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10004","description":"This work item is being actively worked on at the moment by the assignee.","iconUrl":"https://shopview.atlassian.net/","name":"In Progress","id":"10004","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T09:08:13.950-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10250","description":"","iconUrl":"https://shopview.atlassian.net/","name":"OBSOLETE","id":"10250","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/3","id":3,"key":"done","colorName":"green","name":"Done"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"Creating an invoice from a completed work order works, provided the work order has a contact person on it. Where there is no contact, the product does not let you try: the Finance tab is greyed out and says why, so there is no button to press and nothing a person using the product can run into."}]},{"type":"paragraph","content":[{"type":"text","text":"This ticket is closed as OBSOLETE and is kept only as a record. It was originally raised the wrong way round — it said that pressing Create Invoice fails with a server error — and re-testing on the same branch showed that is not what happens."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: QA branch sv8582 (https://sv8582.qa.shopview.com). Desktop browser, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Go to Work Orders and press Create Work Order."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Choose Customer Aaborough Works and Asset the 2020 Ford Transit with serial 86J8FAC1VALJ43SJY, then press Save."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Add any job line to the work order and complete it."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"While the work order still has no contact person, look at the Finance tab. It is greyed out, and resting the pointer on it reads \"Please select a contact for the asset\". There is no Create Invoice button on screen."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Set a contact on that asset, open the work order again and look at the Finance tab. It is now available, Create Invoice appears, and pressing it creates the invoice and moves the work order to Invoiced."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"On screen the product behaves correctly throughout: it stops you when there is no contact, tells you what is missing, and works as soon as the contact is set."}]},{"type":"paragraph","content":[{"type":"text","text":"What is left is behind the screens only. If the invoice request is sent straight to the back end for a work order with no contact — skipping the screen that would have stopped you — the answer is a general \"something went wrong\" server error rather than a clear message saying a contact is missing. Nobody can reach that by using the product."}]},{"type":"paragraph","content":[{"type":"text","text":"The pre-set job chosen for the work order makes no difference. Eleven different pre-set jobs, covering every way they can be priced, all behaved the same. The only thing that matters is whether a contact is set."}]},{"type":"paragraph","content":[{"type":"text","text":"The two pictures below show both halves: the greyed-out Finance tab while there is no contact, and the invoice created once a contact has been set."}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"d88dc82e-4afb-4583-9e82-8111c21cbafe","collection":"","height":183,"width":900}}]},{"type":"mediaSingle","attrs":{"layout":"center"},"content":[{"type":"media","attrs":{"type":"file","id":"6792a94f-6ead-4879-86a2-d96aede516e7","collection":"","height":183,"width":900}}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"A work order with no contact person cannot be invoiced, and the product says so on screen — which is what it does."}]},{"type":"paragraph","content":[{"type":"text","text":"Behind the screens, the same request would ideally come back with a clear message saying the contact is missing, rather than a general server error."}]},{"type":"rule"},{"type":"paragraph","content":[{"type":"text","text":"Source — none. No written requirement covers this, and that is said plainly rather than dressed up: creating an invoice is not a reporting feature, and none of the six report descriptions mentions it. The expectation above is ordinary robustness, not a quoted requirement."}]},{"type":"paragraph","content":[{"type":"text","text":"This is one of the two tickets in the estate with no documented source. It is recorded as such in our own notes, and it is closed."}]}]},"customfield_10252":null,"timetracking":{},"customfield_10015":null,"security":null,"attachment":[{"self":"https://shopview.atlassian.net/rest/api/3/attachment/59259","id":"59259","filename":"sv8821-finance-tab-disabled-no-contact.png","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"created":"2026-08-04T01:42:27.049-0500","size":16288,"mimeType":"image/png","content":"https://shopview.atlassian.net/rest/api/3/attachment/content/59259","thumbnail":"https://shopview.atlas