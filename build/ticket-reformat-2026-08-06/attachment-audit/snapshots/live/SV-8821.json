l Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"subtasks":[],"customfield_10285":null,"reporter":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"customfield_10044":null,"aggregateprogress":{"progress":0,"total":0},"customfield_10046":null,"customfield_10047":null,"environment":null,"customfield_10318":null,"duedate":null,"customfield_10518":null,"progress":{"progress":0,"total":0},"votes":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8821/votes","votes":0,"hasVoted":false},"comment":{"comments":[{"self":"https://shopview.atlassian.net/rest/api/3/issue/54940/comment/74495","id":"74495","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"body":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Re-tested 2026-08-04 — you were right that it did not reproduce, and the cause was not the canned line"}]},{"type":"paragraph","content":[{"type":"text","text":"Thank you for pushing back. Re-tested on the same branch and same build ("},{"type":"text","text":"v3.4.1-0ed4433","marks":[{"type":"code"}]},{"type":"text","text":", checked at the start and again at the end — the branch has not moved, so nothing here is explained by a redeploy). The description above has been rewritten to match what actually happens. The ticket has been "},{"type":"text","text":"left closed","marks":[{"type":"strong"}]},{"type":"text","text":" — see the last point."}]},{"type":"paragraph","content":[{"type":"text","text":"What I did.","marks":[{"type":"strong"}]},{"type":"text","text":" Listed all "},{"type":"text","text":"79","marks":[{"type":"strong"}]},{"type":"text","text":" pre-set jobs (\"canned lines\") available at Staging Heavy Duty - 9919 and drove a work order end to end with "},{"type":"text","text":"11 different ones","marks":[{"type":"strong"}]},{"type":"text","text":", covering every way a pre-set job can be priced — fixed labour, fixed line total, and an hourly rate — including the $0-value one and the one with no time estimate. Every attempt is named in the table in the Steps section."}]},{"type":"paragraph","content":[{"type":"text","text":"What I found.","marks":[{"type":"strong"}]},{"type":"text","text":" The pre-set job makes "},{"type":"text","text":"no difference at all","marks":[{"type":"strong"}]},{"type":"text","text":". All eleven behaved identically. The thing that decides it is whether the work order has a "},{"type":"text","text":"contact person","marks":[{"type":"strong"}]},{"type":"text","text":" on it:"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"No contact","marks":[{"type":"strong"}]},{"type":"text","text":" — the invoice cannot be created."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Contact set","marks":[{"type":"strong"}]},{"type":"text","text":" — the invoice is created normally, on every pre-set job tried."}]}]}]},{"type":"paragraph","content":[{"type":"text","text":"I proved that by holding everything else still: same customer, same asset, same pre-set job, same steps, same money on both ($406.09). The only difference between the two work orders was the contact. The one without a contact failed; the one with a contact produced an invoice and moved to "},{"type":"text","text":"Invoiced","marks":[{"type":"strong"}]},{"type":"text","text":"."}]},{"type":"paragraph","content":[{"type":"text","text":"Why you could not reproduce it.","marks":[{"type":"strong"}]},{"type":"text","text":" Because the product stops you before you can. On a work order with no contact the "},{"type":"text","text":"Finance","marks":[{"type":"strong"}]},{"type":"text","text":" tab is greyed out and tells you exactly what to do — "},{"type":"text","text":"\"Please select a contact for the asset\"","marks":[{"type":"strong"}]},{"type":"text","text":" — and there is no "},{"type":"text","text":"Create Invoice","marks":[{"type":"strong"}]},{"type":"text","text":" button on the screen at all. Pick a contact and everything works. Whichever pre-set job you used, your work order had a contact, so invoicing worked. There is a screenshot of each state on the ticket now."}]},{"type":"paragraph","content":[{"type":"text","text":"Where my original report was wrong, plainly.","marks":[{"type":"strong"}]},{"type":"text","text":" It said the "},{"type":"text","text":"Create Invoice","marks":[{"type":"strong"}]},{"type":"text","text":" button on screen fails. It does not. I never actually pressed that button — I sent the request to the back end directly, which skipped the check the screen makes. I have corrected that in the description rather than leave it on the record."}]},{"type":"paragraph","content":[{"type":"text","text":"What is genuinely left.","marks":[{"type":"strong"}]},{"type":"text","text":" Only this: if that request is sent straight to the back end for a work order with no contact, the back end answers with a general \"something went wrong\" server error instead of a clear message saying the contact is missing. "},{"type":"text","text":"Nobody using the product can reach it","marks":[{"type":"strong"}]},{"type":"text","text":", and neither can a manual tester. It is the same pattern as two other back-end calls noted in the technical section."}]},{"type":"paragraph","content":[{"type":"text","text":"Two things for you to decide, and I have not acted on either:","marks":[{"type":"strong"}]}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"This ticket is closed (OBSOLETE / Done) and I have left it that way.","marks":[{"type":"strong"}]},{"type":"text","text":" I changed only the description and added this comment — the status, resolution, priority, parent and both \"blocks\" links are untouched and byte-verified as unchanged. My recommendation is to "},{"type":"text","text":"leave it closed","marks":[{"type":"strong"}]},{"type":"text","text":": there is no user-facing fault to fix."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"The one remaining item is "},{"type":"text","text":"back-end only","marks":[{"type":"strong"}]},{"type":"text","text":". Per your standing instruction that anything reachable only by calling the back end directly must be raised with you first, I have "},{"type":"text","text":"not","marks":[{"type":"strong"}]},{"type":"text","text":" opened anything new for it. If you would like it raised as its own small ticket — \"return a clear message instead of a server error when a work order has no contact\" — say so and I will."}]}]}]}]},"updateAuthor":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"created":"2026-08-04T01:43:38.790-0500","updated":"2026-08-04T01:43:50.450-0500","jsdPublic":true}],"self":"https://shopview.atlassian.net/rest/api/3/issue/54940/comment","maxResults":1,"total":1,"startAt":0},"worklog":{"startAt":0,"maxResults":20,"total":0,"worklogs":[]}}}