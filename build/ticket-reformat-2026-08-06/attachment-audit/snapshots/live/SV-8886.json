ersal_avatar/view/type/project/avatar/10551?size=medium"}},"customfield_10351":null,"fixVersions":[],"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"},"resolution":null,"resolutiondate":null,"workratio":-1,"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8886/watchers","watchCount":1,"isWatching":true},"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"lastViewed":"2026-08-05T13:50:49.509-0500","created":"2026-08-05T09:04:44.830-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":[],"customfield_10016":null,"customfield_10019":"0|i01vh5:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32077","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32077","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54711","key":"SV-8689","self":"https://shopview.atlassian.net/rest/api/3/issue/54711","fields":{"summary":"Scope Picker","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10350","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready for QA","id":"10350","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T08:29:52.324-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"When a manager schedules only some of the jobs on a work order, the 'Select multiple' tick-box mode is missing two of the controls it should have and a third reads differently from what was asked for. There is no 'Select all' shortcut, and no 'Cancel' to step back to the quick single-tap list — the only way out is the X, which throws the whole window away."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: ","marks":[{"type":"strong"}]},{"type":"text","text":"QA branch sv8685 — https://sv8685.qa.shopview.com/schedule. Desktop browser, signed in as an Admin, with the location Staging Heavy Duty - 9919 selected."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Schedule and choose the Week view."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"In the left-hand panel find work order S-12876, customer Pamill Paving, unit 713. It has 2 lines — 'Replace - Rear ramp handles' (estimate 1h) and 'Quality control check over' (no estimate) — and its lead technician shows as Brittany Anderson. Any work order with two or more approved lines behaves the same way."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Click the small calendar button on that work order's card, labelled 'Schedule S-12876 by click'."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Click an empty day cell on technician MQ Test Tech Qamar's row — for example Thursday 6 August. The picker opens, headed 'dropped on MQ Test Tech Qamar - Thu, Aug 6'."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Click 'Select multiple'."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Tick one line, for example 'Replace - Rear ramp handles'."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Read the bottom bar of the picker, and look for a way back to the ordinary single-tap list."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The tick boxes appear correctly, one per line."}]},{"type":"paragraph","content":[{"type":"text","text":"The bottom bar shows a tally, but it reads '1 selected - 1h' rather than the 'Create shift - 2 lines - 6h' shape the specification gives. The confirm button reads 'Schedule'."}]},{"type":"paragraph","content":[{"type":"text","text":"There is no 'Select all' button anywhere in the picker. The only 'All' control is the 'All 2' chip higher up, which is the filter between all lines and unscheduled lines — it ticks nothing."}]},{"type":"paragraph","content":[{"type":"text","text":"There is no 'Cancel' button. The only way out is the X in the top corner, which closes the whole picker instead of going back to the single-tap list, so the work order has to be placed again from the start."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"In tick-box mode the bottom bar offers a running tally, a 'Select all' shortcut that is the same as choosing the whole work order, and a 'Cancel' that returns to the quick single-tap list."}]},{"type":"rule"},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Source"}]},{"type":"paragraph","content":[{"type":"text","text":"Epic SV-8685, story SV-8689 (Scope Picker), and the Schedule specification (Confluence page 713031682), version 25."}]},{"type":"paragraph","content":[{"type":"text","text":"Section 4.3: \"'Select multiple' is an opt-in control that switches the line rows into checkboxes and shows a confirm bar with a running tally ('Create shift - 2 lines - 6h'), a 'Select all' shortcut (equivalent to whole order), and Cancel (returns to the fast single-tap list).\""}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[],"summary":"Schedule scope picker: tick-box mode has no Select all and no Cancel, and the tally text differs from the spec","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"subtasks":[],"customfield_10285":null,"reporter":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"customfield_10044":null,"aggregateprogress":{"progress":0,"total":0},"customfield_10046":null,"customfield_10047":null,"environment":null,"customfield_10318":null,"duedate":null,"customfield_10518":null,"progress":{"progress":0,"total":0},"votes":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8886/votes","votes":0,"hasVoted":false},"comment":{"comments":[],"self":"https://shopview.atlassian.net/rest/api/3/issue/55014/comment","maxResults":0,"total":0,"startAt":0},"worklog":{"startAt":0,"maxResults":20,"total":0,"worklogs":[]}}}