ian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=medium"}},"customfield_10351":null,"fixVersions":[],"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"},"resolution":null,"resolutiondate":null,"workratio":-1,"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8959/watchers","watchCount":1,"isWatching":true},"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"lastViewed":null,"created":"2026-08-06T02:13:03.978-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":[],"customfield_10016":null,"customfield_10019":"0|i01vxt:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32122","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32122","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54717","key":"SV-8695","self":"https://shopview.atlassian.net/rest/api/3/issue/54717","fields":{"summary":"Shift Detail Modal & Hover Tooltips","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10350","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready for QA","id":"10350","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T08:26:57.048-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"When you hover a shift that has a clash, the tooltip does warn you, but the warning sits at the very bottom, several rows below the customer name, and the customer name row carries no warning mark. The customer name is the first thing anyone reads, so a planner scanning quickly can miss that the shift clashes at all."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: ","marks":[{"type":"strong"}]},{"type":"text","text":"QA branch sv8685 — https://sv8685.qa.shopview.com/schedule. Desktop browser, signed in as an Admin, with the location Staging Heavy Duty - 9919 selected."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Schedule in Week view for the week of 3 August 2026."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Find a shift with an amber warning triangle on the block. The one used here was Brabay Maintenance, VIN C44ECN300699, Tuesday 4 August, 27 lines, technician Ayesha Khan — it has three clash reasons at once."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Hover over the middle of that block and wait for the tooltip. Hover the block, not the warning triangle, which has a small tooltip of its own."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Read the tooltip from the top down."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The first row is just the customer name — 'Brabay Maintenance' — with no warning mark beside it."}]},{"type":"paragraph","content":[{"type":"text","text":"The warning appears only in the last row, as 'Starts before working hours - Extends past working hours - Double-booked' with a triangle beside it. The warning text is amber, which is correct."}]},{"type":"paragraph","content":[{"type":"text","text":"The rest of the tooltip renders correctly — customer, VIN, date and time, technician, line list and progress bar — so only the position of the warning mark is wrong."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The warning mark sits next to the customer name on the first line of the tooltip. The reason line in amber at the bottom is correct and stays."}]},{"type":"rule"},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Source"}]},{"type":"paragraph","content":[{"type":"text","text":"Epic SV-8685, story SV-8695 (Shift Detail Modal & Hover Tooltips), and the Schedule specification (Confluence page 713031682), version 25."}]},{"type":"paragraph","content":[{"type":"text","text":"Section 4.13 (Hover tooltips) sets out the order of the tooltip's contents: \"Shift tooltip: customer name (plus the conflict icon if conflicted); unit, vehicle, and VIN; date and time range; technician; scope summary ('N lines - Xh'); the individual line names as a short list capped at 3 with a '+N more lines' row (no line statuses); a time-logged progress bar ('X / Yh'); and the conflict reason in amber when conflicted.\" So the reason at the bottom is right; what is missing is the icon beside the customer name on the first line."}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[],"summary":"Schedule: hover tooltip puts the conflict warning at the bottom, not beside the customer name","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"subtasks":[],"customfield_10285":null,"reporter":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar