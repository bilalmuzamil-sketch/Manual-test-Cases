500","issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10008","id":"10008","description":"Bugs track problems or errors. (Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10303?size=medium","name":"Bug","subtask":false,"avatarId":10303,"entityId":"28af1af2-ae8b-4de4-94eb-bcecd7d4031c","hierarchyLevel":0},"timespent":null,"project":{"self":"https://shopview.atlassian.net/rest/api/3/project/10001","id":"10001","key":"SV","name":"ShopView","projectTypeKey":"software","simplified":true,"avatarUrls":{"48x48":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551","24x24":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=small","16x16":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=xsmall","32x32":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=medium"}},"customfield_10153":{"self":"https://shopview.atlassian.net/rest/api/3/customFieldOption/10123","value":"Schedule","id":"10123","color":"GREY"},"customfield_10351":null,"fixVersions":[],"customfield_10352":null,"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"},"resolution":null,"resolutiondate":null,"workratio":-1,"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8848/watchers","watchCount":1,"isWatching":true},"lastViewed":"2026-08-06T09:02:27.992-0500","created":"2026-08-04T12:18:42.412-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":["FS-Schedule"],"customfield_10016":null,"customfield_10019":"0|i01v8p:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32060","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32060","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54708","key":"SV-8686","self":"https://shopview.atlassian.net/rest/api/3/issue/54708","fields":{"summary":"Schedule Grid Layout & Navigation","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10006","description":"(Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/","name":"TESTING QA","id":"10006","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}},{"id":"32087","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32087","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"inwardIssue":{"id":"55057","key":"SV-8924","self":"https://shopview.atlassian.net/rest/api/3/issue/55057","fields":{"summary":"Schedule: assigning an unassigned job to a technician moves its saved start time six hours earlier","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10007","id":"10007","description":"Subtasks track small pieces of work that are part of a larger task. (Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10854?size=medium","name":"Story Defect","subtask":true,"avatarId":10854,"entityId":"0900502c-ae66-465f-a9da-8322307b07ff","hierarchyLevel":-1}}}}],"assignee":null,"updated":"2026-08-06T08:29:27.719-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"Every time on the Schedule is shown six hours later than the time the job was scheduled for. A job put on a technician's calendar for 7:00 in the morning appears as 1:00 in the afternoon — on the block, in the hover summary, in the shift window and in the Day view. The 'now' marker is wrong by the same six hours."}]},{"type":"paragraph","content":[{"type":"text","text":"This makes the Schedule unusable as a planning board: a morning job looks like an afternoon job, and a 7:00 AM to 7:00 PM day shift reads 1:00 PM to 1:00 AM and spills onto the next day."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: ","marks":[{"type":"strong"}]},{"type":"text","text":"QA branch sv8685 — https://sv8685.qa.shopview.com/schedule. Desktop browser, signed in as an Admin, with the location Staging Heavy Duty - 9919 selected."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Schedule from the top navigation and choose the Week view."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"In the left-hand panel, type S-15855 into 'Search work orders' to find the Vuchester Retail work order, unit 10123073, line 'Service - Mobile service call made by George Donald 403-369-7067'."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Check technician Ayesha Khan's hours first, in Administration then Staff, then Edit Staff Member: Monday 7:00 AM to 9:00 PM and Tuesday to Friday 7:00 AM to 7:00 PM. So a job placed on her should start at 7:00 in the morning."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Drag that work order card onto Ayesha Khan's row, on the Tuesday column."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Hover the new block and read the time range in the pop-up summary."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Click the block and read the two time boxes in the shift window."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Switch to the Day view for that date. Read where the block sits against the hour labels, and read the time printed on the 'now' marker."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"Every time reads six hours later than it should. The 7:00 AM job reads 1:00 PM. A 9:00 AM job reads 3:00 PM. The 'now' marker read 4:11 PM while the clock at the shop read 10:11 AM."}]},{"type":"paragraph","content":[{"type":"text","text":"The date can roll over too: a 7:00 AM to 7:00 PM shift reads 1:00 PM to 1:00 AM and is drawn partly on the following day."}]},{"type":"paragraph","content":[{"type":"text","text":"For a developer: the times are stored correctly and shown wrongly. A shift saved as 16:01 UTC (10:01 in the shop's own time zone, America/Edmonton, which is six hours behind) is displayed as 4:01 PM. Forcing the browser's own time zone to America/Edmonton gives the same wrong result, so this is not the viewer's machine."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The Schedule shows the time at the shop. A job scheduled to start at 7:00 in the morning reads 7:00 AM everywhere — on the block, in the hover summary, in the shift window and in the Day view — and the 'now' marker matches the clock on the shop wall."}]},{"type":"rule"},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Source"}]},{"type":"paragraph","content":[{"type":"text","text":"Epic SV-8685, story SV-8686 (Schedule Grid Layout & Navigation), and the Schedule specification (Confluence page 713031682), version 25."}]},{"type":"paragraph","content":[{"type":"text","text":"Section 4.2: \"Every shift has a start time. It is derived from a hierarchy: The technician's configured working hours take precedence.\" The technician in the steps above has hours of 7:00 AM to 7:00 PM, so a shift placed on her must read 7:00 AM, not 1:00 PM."}]},{"type":"paragraph","content":[{"type":"text","text":"Section 4.8, on the Day view: \"Now line. A vertical indicator showing the current time, with a label on hover over the grid.\" The current time for a shop is the time on the shop's own clock."}]},{"type":"paragraph","content":[{"type":"text","text":"One honest note: the specification writes no rule about time zones anywhere, so it is silent on that point. What those two lines do settle is that a shift's start follows the technician's hours and that the marker shows the current time, and the six-hour shift breaks both."}]}]},"customfield_10252":null,"timetracking":{},"customfield_10015":null,"security":null,"attachment":[],"aggregatetimeestimate":null,"summary":"Every time on the Schedule is shown six hours later than the time it was scheduled for","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"subtasks":[],"customfield_10285":null,"reporter":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","e