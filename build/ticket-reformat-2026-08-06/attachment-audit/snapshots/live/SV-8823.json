t/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=5bd6d7573aa82432ce72b8d3","accountId":"5bd6d7573aa82432ce72b8d3","avatarUrls":{"48x48":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/5bd6d7573aa82432ce72b8d3/4b59acf7-e166-4f2e-8fb6-9ebc8137b1f3/48","24x24":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/5bd6d7573aa82432ce72b8d3/4b59acf7-e166-4f2e-8fb6-9ebc8137b1f3/24","16x16":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/5bd6d7573aa82432ce72b8d3/4b59acf7-e166-4f2e-8fb6-9ebc8137b1f3/16","32x32":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/5bd6d7573aa82432ce72b8d3/4b59acf7-e166-4f2e-8fb6-9ebc8137b1f3/32"},"displayName":"parth fadadu","active":true,"timeZone":"Asia/Calcutta","accountType":"atlassian"},"updated":"2026-08-06T08:28:14.677-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10453","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready to Fix","id":"10453","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"Two faults in the Inventory Value spreadsheet download."}]},{"type":"paragraph","content":[{"type":"text","text":"First, the money arrives as text rather than numbers, so it cannot be added up in a spreadsheet without cleaning every column by hand."}]},{"type":"paragraph","content":[{"type":"text","text":"Second, the file ignores which columns were chosen on screen and puts them in a different order."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: QA branch sv8582 (https://sv8582.qa.shopview.com). Desktop browser, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Reports, then Inventory Value."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Column Selection and switch Margin and Total Sell off. The screen correctly loses those two columns."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the three-dot menu and choose the CSV download."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the file in Excel, Numbers or Google Sheets. The two columns switched off in step 2 are still in the file — it has all twelve."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Look at the column order: Total Cost sits ninth in the file and Margin % is last. On screen Total Cost is the last column."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Select any money column in the file and try to total it. The total comes out as nothing usable, because the cells hold text such as $11,176.88 with a dollar sign and a comma."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"Every money column in the spreadsheet is written the way the screen shows it, with a dollar sign and comma separators, so spreadsheet software reads it as words. Totals come out as zero or as an error."}]},{"type":"paragraph","content":[{"type":"text","text":"The file also carries all twelve columns whatever was switched off on screen, in an order that differs from the screen."}]},{"type":"paragraph","content":[{"type":"text","text":"The PDF download of the same view is formatted correctly and is not part of this ticket."}]},{"type":"mediaSingle","attrs":{"layout":"align-start"},"content":[{"type":"media","attrs":{"type":"file","id":"64865b81-3eee-47f9-879e-3db0c3493734","alt":"inventory-value-screen-column-order.png","collection":""}}]},{"type":"paragraph","content":[{"type":"text","text":"The Inventory Value report on screen, where Total Cost is the last column. In the downloaded spreadsheet it is ninth."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The spreadsheet writes money as plain numbers with two decimals and no separators, and carries only the columns currently shown on screen, in the screen's own left-to-right order with Total Cost last."}]},{"type":"rule"},{"type":"paragraph","content":[{"type":"text","text":"Source","marks":[{"type":"strong"}]},{"type":"text","text":" — "},{"type":"text","text":"the "},{"type":"text","text":"Inventory Value report specification","marks":[{"type":"link","attrs":{"href":"https://shopview.atlassian.net/wiki/spaces/~712020aa00b8d6a71f4259891982a304227c20/pages/720142338/Inventory+Value+Report"}}]},{"type":"text","text":" on Confluence, version 4, requirement S10-R3: “Both downloads include only the columns currently shown, in the same left-to-right order as the screen, with Total Cost last.”"}]},{"type":"paragraph","content":[{"type":"text","text":"The same description, the Story 10 context note: “in the CSV, money values are written as plain numbers with two decimals and no thousands separators (so they parse cleanly in a spreadsheet); the PDF uses the same on-screen currency formatting with the \"$\" and thousands separators”"}]}]},"customfield_10252":null,"timetracking":{},"customfield_10015":null,"security":null,"attachment":[{"self":"https://shopview.atlassian.net/rest/api/3/attachment/59254","id":"59254","filename":"inventory-value-screen-column-order.png","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"created":"2026-08-04T00:49:30.413-0500","size":249321,"mimeType":"image/png","content":"https://shopview.atlassian.net/rest/api/3/attachment/content/59254","thumbnail":"https://shopv