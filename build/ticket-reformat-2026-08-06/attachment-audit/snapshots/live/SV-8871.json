2","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32072","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54908","key":"SV-8792","self":"https://shopview.atlassian.net/rest/api/3/issue/54908","fields":{"summary":"Active Filter Chip Appearance","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10006","description":"(Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/","name":"TESTING QA","id":"10006","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}},{"id":"32073","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32073","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54911","key":"SV-8795","self":"https://shopview.atlassian.net/rest/api/3/issue/54911","fields":{"summary":"Filter Persistence","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10350","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready for QA","id":"10350","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A2713e405-8836-4dee-8802-255f15740bbe","accountId":"712020:2713e405-8836-4dee-8802-255f15740bbe","avatarUrls":{"48x48":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/48","24x24":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/24","16x16":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/16","32x32":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/32"},"displayName":"Dusan Radulovic","active":true,"timeZone":"America/Bogota","accountType":"atlassian"},"updated":"2026-08-06T08:29:04.746-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10453","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready to Fix","id":"10453","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"A saved Customer, Lead Technician or Service Advisor filter comes back switched on but without its value on the button. The button reads only \"Customer\" instead of \"Customer: Iibay Landscaping\", so the list is filtered by something the screen no longer names. The Status and Asset on Site buttons keep their value correctly, so a user sees one button naming its value beside another that does not."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: ","marks":[{"type":"strong"}]},{"type":"text","text":"QA branch sv8785 — https://sv8785.qa.shopview.com/workorders. Desktop browser, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Sign in as an Admin and open Work Orders on the All tab with no filters on."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Click the Customer button and pick the customer Iibay Landscaping. The button correctly reads \"Customer: Iibay Landscaping\" and the list narrows."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Leave the page and come back. Any of these four does it: open a work order and click back; refresh the page; close the browser completely and sign in again; or open the same link in a new window."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Read the Customer button."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Repeat the whole thing with the Lead Technician button, picking Admin ShopView, and again with the Service Advisor button, picking Admin ShopView."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"For a contrast, repeat it once more with the Status button, picking Paid."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The button comes back blue, so it is clearly switched on, but it reads only \"Customer\" — the customer's name is gone."}]},{"type":"paragraph","content":[{"type":"text","text":"The filter itself is still working: the list is still narrowed to that customer, and opening the button shows the name with a tick beside it."}]},{"type":"paragraph","content":[{"type":"text","text":"The same happens on the Lead Technician and Service Advisor buttons. It does not happen on Status or Asset on Site — \"Status: Paid\" comes back correctly."}]},{"type":"paragraph","content":[{"type":"text","text":"It happens every time, on all four ways back to the page, on all three of those buttons."}]},{"type":"paragraph","content":[{"type":"text","text":"For a developer: the three affected filters are the ones whose choices are fetched from the server; the button's label is drawn before the name for the saved value has arrived and is not drawn again once it does."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The button still reads \"Customer: Iibay Landscaping\" after coming back to the page, so the user can see which customer the list is filtered by without opening the button."}]},{"type":"rule"},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Source"}]},{"type":"paragraph","content":[{"type":"text","text":"Epic SV-8785, stories SV-8792 (Active Filter Chip Appearance) and SV-8795 (Filter Persistence), and the Filters specification (Confluence page 572030978), version 19."}]},{"type":"paragraph","content":[{"type":"text","text":"Requirement S7-R1: \"When a filter has one or more values selected, the chip changes to an active/highlighted visual state (blue pill) and displays the selected value(s)\". The last five words are the part that is missing."}]},{"type":"paragraph","content":[{"type":"text","text":"Requirement S10-R1: \"When the user navigates away from the Work Orders page (e.g., to a Work Order detail, then back), the filter selections and collapsed/expanded state are restored exactly as they were left\"."}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[{"self":"https://shopview.atlassian.net/rest/api/3/attachment/59322","id":"59322","filename":"screen-capture - 2026-08-05T123205.802.webm","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"created":"2026-08-05T02:32:38.229-0500","size":1641939,"mimeType":"video/x-matroska","content":"https://shopview.atlassian.net/rest/api/3/attachment/content/59322"},{"self":"https://shopview.atlassian.net/rest/api/3/