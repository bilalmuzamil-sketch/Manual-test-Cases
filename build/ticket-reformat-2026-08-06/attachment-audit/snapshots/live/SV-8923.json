"10007","description":"Subtasks track small pieces of work that are part of a larger task. (Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10854?size=medium","name":"Story Defect","subtask":true,"avatarId":10854,"entityId":"0900502c-ae66-465f-a9da-8322307b07ff","hierarchyLevel":-1},"parent":{"id":"54722","key":"SV-8700","self":"https://shopview.atlassian.net/rest/api/3/issue/54722","fields":{"summary":"View Options, Color System & Display Customization","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10350","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready for QA","id":"10350","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}},"timespent":null,"project":{"self":"https://shopview.atlassian.net/rest/api/3/project/10001","id":"10001","key":"SV","name":"ShopView","projectTypeKey":"software","simplified":true,"avatarUrls":{"48x48":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551","24x24":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=small","16x16":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=xsmall","32x32":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=medium"}},"customfield_10351":null,"fixVersions":[],"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/3","id":3,"key":"done","colorName":"green","name":"Done"},"resolution":{"self":"https://shopview.atlassian.net/rest/api/3/resolution/10000","id":"10000","description":"Work has been completed on this work item.","name":"Done"},"resolutiondate":"2026-08-06T01:07:57.421-0500","workratio":-1,"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8923/watchers","watchCount":1,"isWatching":true},"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"lastViewed":"2026-08-05T23:00:54.917-0500","created":"2026-08-05T22:36:12.676-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":[],"customfield_10016":null,"customfield_10019":"0|i01vpt:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32085","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32085","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54722","key":"SV-8700","self":"https://shopview.atlassian.net/rest/api/3/issue/54722","fields":{"summary":"View Options, Color System & Display Customization","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10350","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready for QA","id":"10350","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T09:08:27.067-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10250","description":"","iconUrl":"https://shopview.atlassian.net/","name":"OBSOLETE","id":"10250","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/3","id":3,"key":"done","colorName":"green","name":"Done"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"Withdrawn — this was not a real fault, and it should stay closed."}]},{"type":"paragraph","content":[{"type":"text","text":"It reported that the Business Hours switch on the Schedule shaded nothing. The first check was made against a shop that had no working hours set, which is the one condition the check needed: with no working hours there is nothing to shade. We re-checked it ourselves against a shop that does have working hours set, and the switch behaves correctly."}]},{"type":"paragraph","content":[{"type":"text","text":"It is closed as OBSOLETE. It was kept rather than deleted because the reasoning is worth having on the record."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: QA branch sv8685 (https://sv8685.qa.shopview.com). Desktop browser, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Sign in as an Administrator and pick the location Staging Heavy Duty - 9919."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open that location for editing and check that \"Set business hours for this shop\" is switched on, with Monday to Friday reading 06:00 to 18:00 and no Saturday or Sunday rows. This is the condition the original report was missing."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Schedule from the top navigation, choose Day view, and go to Thursday, 6 August 2026."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the FILTER & DISPLAY dropdown and find the Business Hours switch."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Turn it on and look along the timeline from 12 AM through to 11 PM, then turn it off and look again."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"With the switch on, midnight to six in the morning and six in the evening to the end of the day are shaded grey, and the working day between six and six is left clear. Turning the switch off removes the shading, and turning it back on brings it back. That is correct behaviour."}]},{"type":"paragraph","content":[{"type":"text","text":"The original report was made on a shop with no working hours set. In that state there is no working day to draw a boundary around, so nothing is shaded — which is why the switch looked broken."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"With the switch on, the hours outside the working day are covered by a grey overlay and the working hours are left clear. Turning the switch off removes the shading."}]},{"type":"rule"},{"type":"paragraph","content":[{"type":"text","text":"Source","marks":[{"type":"strong"}]},{"type":"text","text":" — the "},{"type":"text","text":"Schedule specification","marks":[{"type":"link","attrs":{"href":"https://shopview.atlassian.net/wiki/spaces/shopviewapp/pages/713031682/Schedule"}}]},{"type":"text","text":" on Confluence, version 25, section 4.8 (Day view: timeline interactions): “Business-hours shading. An optional grey overlay outside working hours.”"}]},{"type":"paragraph","content":[{"type":"text","text":"The same description, section 9 (View options and customization), the View Options table: “Business Hours … Off … Shades non-working hours in day view.”"}]},{"type":"paragraph","content":[{"type":"text","text":"The earlier version of this ticket quoted a sentence that does not appear in the specification. The two quotations above were read from the live page and are what it actually says."}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[],"summary":"Schedule: the Business Hours switch shades nothing - out-of-hours time looks identical to the working day","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"subtasks":[],"customfield_10285":null,"reporter":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"customfield_10044":null,"aggregateprogress":{"progress":0,"total":0},"customfield_10046":null,"customfield_10047":null,"environment":null,"customfield_10318":null,"duedate":null,"customfield_10518":null,"progress":{"progress":0,"total":0},"votes":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8923/votes","votes":0,"hasVoted":false},"comment":{"comments":[{"self":"https://shopview.atlassian.net/rest/api/3/issue/55056/comment/74586","id":"74586","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"body":{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"Withdrawing this ticket - it was raised in error. ","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"This was reported by us. It says the Business Hours switch shades nothing in Day view. That is not right, and the reason is our own mistake: the test case it came from starts with a precondition that says "},{"type":"text","text":"\"The shop has working hours set\"","marks":[{"type":"em"}]},{"type":"text","text":", and when we looked at the screen the shop had no business hours set at all. The switch on the location screen was off, so there were no opening or closing times for the schedule to work from. With nothing set, there are no out-of-hours to shade, so shading nothing was the correct thing for it to do."}]},{"type":"paragraph","content":[{"type":"text","text":"Re-checked today with the shop's hours actually set, and it works correctly.","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"The shop hours were set to 06:00 to 18:00, Monday to Friday, and the same Day view was looked at again on build v3.5-7ec992f:"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"With Business Hours turned OFF, nothing is shaded at all."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"With it turned ON, two shaded bands appear - one covering midnight to 6 AM, and one covering 6 PM to midnight. The working day itself, 6 AM to 6 PM, is left clear."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Turning it off again removes the shading. This was repeated and behaved the same way each time."}]}]}]},{"type":"paragraph","content":[{"type":"text","text":"The shaded band starts at exactly the 6 PM mark on the timeline, which is the shop's closing time, so it is shading the right hours and not simply shading something."}]},{"type":"paragraph","content":[{"type":"text","text":"The test case behind this now passes, so nothing needs to be fixed. ","marks":[{"type":"strong"}]}]},{"type":"paragraph","content":[{"type":"text","text":"Closing this rather than deleting it, so the reasoning stays on the record for anyone who looks at it later."}]}]},"updateAuthor":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"created":"2026-08-06T01:07:50.874-0500","updated":"2026-08-06T01:07:50.874-0500","jsdPublic":true}],"self":"https://shopview.atlassian.net/rest/api/3/issue/55056/comment","maxResults":1,"total":1,"startAt":0},"worklog":{"startAt":0,"maxResults":20,"total":0,"worklogs":[]}}}