rsal_avatar/view/type/project/avatar/10551?size=medium"}},"customfield_10351":null,"fixVersions":[],"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"},"resolution":null,"resolutiondate":null,"workratio":-1,"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8964/watchers","watchCount":1,"isWatching":true},"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"lastViewed":null,"created":"2026-08-06T03:57:32.685-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":[],"customfield_10016":null,"customfield_10019":"0|i01vyx:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32127","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32127","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54634","key":"SV-8613","self":"https://shopview.atlassian.net/rest/api/3/issue/54634","fields":{"summary":"SBC - Story 15 - Download as PDF","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T08:37:45.430-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"Sales By Customer offers two PDF downloads. The Summary one is A4 landscape, which is right. The Expanded View one comes out on A3 landscape — a sheet half again as wide — so printing it on ordinary office paper shrinks or crops it."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: QA branch sv8582 (https://sv8582.qa.shopview.com). Desktop browser, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Reports, then Sales By Customer, with the date range 1 to 6 August 2026."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the download menu and choose Download Expanded View (PDF)."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the file and look at its page size. Then take Download Summary (PDF) from the same menu and compare. This was seen with Product Type Parts & Service and both locations selected, Staging Heavy Duty - 9919 and Staging Lethbridge - 4310."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The Expanded View file measures 1190 by 842 points, which is A3. The Summary file from the same menu, the same filters and the same moment measures 842 by 595 points, which is A4 — so this is specific to the Expanded View file."}]},{"type":"paragraph","content":[{"type":"text","text":"The file opens and every figure in it is correct, and the footer, heading block and logo are present in both."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"Both PDFs are A4 landscape."}]},{"type":"rule"},{"type":"paragraph","content":[{"type":"text","text":"Source","marks":[{"type":"strong"}]},{"type":"text","text":" — "},{"type":"text","text":"the "},{"type":"text","text":"Sales By Customer report specification","marks":[{"type":"link","attrs":{"href":"https://shopview.atlassian.net/wiki/spaces/~712020aa00b8d6a71f4259891982a304227c20/pages/577634305/SBC+Sales+By+Customer+Report"}}]},{"type":"text","text":" on Confluence, version 15, requirement S15-R7: “The PDF is A4 landscape with 25px margins on all sides, using the application's standard font.”"}]},{"type":"paragraph","content":[{"type":"text","text":"The same description treats the two files as one format with one paper size — only the file name distinguishes them — so there is no separate paper size for the Expanded View."}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[],"summary":"Sales By Customer Expanded View PDF comes out on A3 paper instead of A4","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-27