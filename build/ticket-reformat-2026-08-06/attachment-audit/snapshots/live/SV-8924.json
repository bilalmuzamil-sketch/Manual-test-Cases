small","32x32":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=medium"}},"customfield_10351":null,"fixVersions":[],"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"},"resolution":null,"resolutiondate":null,"workratio":-1,"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8924/watchers","watchCount":1,"isWatching":true},"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"lastViewed":"2026-08-05T23:00:58.454-0500","created":"2026-08-05T22:37:09.629-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":[],"customfield_10016":null,"customfield_10019":"0|i01vq1:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32086","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32086","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54710","key":"SV-8688","self":"https://shopview.atlassian.net/rest/api/3/issue/54710","fields":{"summary":"Drag-and-Drop Scheduling & Shift Creation","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10006","description":"(Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/","name":"TESTING QA","id":"10006","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}},{"id":"32087","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32087","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54975","key":"SV-8848","self":"https://shopview.atlassian.net/rest/api/3/issue/54975","fields":{"summary":"Every time on the Schedule is shown six hours later than the time it was scheduled for","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10008","id":"10008","description":"Bugs track problems or errors. (Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10303?size=medium","name":"Bug","subtask":false,"avatarId":10303,"entityId":"28af1af2-ae8b-4de4-94eb-bcecd7d4031c","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T08:29:54.256-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"Dragging a job out of the Unassigned row onto a technician moves it correctly, but silently changes its saved start time to six hours earlier. A job booked for 7:00 in the morning became 1:00 in the morning, which is outside the working hours of the technician it was given to. Nothing on screen warned about it."}]},{"type":"paragraph","content":[{"type":"text","text":"This is separate from SV-8848. There the times are stored correctly and shown wrongly; here the stored value itself is changed, so the record stays wrong even after the display is fixed."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: ","marks":[{"type":"strong"}]},{"type":"text","text":"QA branch sv8685 — https://sv8685.qa.shopview.com/schedule. Desktop browser, signed in as an Admin, with the location Staging Heavy Duty - 9919 selected."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Schedule and go to the week containing Saturday 8 August 2026."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Find a job sitting in the Unassigned row. The one used here was work order S-12876, customer Pamill Paving, unit 713, line 'Replace - Rear ramp handles', sitting unassigned on Saturday 8 August. The Unassigned row sits below every technician row, so you have to scroll down to reach it; if it is not drawn, put a job there first by dragging a work order onto it."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the job and note its start time. This one read 7:00 AM."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Check the receiving technician's hours: Kellie Ayers (Foreman) works 7:00 AM to 7:00 PM."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Drag the block up onto Kellie Ayers' row for the same day."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Confirm the 'Move this shift to Kellie Ayers on Sat, Aug 8?' window with Reassign."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the job again and read its start time."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The job does move to the chosen technician and does leave the Unassigned row, and the technician is correctly added to the work order line's technician list. That part is right."}]},{"type":"paragraph","content":[{"type":"text","text":"But the saved start time moves six hours earlier — from 7:00 in the morning to 1:00 in the morning. 1:00 AM is outside the receiving technician's own hours of 7:00 AM to 7:00 PM."}]},{"type":"paragraph","content":[{"type":"text","text":"It is not just what is drawn on screen: the time quoted above was read back from the saved record after the move. It is not the technician's hours being applied either — her start is 7:00 AM, and 7:00 is the number that ended up saved, but saved as 7:00 UTC instead of 7:00 at the shop. The same block dragged between two technician rows moves normally."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"Assigning an unassigned job to a technician moves it to that technician and leaves its start time as it was — and in any case leaves it inside that technician's own working hours."}]},{"type":"rule"},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Source"}]},{"type":"paragraph","content":[{"type":"text","text":"Epic SV-8685, story SV-8688 (Drag-and-Drop Scheduling & Shift Creation), and the Schedule specification (Confluence page 713031682), version 25."}]},{"type":"paragraph","content":[{"type":"text","text":"Section 3.2, on the unassigned row: \"Dragging a shift from this row down onto a technician assigns it.\""}]},{"type":"paragraph","content":[{"type":"text","text":"Section 4.2: \"When an unassigned shift is later dragged onto a technician row in the grid, that technician's hours apply.\""}]},{"type":"paragraph","content":[{"type":"text","text":"One honest note: the specification does not say the start time must be left exactly as it was, so the first half of the expected behaviour above is stricter than the written rule. The second half is not — 1:00 in the morning is neither the time the job had nor within the hours of the technician it was given to."}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[],"summary":"Schedule: assigning an unassigned job to a technician moves its saved start time six hours earlier","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac