rest/api/3/universal_avatar/view/type/project/avatar/10551?size=medium"}},"customfield_10351":null,"fixVersions":[],"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"},"resolution":null,"resolutiondate":null,"workratio":-1,"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8855/watchers","watchCount":1,"isWatching":true},"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"lastViewed":null,"created":"2026-08-04T12:18:56.320-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":["FS-Schedule"],"customfield_10016":null,"customfield_10019":"0|i01va9:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32067","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32067","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54713","key":"SV-8691","self":"https://shopview.atlassian.net/rest/api/3/issue/54713","fields":{"summary":"Multi-Day Spread Scheduling","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10350","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready for QA","id":"10350","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T08:29:40.940-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"The window that spreads a big job over several days has no start date field. The run of days always begins on whichever day the job was dropped on, and there is no way to change it. That removes the one way a planner had of making a second technician's run start after the first one finishes instead of alongside it."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: ","marks":[{"type":"strong"}]},{"type":"text","text":"QA branch sv8685 — https://sv8685.qa.shopview.com/schedule. Desktop browser, signed in as an Admin, with the location Staging Heavy Duty - 9919 selected."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Schedule and choose the Week view."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"In the left-hand panel, type S-14527 into 'Search work orders' to find the Qispring Rentals work order, which has 5 lines and a 40.3 hour estimate."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Drag that card onto technician Brittany Anderson's row, on the Monday column, and choose 'Schedule whole work order'."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"The spread window opens, reading 'Brittany Anderson - Whole order - 40h 19m', with a Schedule choice of 'Full estimate (40h 19m)' and a preview reading '4 shifts - 40h 19m / Aug 10 to Aug 13 - 12h/day, Mon-Thu'."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Look for a start date field anywhere in the window."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Try each of the other four choices in turn — 1 week, 2 weeks, 'Until a date...' and 'Specific hours...' — and look again each time."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"There is no start date field in the window under any of the five choices."}]},{"type":"paragraph","content":[{"type":"text","text":"'Until a date...' adds a 'Finish by' date and 'Specific hours...' adds an 'Hours per day' number, but neither lets the planner say where the run begins."}]},{"type":"paragraph","content":[{"type":"text","text":"The start is fixed by the cell the card was dropped on."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The spread window carries a start date that begins on the earliest working day and can be changed, so a planner can push a second technician's run to begin after the first one ends."}]},{"type":"rule"},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Source"}]},{"type":"paragraph","content":[{"type":"text","text":"Epic SV-8685, story SV-8691 (Multi-Day Spread Scheduling), and the Schedule specification (Confluence page 713031682), version 25."}]},{"type":"paragraph","content":[{"type":"text","text":"Section 4.5 (Multi-day spread scheduling): \"Start date. Defaults to the earliest working day. Adjusting it is how a second technician's series can be made sequential (starting after the first) rather than parallel.\" The second sentence names the exact thing that cannot be done today."}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[],"summary":"The spread window has no start date, so a second technician's run of days cannot be made to follow the first","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"subtasks":[],"customfield_10285":null,"reporter":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","