ar/view/type/project/avatar/10551?size=medium"}},"customfield_10351":null,"fixVersions":[],"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"},"resolution":null,"resolutiondate":null,"workratio":-1,"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8969/watchers","watchCount":1,"isWatching":true},"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"lastViewed":null,"created":"2026-08-06T04:20:43.378-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":[],"customfield_10016":null,"customfield_10019":"0|i01w01:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32133","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32133","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54684","key":"SV-8663","self":"https://shopview.atlassian.net/rest/api/3/issue/54684","fields":{"summary":"WIP - Story 7 - Filters","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T08:40:03.343-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"Two things about the three Work In Progress filters are wrong."}]},{"type":"paragraph","content":[{"type":"text","text":"Each filter offers its Clear action all the time, even before anything is picked, and it is labelled \"Clear all\" where a single \"Clear\" is asked for."}]},{"type":"paragraph","content":[{"type":"text","text":"And the Customer and Asset filters each have an \"All customers\" or \"All assets\" item at the top of their list, while the Advisor filter has no \"All advisors\" item at all."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: QA branch sv8582 (https://sv8582.qa.shopview.com). Desktop browser, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Reports, then Work In Progress, with the date range This Week and both locations, Staging Heavy Duty - 9919 and Staging Lethbridge - 4310 selected, without touching any filter."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the Customer filter. The list reads \"All customers\", \"Clear all\", then the customers — and nothing is selected yet. The Asset filter behaves the same way."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the Advisor filter. The list reads \"Clear all\", then Admin ShopView, with no \"All advisors\" item."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"All three filters show their Clear action before anything is selected, labelled \"Clear all\". The Advisor filter has no \"All advisors\" item, though its closed control does read \"All advisors\", so the state exists and it is the item that is missing."}]},{"type":"paragraph","content":[{"type":"text","text":"Everything works: each filter lists the values found across the whole scope, the closed controls read \"All advisors\", \"All customers\" and \"All assets\", and Clear all does return a filter to its all state."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The Clear action appears only once at least one thing is selected, as a single \"Clear\", and the Advisor filter offers an \"All advisors\" item like the other two."}]},{"type":"rule"},{"type":"paragraph","content":[{"type":"text","text":"Source","marks":[{"type":"strong"}]},{"type":"text","text":" — "},{"type":"text","text":"the "},{"type":"text","text":"Work In Progress report specification","marks":[{"type":"link","attrs":{"href":"https://shopview.atlassian.net/wiki/spaces/~712020aa00b8d6a71f4259891982a304227c20/pages/703660034/WIP+Work+In+Progress+Report"}}]},{"type":"text","text":" on Confluence, version 9, requirement S7-R3: “When no customer is selected, the Customer filter reads \"All customers\" and every job is shown; the filter offers a single \"Clear\" action that returns it to \"All customers\", shown only once at least one customer is selected.”"}]},{"type":"paragraph","content":[{"type":"text","text":"The same description, requirement S7-R5: “When no asset is selected, the Asset filter reads \"All assets\" and every job is shown; the filter offers a single \"Clear\" action that returns it to \"All assets\", shown only once at least one asset is selected.”"}]},{"type":"paragraph","content":[{"type":"text","text":"The Advisor half rests on requirement S7-R1 of the same description, which describes the Advisor filter as the same kind of multi-select as the other two but does not spell out an \"All advisors\" item of its own. That makes it the weaker of the two claims, and it is stated here as such."}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[],"summary":"Work In Progress filters show a Clear action before anything is selected, and the Advisor filter has no All advisors item","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayNam