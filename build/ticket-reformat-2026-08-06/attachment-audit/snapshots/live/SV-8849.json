w.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}},{"id":"32071","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32071","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54992","key":"SV-8865","self":"https://shopview.atlassian.net/rest/api/3/issue/54992","fields":{"summary":"Recurring (series) shift can't be opened or deleted in Month view","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10350","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready for QA","id":"10350","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10007","id":"10007","description":"Subtasks track small pieces of work that are part of a larger task. (Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10854?size=medium","name":"Story Defect","subtask":true,"avatarId":10854,"entityId":"0900502c-ae66-465f-a9da-8322307b07ff","hierarchyLevel":-1}}}}],"assignee":null,"updated":"2026-08-06T08:29:29.667-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10350","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready for QA","id":"10350","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"A job spread over several days cannot be opened from the Week view. Clicking the labelled block, or any of the small 'continues' markers on the following days, does nothing at all — no window, no menu. So from the Week view a planner cannot see the job's detail, recolour it, add a note or delete it. The same shift opens normally from the Day and Month views."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: ","marks":[{"type":"strong"}]},{"type":"text","text":"QA branch sv8685 — https://sv8685.qa.shopview.com/schedule. Desktop browser, signed in as an Admin, with the location Staging Heavy Duty - 9919 selected."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Schedule and choose the Week view."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"In the left-hand panel, type S-14527 into 'Search work orders' to find the Qispring Rentals work order, which has 5 lines and a 40.3 hour estimate."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Drag that card onto technician Brittany Anderson's row, on the Monday column."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Choose 'Schedule whole work order', then 'Create 4 shifts'. That gives a job spread across Monday to Thursday."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Back on the Week view, click the labelled Monday block, which reads 'Qispring Rentals / 5 Lines / Part of a series'."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Click each of the small 'continues' markers on Tuesday, Wednesday and Thursday."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Switch to the Day view for that Monday and click the same block, then to the Month view and click it there."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"In the Week view neither the labelled block nor any 'continues' marker responds to a click. No window opens. Right-clicking and double-clicking do nothing either."}]},{"type":"paragraph","content":[{"type":"text","text":"The very same shift opens normally from the Day view and from the Month view, where the window correctly shows 'Part of a series - Shift 1 of 4'."}]},{"type":"paragraph","content":[{"type":"text","text":"For a developer: every block in the week was clicked in turn. The four series blocks opened nothing, while the four ordinary shifts and the event in the same week all opened their detail window normally."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"Clicking any part of a spread job in the Week view opens the shift window, exactly as clicking a single-day shift does, so the planner can read the detail, recolour it, add a note or delete it."}]},{"type":"rule"},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Source"}]},{"type":"paragraph","content":[{"type":"text","text":"Epic SV-8685, story SV-8692 (Linked Series & Banners), and the Schedule specification (Confluence page 713031682), version 25."}]},{"type":"paragraph","content":[{"type":"text","text":"Section 4.9: \"Clicking a shift block opens a detail panel showing:\" and then the list of what the panel holds, including the scope summary, the notes and the Delete action."}]},{"type":"paragraph","content":[{"type":"text","text":"The specification draws no distinction between a single-day shift and one that belongs to a series, and none between the Day, Week and Month views."}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[],"summary":"A shift that is part of a multi-day series cannot be opened from the Week view","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"subtasks":[],"customfield_10285":null,"reporter":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars