:[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32069","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32069","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54709","key":"SV-8687","self":"https://shopview.atlassian.net/rest/api/3/issue/54709","fields":{"summary":"Work Order Sidebar & Mini Calendar","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10006","description":"(Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/","name":"TESTING QA","id":"10006","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T08:29:50.473-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10006","description":"(Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/","name":"TESTING QA","id":"10006","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"The work order filters on the left of the Schedule can be switched on one at a time but not switched off in one go — there is no 'Clear all'. There is also nothing on the Filters button to show that filters are on or how many, so a planner can be looking at a filtered list without realising it and then has to hunt through three groups of tick boxes to undo it."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: ","marks":[{"type":"strong"}]},{"type":"text","text":"QA branch sv8685 — https://sv8685.qa.shopview.com/schedule. Desktop browser, signed in as an Admin, with the location Staging Heavy Duty - 9919 selected."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Schedule."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Click 'Filters' in the left-hand panel."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Tick 'Unassigned' under Assignment and 'Approved' under Status."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Close the pop-up and note that the work order list is now narrowed."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Look at the Filters button for any badge or count showing that filters are on."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the pop-up again and look for a 'Clear all' control."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"There is no count or badge on the Filters button, so nothing on the closed button says a filter is on."}]},{"type":"paragraph","content":[{"type":"text","text":"There is no 'Clear all' anywhere in the pop-up. Every tick box has to be unticked one at a time."}]},{"type":"paragraph","content":[{"type":"text","text":"For a developer: the pop-up holds the heading 'FILTERS' and then the Assignment, Status and Priority tick boxes with their counts, and nothing else."}]},{"type":"paragraph","content":[{"type":"text","text":"Two screen recordings made by Ayesha Khan are attached to this ticket — 'Reproduced on QA - 8857.mp4' shows the fault and 'Verified in QA.mp4' was recorded during her QA check."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The Filters button carries a small count of how many filters are on, and the pop-up has a 'Clear all' that resets every filter in one click."}]},{"type":"rule"},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Source"}]},{"type":"paragraph","content":[{"type":"text","text":"Epic SV-8685, story SV-8687 (Work Order Sidebar & Mini Calendar), and the Schedule specification (Confluence page 713031682), version 25."}]},{"type":"paragraph","content":[{"type":"text","text":"Section 5.1 (Work order filters): \"Filters live behind a 'Filter' button (with an active-count badge); there are no assignment tabs. Applying a filter narrows the flat card list, and 'Clear all' resets in one click.\" Both missing things — the count on the button and the one-click reset — are in that one sentence."}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[{"self":"https://shopview.atlassian.net/rest/api/3/attachment/59392","id":"59392","filename":"Reproduced on QA - 8857.mp4","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A67f76d27-9119-4cb6-93c6-dbf94204abba","accountId":"712020:67f76d27-9119-4cb6-93c6-dbf94204abba","avatarUrls":{"48x48":"https://avata