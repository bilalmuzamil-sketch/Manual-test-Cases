Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T08:29:33.618-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10350","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready for QA","id":"10350","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"The View Options menu offers a 'Tech Hours' switch, which is supposed to show each technician's working hours next to their name. Switching it on and off makes no difference anywhere on the page — not even for the technician in this shop who does have custom hours saved."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: ","marks":[{"type":"strong"}]},{"type":"text","text":"QA branch sv8685 — https://sv8685.qa.shopview.com/schedule. Desktop browser, signed in as an Admin, with the location Staging Heavy Duty - 9919 selected."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Check the test data first: in Administration then Staff, open Edit Staff Member for technician Ayesha Khan. Her custom hours are Monday 7:00 AM to 9:00 PM, Tuesday to Friday 7:00 AM to 7:00 PM, and Saturday and Sunday set to Not working."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Schedule and choose the Week view."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Click View Options in the toolbar — the sliders icon on the right."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Note that 'Tech Hours' starts switched off, and switch it on."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Close the menu and read the technician names down the left-hand side, including Ayesha Khan's row."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Switch 'Tech Hours' back off and compare the two screens."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"Nothing changes. Each row shows only the initials, the name and the job title, both before and after."}]},{"type":"paragraph","content":[{"type":"text","text":"Ayesha Khan's row reads exactly 'AK Ayesha Khan' with the switch off, with it on, and after switching it off again."}]},{"type":"paragraph","content":[{"type":"text","text":"For a developer: the switch itself works and its setting is stored — it is simply not used to draw anything."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"With Tech Hours on, each technician's working hours appear beside their name — for example '7:00 AM - 7:00 PM' next to Ayesha Khan — and disappear again when it is switched off."}]},{"type":"rule"},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Source"}]},{"type":"paragraph","content":[{"type":"text","text":"Epic SV-8685, story SV-8700 (View Options, Color System & Display Customization), and the Schedule specification (Confluence page 713031682), version 25."}]},{"type":"paragraph","content":[{"type":"text","text":"Section 9, the View Options table, gives Tech Hours a default of Off and this effect: \"Displays each technician's working hours next to their name.\""}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[],"summary":"Turning on the Tech Hours option in View Options changes nothing on the screen","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"subtasks":[],"customfield_10285":null,"reporter":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2