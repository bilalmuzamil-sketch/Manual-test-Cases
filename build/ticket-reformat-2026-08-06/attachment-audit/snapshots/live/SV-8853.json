shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=medium"}},"customfield_10351":null,"fixVersions":[],"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"},"resolution":null,"resolutiondate":null,"workratio":-1,"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8853/watchers","watchCount":1,"isWatching":true},"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"lastViewed":null,"created":"2026-08-04T12:18:52.582-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":["FS-Schedule"],"customfield_10016":null,"customfield_10019":"0|i01v9t:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32065","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32065","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54708","key":"SV-8686","self":"https://shopview.atlassian.net/rest/api/3/issue/54708","fields":{"summary":"Schedule Grid Layout & Navigation","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10006","description":"(Migrated on 31 Dec 2023 09:01 UTC)","iconUrl":"https://shopview.atlassian.net/","name":"TESTING QA","id":"10006","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T08:29:37.219-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"Two of the Schedule's confirmation windows ignore the keyboard. The 'Delete from this series?' window and the 'Reassign shift' window cannot be closed with Escape and cannot be confirmed with Enter, so they can only be used with a mouse. Every other pop-up on the page closes with Escape."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: ","marks":[{"type":"strong"}]},{"type":"text","text":"QA branch sv8685 — https://sv8685.qa.shopview.com/schedule. Desktop browser, signed in as an Admin, with the location Staging Heavy Duty - 9919 selected."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Schedule and choose the Week view. Type S-14527 into 'Search work orders' to find the Qispring Rentals work order (5 lines, 40.3 hours), drag it onto technician Brittany Anderson's Monday column, and choose 'Schedule whole work order' then 'Create 4 shifts'. That gives a job spread over four days."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Switch to the Day view for the Tuesday, click the middle shift of that series to open the shift window, then click the delete bin."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"The 'Delete from this series?' window opens. Press Escape. Press it again. Click inside the window first and press Escape once more."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Close the window with Cancel and go back to the Week view."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Drag any shift block from one technician's row onto another technician's row."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"The 'Reassign shift' window opens, asking 'Move this shift to <name> on <date>?'. Press Enter, then press Escape."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"For a contrast, open the shift window on any ordinary shift and press Escape, then open the View Options menu and press Escape."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"Neither key does anything in either window. Escape does not close them, whether or not the focus is inside the window, and only Cancel or the close X will shut them."}]},{"type":"paragraph","content":[{"type":"text","text":"Enter on the 'Reassign shift' window does not confirm the move — nothing is sent and no undo message appears."}]},{"type":"paragraph","content":[{"type":"text","text":"Escape does work on the shift window itself and on both toolbar menus, so it is specifically these two confirmation windows that ignore it."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"Escape closes whichever pop-up is on top, and Enter confirms the window that is asking for confirmation, so both windows can be used entirely from the keyboard."}]},{"type":"rule"},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Source"}]},{"type":"paragraph","content":[{"type":"text","text":"Epic SV-8685, story SV-8700 (View Options, Color System & Display Customization), and the Schedule specification (Confluence page 713031682), version 25."}]},{"type":"paragraph","content":[{"type":"text","text":"Section 7, under \"Keyboard support. Global shortcuts work anywhere on the schedule page\", writes both keys down separately."}]},{"type":"paragraph","content":[{"type":"text","text":"On Escape: \"Escape closes the topmost open modal or popover, following a defined stacking order (delete scope, reassign, spread, capacity, event modal, event view, line picker, shift detail, cell menu, calendar picker, customize, filters, search).\""}]},{"type":"paragraph","content":[{"type":"text","text":"On Enter: \"Enter confirms the active confirmable dialog (delete scope, reassign, spread, event create/edit). It does not fire inside textareas, so multiline note editing still works normally.\" The delete-scope and reassign windows are the first two named in both lists."}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[],"summary":"The Escape and Enter keys do not work on the delete and reassign confirmation windows","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"subtasks":[],"customfield_10285":null,"reporter":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"customfield_10044":null,"aggregateprogress":{"progress":0,"total":0},"customfield_10046":null,"customfield_10047":null,"environment":null,"customfield_10318":null,"duedate":null,"customfield_10518":null,"progress":{"p