layName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"}],"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":[],"customfield_10016":null,"customfield_10019":"0|i01v8h:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32059","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32059","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54909","key":"SV-8793","self":"https://shopview.atlassian.net/rest/api/3/issue/54909","fields":{"summary":"Clearing Filters & Empty State","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10350","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready for QA","id":"10350","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T09:08:24.193-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10250","description":"","iconUrl":"https://shopview.atlassian.net/","name":"OBSOLETE","id":"10250","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/3","id":3,"key":"done","colorName":"green","name":"Done"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"When only a page search is active and nothing matches it, the empty screen says no work orders match your filters and offers a Clear Filters link. No filter is on, so that link does nothing useful and there is no way to clear the search from the empty screen."}]},{"type":"paragraph","content":[{"type":"text","text":"This ticket is closed as OBSOLETE and is kept as a record."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: QA branch sv8785 (https://sv8785.qa.shopview.com/workorders). Desktop browser, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Work Orders on a desktop browser, All tab, and use Clear Filters first so that no filter is on."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Click the Search button in the page toolbar and type text that matches nothing, for example: ZZQQNOMATCHXX"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Read the message in the empty table area and look at the link underneath it."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The message reads \"No work orders match your filters\" even though no filter is on, and the only link offered is Clear Filters. Clicking it changes nothing, because there are no filters to clear: the search text stays and the screen stays empty. Nothing on the empty screen clears the search."}]},{"type":"paragraph","content":[{"type":"text","text":"A later live check found this still happening. One part of the original report does now behave correctly: clearing filters no longer clears the search text."}]},{"type":"paragraph","content":[{"type":"text","text":"A screen recording taken at the time is attached. The ticket is closed and has not been reopened — that is the QA lead’s decision, not ours."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The empty screen tells the user that nothing matched their search and offers a way to clear the search. Where both a search and filters are on, it offers each of them separately, so clearing one does not clear the other."}]},{"type":"rule"},{"type":"paragraph","content":[{"type":"text","text":"Source","marks":[{"type":"strong"}]},{"type":"text","text":" — the "},{"type":"text","text":"Filters specification","marks":[{"type":"link","attrs":{"href":"https://shopview.atlassian.net/wiki/spaces/shopviewapp/pages/572030978/Filters"}}]},{"type":"text","text":" on Confluence, version 19, requirement S8-R3: “When the combination of active filters and any active search query produces no matching records, the table shows an empty state with a message indicating no results were found for the current filters and search”"}]},{"type":"paragraph","content":[{"type":"text","text":"The same description, requirement S8-R4: “The empty state includes a prompt or link to clear filters and, where a search query is active, to clear the query”"}]},{"type":"paragraph","content":[{"type":"text","text":"The same description, requirement S8-R5: “Where both a query and filters are active, each is cleared independently from the empty state. Clearing filters does not clear the query and clearing the query does not clear the filters, consistent with S13-R13”"}]}]},"customfield_10252":null,"timetracking":{},"customfield_10015":null,"security":null,"attachment":[{"self":"https://shopview.atlassian.net/rest/api/3/attachment/59324","id":"59324","filename":"screen-capture - 2026-08-05T123655.032.webm","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"created":"2026-08-05T02:37:15.826-0500","size":1526166,"mimeType":"video/x-matroska","content":"https://shopview.atlassian.net/rest/api/3/attachment/content/59324"}],"aggregatetimeestimate":null,"summary":"When only a page search is active the empty screen offers Clear Filters, which does not help","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Fi