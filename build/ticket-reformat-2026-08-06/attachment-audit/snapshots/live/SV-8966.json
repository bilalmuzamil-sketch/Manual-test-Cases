ian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=medium"}},"customfield_10351":null,"fixVersions":[],"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"},"resolution":null,"resolutiondate":null,"workratio":-1,"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8966/watchers","watchCount":1,"isWatching":true},"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"lastViewed":null,"created":"2026-08-06T03:57:36.979-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":[],"customfield_10016":null,"customfield_10019":"0|i01vzd:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32129","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32129","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54625","key":"SV-8604","self":"https://shopview.atlassian.net/rest/api/3/issue/54625","fields":{"summary":"SBC - Story 6 - Remember filters and view between visits","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T08:37:48.635-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"Sales By Customer remembers the filters a user left behind. When a remembered choice is no longer a real choice it should be dropped and the filter should fall back to its normal default. Two of the four do not."}]},{"type":"paragraph","content":[{"type":"text","text":"A remembered location that no longer exists is kept, and a remembered customer that no longer exists is kept, each showing \"1 selected\" for something the user cannot see or name. A remembered date range that is no longer offered is also kept, and the report opens completely empty."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: QA branch sv8582 (https://sv8582.qa.shopview.com). Desktop browser, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Reports, then Sales By Customer, so the remembered view is created. It is held in the browser under the name report_view:sales-by-customer."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Change that remembered view so it holds a location identifier and a customer identifier that do not exist, and a date range value that is not one of the offered ranges."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Reload the report and read the date control, the table, and the Location and Customer filters. This was seen with Product Type Parts & Service and both locations selected, Staging Heavy Duty - 9919 and Staging Lethbridge - 4310."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The date control reads \"Select Date Range\" and the table is empty. Location and Customer each read \"1 selected\". Product Type has gone back to Parts & Service and every column is showing again, so those two fall back correctly."}]},{"type":"paragraph","content":[{"type":"text","text":"Nothing is lost and the user can put the filters right by hand. The date-range one is the least pleasant, because the report looks broken rather than filtered."}]},{"type":"paragraph","content":[{"type":"text","text":"Remembering itself works and was checked first: date range, Product Type, locations, sort and the chosen columns are all restored exactly, and each report keeps its own separate remembered view."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"Anything remembered that is no longer valid is dropped, and that filter falls back to its default — This Month for the date range, All locations, and all customers."}]},{"type":"rule"},{"type":"paragraph","content":[{"type":"text","text":"Source","marks":[{"type":"strong"}]},{"type":"text","text":" — "},{"type":"text","text":"the "},{"type":"text","text":"Sales By Customer report specification","marks":[{"type":"link","attrs":{"href":"https://shopview.atlassian.net/wiki/spaces/~712020aa00b8d6a71f4259891982a304227c20/pages/577634305/SBC+Sales+By+Customer+Report"}}]},{"type":"text","text":" on Confluence, version 15, requirement S6-R5: “On restore, any saved value that is no longer valid is discarded, and that setting uses its default instead.”"}]},{"type":"paragraph","content":[{"type":"text","text":"The same description, requirement S6-R6: “A saved value is treated as no longer valid when it is an unknown date range, a location the user no longer has access to, a sort column that no longer exists, or a column set that does not match the current columns.”"}]},{"type":"paragraph","content":[{"type":"text","text":"S6-R6 names the date range and the location, so those two are squarely covered. The customer half rests on requirement S18-R9 of the same description, which says that when the results reload \"the still-present selected ids are kept, ids no longer present are dropped, and newly-present customers are not added\". Read live today, S18-R9 speaks about a reload rather than about restoring a remembered view, so the customer half is the weaker of the two claims and is stated here as such."}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[],"summary":"Sales By Customer remembered view keeps a location and a customer the user can no longer use, and loses the date range entirely","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"subtasks":[],"customfield_10285":null,"reporter":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"customfield_10044":null,"aggregateprogress":{"progress":0,"total":0},"customfield_10046":null,"customfield_10047":null,"environment":null,"customfield_10318":null,"duedate":null,"customfield_10518":null,"progress":{"progress":0,"total":0},"votes":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8966/votes","votes":0,"hasVoted":false},"comment":