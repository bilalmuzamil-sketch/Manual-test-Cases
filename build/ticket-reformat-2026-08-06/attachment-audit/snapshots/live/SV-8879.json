/10551?size=small","16x16":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=xsmall","32x32":"https://shopview.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10551?size=medium"}},"customfield_10153":{"self":"https://shopview.atlassian.net/rest/api/3/customFieldOption/10566","value":"Reports & Dashboards","id":"10566","color":"GREY_DARKEST"},"customfield_10351":null,"fixVersions":[],"customfield_10352":null,"aggregatetimespent":null,"statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"},"resolution":null,"resolutiondate":null,"workratio":-1,"issuerestriction":{"issuerestrictions":{},"shouldDisplay":true},"watches":{"self":"https://shopview.atlassian.net/rest/api/3/issue/SV-8879/watchers","watchCount":1,"isWatching":true},"lastViewed":"2026-08-06T08:20:05.654-0500","created":"2026-08-05T07:04:42.682-0500","customfield_10021":null,"customfield_10385":null,"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/4","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/low_new.svg","name":"Low","id":"4"},"labels":["reports-suite"],"customfield_10016":null,"customfield_10019":"0|i01vfl:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":{"self":"https://shopview.atlassian.net/rest/api/3/customFieldOption/10500","value":"Low","id":"10500","color":"GREEN_DARKER"},"customfield_10419":null,"issuelinks":[{"id":"32074","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32074","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54624","key":"SV-8603","self":"https://shopview.atlassian.net/rest/api/3/issue/54624","fields":{"summary":"SBC - Story 4 - Filter by location","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T08:28:40.175-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"Each of the six reports has a Location chooser in its toolbar. A user who has access to only one location has nothing to choose there, and the chooser should not be shown to them. It is shown, on all six reports."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: QA branch sv8582 (https://sv8582.qa.shopview.com). Desktop browser. Steps 1 to 3 are done signed in as an Admin; steps 4 onwards need a sign-in as the single-location user."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Signed in as an Admin, go to Administration, then Staff, and open Wesley McClure (wesley.mcclure@staging.shopview.local). Write down the role and location access first so they can be put back — they were Technician at Staging Lethbridge - 4310."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Set that person's role to Sales Representative and give them access to exactly one location, Staging Lethbridge - 4310. Save."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Sign out."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Sign in as Wesley McClure and open Reports, then Sales By Customer."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Look along the report toolbar, to the right of the date range, Product Type and Customer controls. The Location chooser is there, reading \"Location - All locations\"."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Repeat step 5 on Sales By Representative, Parts Velocity, Technician Utilization, Work In Progress and Inventory Value."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Put Wesley McClure back to the role Technician at Staging Lethbridge - 4310."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The Location chooser is shown on all six reports to a user with access to only one location. It reads \"Location - All locations\", carries a clear button and a dropdown arrow, and opening it offers the single location that person can reach. Nothing they do with it changes what they see."}]},{"type":"paragraph","content":[{"type":"text","text":"The per-row Location column behaves correctly for the same user on five of the six reports — it is properly absent — so this is about the chooser, not the column."}]},{"type":"mediaSingle","attrs":{"layout":"align-start"},"content":[{"type":"media","attrs":{"type":"file","id":"774cf1c3-eda1-4781-a7b3-e00137942b08","alt":"sales-by-customer-single-location-chooser.png","collection":""}}]},{"type":"paragraph","content":[{"type":"text","text":"Sales By Customer, signed in as Wesley McClure at Staging Lethbridge - 4310, with the Location chooser shown."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"A user with access to only one location does not see the Location chooser at all, on any of the six reports. The report simply shows that one location's data."}]},{"type":"rule"},{"type":"paragraph","content":[{"type":"text","text":"Source","marks":[{"type":"strong"}]},{"type":"text","text":" — "},{"type":"text","text":"the "},{"type":"text","text":"Parts Velocity report specification","marks":[{"type":"link","attrs":{"href":"https://shopview.atlassian.net/wiki/spaces/~712020aa00b8d6a71f4259891982a304227c20/pages/620888066/Parts+Velocity+Report"}}]},{"type":"text","text":" on Confluence, version 5, requirement S2-E4: “A user with access to only one location does not see the Location filter; it is hidden for a single-location user.”"}]},{"type":"paragraph","content":[{"type":"text","text":"The same requirement is now in three more descriptions in the same words — Technician Utilization version 6 requirement S9-N1, Inventory Value version 4 requirement S7-N1, and Sales By Representative version 17 requirement S21-N1."}]},{"type":"paragraph","content":[{"type":"text","text":"Chris Ward's answer in our questions spreadsheet","marks":[{"type":"link","attrs":{"href":"https://docs.google.com/spreadsheets/d/1x8cuYJlFsDHalVZZTh156_ZCq2gcOaGY/edit?usp=sharing&ouid=106388879401921597782&rtpof=true&sd=true"}}]},{"type":"text","text":": “Change the product to match your ruling - hide it”"}]},{"type":"paragraph","content":[{"type":"text","text":"That answer is from the tab \"The product vs your write-up\", row 6, on 5 August 2026, and he then had the four descriptions above corrected to match it. The Sales By Customer and Work In Progress descriptions still say nothing either way about the chooser for a single-location user, so for those two reports his answer is the source on its own."}]}]},"customfield_10252":null,"timetracking":{},"customfield_10015":null,"security":null,"attachment":[{"self":"https://shopview.atlassian.net/rest/api/3/attachment/59340","id":"59340","filename":"sales-by-customer-single-location-chooser.png","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"created":"2026-08-05T07:05:00.641-0500","size":98237,"mimeType":"image/png","content":"https://shopview.atlassian.net/rest/api/3/attachment/content/59340","thumbnail":"https://shopview.atlassian.net/rest/api/3/attachment/thumbnail/59340"}],"aggregatetimeestimate":null,"summary":"Location chooser is shown to a user who has access to only one location, on all six new reports","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"subtasks":[],"customfield_10285":null,"reporter":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.