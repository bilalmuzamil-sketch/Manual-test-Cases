Medium","id":"3"},"labels":[],"customfield_10016":null,"customfield_10019":"0|i01v81:","timeestimate":null,"aggregatetimeoriginalestimate":null,"versions":[],"customfield_10418":null,"customfield_10419":null,"issuelinks":[{"id":"32057","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32057","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54913","key":"SV-8797","self":"https://shopview.atlassian.net/rest/api/3/issue/54913","fields":{"summary":"Mobile Filter Bar","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10350","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready for QA","id":"10350","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A2713e405-8836-4dee-8802-255f15740bbe","accountId":"712020:2713e405-8836-4dee-8802-255f15740bbe","avatarUrls":{"48x48":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/48","24x24":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/24","16x16":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/16","32x32":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/32"},"displayName":"Dusan Radulovic","active":true,"timeZone":"America/Bogota","accountType":"atlassian"},"updated":"2026-08-06T08:38:40.697-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10004","description":"This work item is being actively worked on at the moment by the assignee.","iconUrl":"https://shopview.atlassian.net/","name":"In Progress","id":"10004","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"A Work Orders link that already carries a filter works on a desktop screen but not on a phone. On a phone the filter buttons light up as though the filter had been applied, while the list underneath shows a completely different set of work orders."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: ","marks":[{"type":"strong"}]},{"type":"text","text":"QA branch sv8785 — https://sv8785.qa.shopview.com/workorders. Phone-sized browser, 390 x 844 with touch on, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"On a phone, or in a browser window 390 pixels wide with touch turned on, sign in as an Admin and pick the location Staging Heavy Duty - 9919."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open this exact address: https://sv8785.qa.shopview.com/workorders?status=declined&tab=all"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Read the filter buttons above the list."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Read the status and the customer name on the work order cards below them."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"For a contrast in the same sitting, open the same address again in a desktop-sized window."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The filter buttons say a filter is on — \"All Filters (1)\" and \"Status (1)\" are both highlighted in blue."}]},{"type":"paragraph","content":[{"type":"text","text":"The cards listed are not Declined work orders at all. They are Estimate work orders for the customer Aagate Landscaping; the first three are S2-15017, S2-14846 and S2-13145."}]},{"type":"paragraph","content":[{"type":"text","text":"The same address in a desktop window lists Declined work orders correctly, so this happens only on the phone layout."}]},{"type":"paragraph","content":[{"type":"text","text":"For a developer: the list request the phone sends asks for status \"estimate\" instead of the \"declined\" the address asked for. Choosing Status and then Paid by hand is sent correctly, so only filter state arriving from the address bar is affected."}]},{"type":"paragraph","content":[{"type":"text","text":"The two screenshots below were taken on the phone layout at the moment described above."}]},{"type":"mediaSingle","attrs":{"width":412,"widthType":"pixel","localId":"e870d96bd011","layout":"align-start"},"content":[{"type":"media","attrs":{"type":"file","id":"7d8081e6-e8ae-498d-ad5f-a028429046bc","alt":"image-20260805-025923.png","collection":"","localId":"52fd4530752c","height":787,"width":412}}]},{"type":"mediaSingle","attrs":{"width":402,"widthType":"pixel","localId":"6d694337d711","layout":"align-start"},"content":[{"type":"media","attrs":{"type":"file","id":"79cea153-1115-48bd-85a2-550147615ccd","alt":"image-20260805-025741.png","collection":"","localId":"92b0c3ce294b","height":791,"width":402}}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The page opens with the Declined filter already applied and lists only Declined work orders, exactly as it does on a desktop screen."}]},{"type":"rule"},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Source"}]},{"type":"paragraph","content":[{"type":"text","text":"Epic SV-8785, story SV-8797 (Mobile Filter Bar), and the Filters specification (Confluence page 572030978), version 19."}]},{"type":"paragraph","content":[{"type":"text","text":"Requirement S11-R2: \"When a user opens a URL that contains filter state, the Work Orders page loads with those filters pre-applied and the table already filtered\"."}]},{"type":"paragraph","content":[{"type":"text","text":"Requirement S12-R2 makes it apply on a phone too: \"The filter chips behave like desktop with one exception (see S12-R5): tapping a chip opens its dropdown, selections update the chip appearance, and 'Clear filters' appears when active\". The one exception it names is about holding selections behind an Apply button, not about which records are listed."}]}]},"customfield_10252":null,"timetracking":{},"customfield_10015":null,"security":null,"attachment":[{"self":"https://shopview.atlassian.net/rest/api/3/attachment/59318","id":"59318","filename":"image-20260805-025741.png","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accoun