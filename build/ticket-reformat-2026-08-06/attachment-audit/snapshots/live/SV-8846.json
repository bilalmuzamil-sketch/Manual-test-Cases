","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32058","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54913","key":"SV-8797","self":"https://shopview.atlassian.net/rest/api/3/issue/54913","fields":{"summary":"Mobile Filter Bar","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10350","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready for QA","id":"10350","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A2713e405-8836-4dee-8802-255f15740bbe","accountId":"712020:2713e405-8836-4dee-8802-255f15740bbe","avatarUrls":{"48x48":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/48","24x24":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/24","16x16":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/16","32x32":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/32"},"displayName":"Dusan Radulovic","active":true,"timeZone":"America/Bogota","accountType":"atlassian"},"updated":"2026-08-06T08:29:02.635-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10453","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready to Fix","id":"10453","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"On a phone there is no Clear Filters button, so a user who has switched several filters on cannot switch them all off in one go. Each filter has to be opened and cleared one at a time. The button is there on a desktop screen."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: ","marks":[{"type":"strong"}]},{"type":"text","text":"QA branch sv8785 — https://sv8785.qa.shopview.com/workorders. Phone-sized browser, 390 x 844 with touch on, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"On a phone, or in a browser window 390 pixels wide with touch turned on, sign in as an Admin and open Work Orders on the All tab."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Tap the Status button, then tap Paid. The list narrows to Paid work orders and the button now reads \"Status (1)\"."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Look for a \"Clear Filters\" button — in the row of filter buttons and anywhere else on the page."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"For a contrast in the same sitting, do the same two taps on the same account in a desktop-sized window and look again."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"There is no Clear Filters button anywhere on the phone screen, even though the Status button is highlighted and reads \"Status (1)\" and the All Filters button reads \"All Filters (1)\"."}]},{"type":"paragraph","content":[{"type":"text","text":"The only way to remove a filter is to open each one in turn and use Clear Selection inside it."}]},{"type":"paragraph","content":[{"type":"text","text":"On the same account in a desktop window the Clear Filters button does appear, so this is specific to the phone layout."}]},{"type":"paragraph","content":[{"type":"text","text":"The two screenshots below show the phone screen with the filter on and no Clear Filters button present."}]},{"type":"mediaSingle","attrs":{"width":399,"widthType":"pixel","localId":"1039e6e7a1a4","layout":"align-start"},"content":[{"type":"media","attrs":{"type":"file","id":"c0e48765-de57-4774-8e7c-b19cdc05c687","alt":"image-20260805-030120.png","collection":"","localId":"e63a043f1d05","height":780,"width":399}}]},{"type":"mediaSingle","attrs":{"width":921,"widthType":"pixel","localId":"1457bc6526dc","layout":"align-start"},"content":[{"type":"media","attrs":{"type":"file","id":"8922699b-f045-4135-9151-daa407db8dfb","alt":"image-20260805-030046.png","collection":"","localId":"d14439faf2ea","height":736,"width":1687}}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"Once at least one filter is on, a \"Clear Filters\" button appears on the phone just as it does on a desktop screen, so every filter can be removed in one tap."}]},{"type":"rule"},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Source"}]},{"type":"paragraph","content":[{"type":"text","text":"Epic SV-8785, story SV-8797 (Mobile Filter Bar), and the Filters specification (Confluence page 572030978), version 19."}]},{"type":"paragraph","content":[{"type":"text","text":"Requirement S7-R3: \"When at least one filter is active, a 'Clear filters' button appears in the filter bar to the right of all chips\"."}]},{"type":"paragraph","content":[{"type":"text","text":"Requirement S12-R2 applies it to a phone: \"The filter chips behave like desktop with one exception (see S12-R5): tapping a chip opens its dropdown, selections update the chip appearance, and 'Clear filters' appears when active\". Requirement S12-R6 closes with the same point: \"'Clear selection' and 'Clear filters' behave as on desktop.\""}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[{"self":"https://shopview.atlassian.net/rest/api/3/attachment/59321","id":"59321","filename":"image-20260805-030046.png","author":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfa