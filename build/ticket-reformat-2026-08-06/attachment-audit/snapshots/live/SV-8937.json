scription":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}},{"id":"32123","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32123","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54675","key":"SV-8654","self":"https://shopview.atlassian.net/rest/api/3/issue/54675","fields":{"summary":"Tech Util - Story 7 - Export to PDF and CSV","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}},{"id":"32124","self":"https://shopview.atlassian.net/rest/api/3/issueLink/32124","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54634","key":"SV-8613","self":"https://shopview.atlassian.net/rest/api/3/issue/54634","fields":{"summary":"SBC - Story 15 - Download as PDF","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":null,"updated":"2026-08-06T08:32:47.253-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10349","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Open","id":"10349","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"Three reports print a heading line in their PDF describing the date range the file covers, and that line always shows an end date one day later than the range asked for. It happens on Parts Velocity, Technician Utilization and Sales By Customer."}]},{"type":"paragraph","content":[{"type":"text","text":"The spreadsheet of exactly the same view prints the correct end date, so the two files disagree about the same report."}]},{"type":"paragraph","content":[{"type":"text","text":"On Parts Velocity and Technician Utilization the line also begins with a stray word — \"Start Date Range:\" rather than \"Date Range:\"."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: QA branch sv8582 (https://sv8582.qa.shopview.com). Desktop browser, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Reports, then Parts Velocity, with both locations, Staging Heavy Duty - 9919 and Staging Lethbridge - 4310 selected and Type set to Both, and type BRAKECLEAN into the report's search box so the view is small enough to download."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the date picker, build a range from 1 January 2026 to 31 July 2026, and press Apply."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open the three-dot menu, choose Download (PDF), and read the heading line under the report title. Then choose Download (CSV) for the same view and read its first line."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Reports, then Technician Utilization, set the date range to This Year, and choose Summary (PDF). Read the heading line."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Open Reports, then Sales By Customer, leave the date range on This Month, and choose Download Summary (PDF). Read the heading line."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"Parts Velocity, asked for 1 January to 31 July 2026, printed \"Start Date Range: Jan 1, 2026 - Aug 1, 2026\". Asked for 1 to 28 February it printed \"Feb 1, 2026 - Mar 1, 2026\". Asked for 1 January to 6 August it printed \"Aug 7, 2026\" while the spreadsheet of the same view correctly printed \"Aug 6, 2026\"."}]},{"type":"paragraph","content":[{"type":"text","text":"Technician Utilization, asked for 1 January to 6 August, printed \"Start Date Range: Jan 1, 2026 - Aug 7, 2026\". Sales By Customer, asked for 1 to 6 August, printed \"Date Range: Aug 1, 2026 - Aug 7, 2026\" — the label is right there, only the end date is a day late."}]},{"type":"paragraph","content":[{"type":"text","text":"It is not the month rolling over: 28 February came out as 1 March. It is not today's date being printed: on 6 August a range ending 31 July printed 1 August. Work In Progress prints its heading correctly, so it is not every report."}]},{"type":"paragraph","content":[{"type":"text","text":"Only the heading line was proven wrong. Nothing was established either way about the reports' own figures."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"The PDF heading describes the range the report was actually run for — a range ending 6 August reads 6 August — and the label reads \"Date Range:\", as it already does on Sales By Customer."}]},{"type":"rule"},{"type":"paragraph","content":[{"type":"text","text":"Source","marks":[{"type":"strong"}]},{"type":"text","text":" — "},{"type":"text","text":"the "},{"type":"text","text":"Sales By Customer report specification","marks":[{"type":"link","attrs":{"href":"https://shopview.atlassian.net/wiki/spaces/~712020aa00b8d6a71f4259891982a304227c20/pages/577634305/SBC+Sales+By+Customer+Report"}}]},{"type":"text","text":" on Confluence, version 15, requirement S15-R11: “The header date range shows the start and end dates in the format \"Mon D, YYYY,\" joined by an em dash — for example, \"May 1, 2026 — May 31, 2026.\"”"}]},{"type":"paragraph","content":[{"type":"text","text":"The "},{"type":"text","text":"Parts Velocity report specification","marks":[{"type":"link","attrs":{"href":"https://shopview.atlassian.net/wiki/spaces/~712020aa00b8d6a71f4259891982a304227c20/pages/620888066/Parts+Velocity+Report"}}]},{"type":"text","text":" on Confluence, version 5, requirement S6-R2: “Both exports reflect the date range, type, category, vendor, bin location, location, and search active at the time of export.”"}]},{"type":"paragraph","content":[{"type":"text","text":"The "},{"type":"text","text":"Technician Utilization report specification","marks":[{"type":"link","attrs":{"href":"https://shopview.atlassian.net/wiki/spaces/~712020aa00b8d6a71f4259891982a304227c20/pages/641400833/Technician+Utilization+Report"}}]},{"type":"text","text":" on Confluence, version 6, requirement S7-R9: “Every download covers the date range that is currently active on the report.”"}]},{"type":"paragraph","content":[{"type":"text","text":"One honest caveat about the label: none of the three descriptions writes down the words the heading should begin with, so \"Start Date Range:\" breaks no written rule. What makes it wrong is that the same line reads \"Date Range:\" on Sales By Customer, so one heading is worded two ways across reports meant to match. If the product owner would rather keep \"Start Date Range:\", that half can be dropped — the wrong end date stands on its own."}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[],"summary":"PDF heading shows an end date one day later than the range asked for, on three reports","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e