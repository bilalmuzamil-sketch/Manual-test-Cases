shopview.atlassian.net/rest/api/3/issueLink/32083","type":{"id":"10003","name":"Relates","inward":"relates to","outward":"relates to","self":"https://shopview.atlassian.net/rest/api/3/issueLinkType/10003"},"outwardIssue":{"id":"54914","key":"SV-8798","self":"https://shopview.atlassian.net/rest/api/3/issue/54914","fields":{"summary":"Page Search","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10350","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready for QA","id":"10350","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/4","id":4,"key":"indeterminate","colorName":"yellow","name":"In Progress"}},"priority":{"self":"https://shopview.atlassian.net/rest/api/3/priority/3","iconUrl":"https://shopview.atlassian.net/images/icons/priorities/medium_new.svg","name":"Medium","id":"3"},"issuetype":{"self":"https://shopview.atlassian.net/rest/api/3/issuetype/10245","id":"10245","description":"Stories track functionality or features expressed as user goals.","iconUrl":"https://shopview.atlassian.net/rest/api/2/universal_avatar/view/type/issuetype/avatar/10315?size=medium","name":"Story","subtask":false,"avatarId":10315,"entityId":"2d932db9-30a4-451f-aa74-561885726568","hierarchyLevel":0}}}}],"assignee":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A2713e405-8836-4dee-8802-255f15740bbe","accountId":"712020:2713e405-8836-4dee-8802-255f15740bbe","avatarUrls":{"48x48":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/48","24x24":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/24","16x16":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/16","32x32":"https://avatar-management--avatars.us-west-2.prod.public.atl-paas.net/712020:2713e405-8836-4dee-8802-255f15740bbe/832e860f-3dc4-40b8-9f51-f126c44786ca/32"},"displayName":"Dusan Radulovic","active":true,"timeZone":"America/Bogota","accountType":"atlassian"},"updated":"2026-08-06T08:29:06.878-0500","status":{"self":"https://shopview.atlassian.net/rest/api/3/status/10453","description":"","iconUrl":"https://shopview.atlassian.net/","name":"Ready to Fix","id":"10453","statusCategory":{"self":"https://shopview.atlassian.net/rest/api/3/statuscategory/2","id":2,"key":"new","colorName":"blue-gray","name":"To Do"}},"components":[],"timeoriginalestimate":null,"description":{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Description"}]},{"type":"paragraph","content":[{"type":"text","text":"On a phone there is no page search for the work order list. The magnifier button in the action row opens the application-wide search instead, and that does not narrow the list. Page search works normally on a desktop screen."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Steps to reproduce"}]},{"type":"paragraph","content":[{"type":"text","text":"Environment: ","marks":[{"type":"strong"}]},{"type":"text","text":"QA branch sv8785 — https://sv8785.qa.shopview.com/workorders. Phone-sized browser, 390 x 844 with touch on, signed in as an Admin."}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"On a phone, or in a browser window 390 pixels wide with touch turned on, sign in as an Admin and open Work Orders. There are 30 work orders in the list on the All tab."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Look at the action row. The only search control is the magnifier button."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Tap the magnifier button."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Type the customer name Bahampton Holdings, which has 6 work orders, so a working page search would visibly narrow the list to those 6."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Watch the work order list and the address bar as you type."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"For a contrast in the same sitting, type the same name into the page search on a desktop-sized window."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Current behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"There is no page search on the phone at all. Tapping the magnifier opens the application-wide search box, with its own close button beside it."}]},{"type":"paragraph","content":[{"type":"text","text":"Typing Bahampton Holdings into it does not narrow the list. The list stays at 30 work orders and the address bar stays as it was, with no search added to it."}]},{"type":"paragraph","content":[{"type":"text","text":"The same name typed into the page search on a desktop window does narrow the list correctly, so the search term is not the problem — the control is simply missing on the phone."}]},{"type":"paragraph","content":[{"type":"text","text":"For a developer: the desktop page-search control is not present in the page at all on a phone-sized screen, and the Create Work Order button keeps a width of 332 pixels on a 390 pixel screen, so there is no free space in the action row for a search field to open into."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Expected behaviour"}]},{"type":"paragraph","content":[{"type":"text","text":"On a phone the page search opens in place inside the action row, about 162 pixels wide, and narrows the work order list as the user types, exactly as it does on a desktop screen. The Create Work Order button shrinks to its natural width to make room. The application-wide search is a separate control and does not stand in for it."}]},{"type":"rule"},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Source"}]},{"type":"paragraph","content":[{"type":"text","text":"Epic SV-8785, story SV-8798 (Page Search), and the Filters specification (Confluence page 572030978), version 19."}]},{"type":"paragraph","content":[{"type":"text","text":"Requirement S13-R16: \"Mobile uses the same inline expansion as desktop. There is no modal, no separate search screen, and no mobile-only state in the component. Tapping the collapsed control expands it in place within the action row, moves focus into the field and raises the keyboard\"."}]},{"type":"paragraph","content":[{"type":"text","text":"Requirement S13-R17: \"On mobile the expanded field fills the remaining width of the action row rather than taking the fixed 180px desktop width. On Work Orders that resolves to 162px. All other toolbar actions remain visible and in position throughout; nothing is hidden while searching\"."}]},{"type":"paragraph","content":[{"type":"text","text":"Requirement S13-R18: \"To create that room, the primary CTA on mobile uses its natural hug width instead of stretching to fill the row: 'New Work Order' is 144px, the same width it has on desktop, not 211px.\""}]},{"type":"paragraph","content":[{"type":"text","text":"Requirement S13-R9 keeps the two searches apart: \"Search is scoped strictly to the records in the current table. It never returns results from another table, another page, another module, or any content outside that table.\" So the application-wide search cannot stand in for the page search."}]}]},"customfield_10015":null,"timetracking":{},"security":null,"aggregatetimeestimate":null,"attachment":[],"summary":"On a phone there is no page search: the magnifier opens global search, which does not narrow the list (S13-R17/R18)","creator":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Muzamil","active":true,"timeZone":"Asia/Karachi","accountType":"atlassian"},"subtasks":[],"customfield_10285":null,"reporter":{"self":"https://shopview.atlassian.net/rest/api/3/user?accountId=712020%3A6d590212-5c9b-4135-ae11-277f3826110e","accountId":"712020:6d590212-5c9b-4135-ae11-277f3826110e","emailAddress":"bilal.muzamil@shopview.com","avatarUrls":{"48x48":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","24x24":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","16x16":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png","32x32":"https://secure.gravatar.com/avatar/939e0aa31ab923104bfaac4c5012d8c0?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FBM-2.png"},"displayName":"Bilal Mu