  "updated": "2026-08-06T02:50:10.066-0500",
  "status": {
   "self": "https://shopview.atlassian.net/rest/api/3/status/10349",
   "description": "",
   "iconUrl": "https://shopview.atlassian.net/",
   "name": "Open",
   "id": "10349",
   "statusCategory": {
    "self": "https://shopview.atlassian.net/rest/api/3/statuscategory/2",
    "id": 2,
    "key": "new",
