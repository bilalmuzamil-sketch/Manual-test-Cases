  "status": {
   "self": "https://shopview.atlassian.net/rest/api/3/status/10453",
   "description": "",
   "iconUrl": "https://shopview.atlassian.net/",
   "name": "Ready to Fix",
   "id": "10453",
   "statusCategory": {
    "self": "https://shopview.atlassian.net/rest/api/3/statuscategory/2",
    "id": 2,
    "key": "new",
