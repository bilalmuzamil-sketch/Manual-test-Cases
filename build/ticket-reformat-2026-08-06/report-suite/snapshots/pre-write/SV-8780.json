  "components": [],
  "timeoriginalestimate": null,
  "description": {
   "type": "doc",
   "version": 1,
   "content": [
    {
     "type": "paragraph",
     "attrs": {
      "localId": "5c051f9fc5cc"
     }
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "Right now the new "
      },
      {
       "type": "text",
       "text": "Sales By Customer",
       "marks": [
        {
         "type": "strong"
        }
       ]
      },
      {
       "type": "text",
       "text": " report can only be opened by someone given a "
      },
      {
       "type": "text",
       "text": "special permission just for that one report",
       "marks": [
        {
         "type": "strong"
        }
       ]
      },
      {
       "type": "text",
       "text": ". Every other report opens for anyone who already has normal reports access."
      }
     ],
     "attrs": {
      "localId": "3dbb982f766f"
     }
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "You've said all reports should just open with normal reports access. "
      },
      {
       "type": "text",
       "text": "Should we make Sales By Customer work the same way as the others?",
       "marks": [
        {
         "type": "strong"
        }
       ]
      }
     ],
     "attrs": {
      "localId": "c035339ef272"
     }
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "Note: the written spec currently says the "
      },
      {
       "type": "text",
       "text": "opposite",
       "marks": [
        {
         "type": "em"
        }
       ]
      },
      {
       "type": "text",
       "text": " \u2014 that this report needs its own dedicated permission (SBC spec, Story 1, "
      },
      {
       "type": "text",
       "text": "S1-R2",
       "marks": [
        {
         "type": "strong"
        }
       ]
      },
      {
       "type": "text",
       "text": ", v12, 29 Jul):"
      }
     ],
     "attrs": {
      "localId": "3e17d4735506"
     }
    },
    {
     "type": "blockquote",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "\"The report is gated by a dedicated Sales By Customer report View permission \u2014 it is not tied to a generic 'all reports' permission.\""
        }
       ],
       "attrs": {
        "localId": "f9c5d3a3146c"
       }
      }
     ],
     "attrs": {
      "localId": "8943dea1cfef"
     }
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "Kindly Confirm."
      }
     ],
     "attrs": {
      "localId": "0f02b91db6f2"
     }
    },
    {
     "type": "bulletList",
     "content": [
      {
       "type": "listItem",
       "attrs": {
        "localId": "f25d56a260c3"
       },
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "( ) "
          },
          {
           "type": "text",
           "text": "Yes",
           "marks": [
            {
             "type": "strong"
            }
           ]
          },
          {
           "type": "text",
           "text": " \u2014 open it with normal reports access, like the others (we'll fix the build and update the spec)"
          }
         ],
         "attrs": {
          "localId": "968db20a615e"
         }
        }
       ]
      },
      {
       "type": "listItem",
       "attrs": {
        "localId": "c531a4e4cf87"
       },
       "content": [
        {
         "type": "paragraph",
         "content": [
          {
           "type": "text",
           "text": "( ) "
          },
          {
           "type": "text",
           "text": "No",
           "marks": [
            {
             "type": "strong"
            }
           ]
          },
          {
           "type": "text",
           "text": " \u2014 keep its own separate permission (we'll leave it as is)"
          }
         ],
         "attrs": {
          "localId": "b48b82e57e1d"
         }
        }
       ]
      }
     ],
     "attrs": {
      "localId": "0d7a71ceeb18"
     }
    }
   ]
  },
