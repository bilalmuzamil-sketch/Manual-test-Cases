  "updated": "2026-08-06T02:50:25.729-0500",
  "status": {
   "self": "https://shopview.atlassian.net/rest/api/3/status/10349",
   "description": "",
   "iconUrl": "https://shopview.atlassian.net/",
   "name": "Open",
   "id": "10349",
   "statusCategory": {
