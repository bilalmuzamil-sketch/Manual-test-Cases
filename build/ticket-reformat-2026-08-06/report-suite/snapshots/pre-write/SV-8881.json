      {
       "type": "text",
       "text": "four",
       "marks": [
        {
         "type": "strong"
        }
       ]
      },
      {
       "type": "text",
       "text": " \u2014 a separate spreadsheet option for the Summary and the Expanded views. The product owner's answer settles the "
      },
      {
       "type": "text",
       "text": "wording",
       "marks": [
        {
         "type": "strong"
        }
       ]
      },
      {
       "type": "text",
       "text": " in his own words but does not explicitly state the "
