  {
   "type": "paragraph",
   "content": [
    {
     "type": "text",
     "text": "A separate matter, noted here only so it is not lost:",
     "marks": [
      {
       "type": "strong"
      }
     ]
    },
    {
     "type": "text",
     "text": " Inventory Value keeps the Location "
