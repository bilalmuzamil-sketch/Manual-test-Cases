         "type": "text",
         "text": "Inventory Value",
         "marks": [
          {
           "type": "strong"
          }
         ]
        },
        {
         "type": "text",
         "text": " report."
        }
       ]
      }
     ]
    },
    {
     "type": "listItem",
     "content": [
