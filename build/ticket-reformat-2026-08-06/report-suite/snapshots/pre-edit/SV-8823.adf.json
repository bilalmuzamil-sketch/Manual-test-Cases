         "marks": [
          {
           "type": "strong"
          }
         ]
        },
        {
         "type": "text",
         "text": ". The screen loses those two columns, as it should."
        }
       ]
      }
     ]
    },
    {
     "type": "listItem",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Open the "
        },
        {
         "type": "text",
