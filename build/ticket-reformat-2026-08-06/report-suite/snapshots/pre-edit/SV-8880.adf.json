            {
             "type": "text",
             "text": "Customers"
            }
           ]
          }
         ]
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": " \u2014 how many different customers they sold to"
        }
       ]
      }
     ]
    },
    {
     "type": "listItem",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Hrs Worked",
