n":{"type":"object","properties":{"id":{"type":"integer"},"project_id":{"type":"integer"},"milestone_id":{"type":["integer","null"]},"name":{"type":"string"},"description":{"type":["string","null"],"description":"Sanitized HTML"},"include_all":{"type":"boolean"},"assigned_to":{"type":["integer","null"]},"external_key":{"type":["string","null"]},"is_closed":{"type":"boolean"},"closed_at":{"type":["string","null"],"format":"date-time"},"closed_by":{"type":["integer","null"]},"counts":{"$ref":"#\/components\/schemas\/Counts"},"created_by":{"type":"integer"},"updated_by":{"type":"integer"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},"CreateRun":{"type":"object","required":["name","selection"],"properties":{"name":{"type":"string","maxLength":255},"description":{"type":["string","null"]},"milestone_id":{"type":["integer","null"]},"assigned_to":{"type":["integer","null"]},"external_key":{"type":["string","null"],"maxLength":100,"description":"Idempotency key (for example the CI run id): the same key returns the existing run with 200."},"selection":{"$ref":"#\/components\/schemas\/Selection"}}},"Attachment":{"type":"object","properties":{"id":{"type":"integer"},"owner_type":{"const":"result"},"owner_id":{"type":"integer"},"filename":{"type":"string"},"mime":{"type":"string"},"size_bytes":{"type":"integer"},"created_by":{"type":"integer"},"created_at":{"type":"string","format":"date-time"},"url":{"type":"string","description":"Needs the same Authorization header."}}},"Result":{"type":"object","properties":{"id":{"type":"integer"},"run_item_id":{"type":"integer"},"run_id":{"type":"integer"},"case_id":{"type":"integer"},"status":{"$ref":"#\/components\/schemas\/StatusId"},"comment":{"type":["string","null"],"description":"Plain text; ANSI color codes are kept."},"elapsed_seconds":{"type":["integer","null"]},"version":{"type":["string","null"]},"defects":{"type":["string","null"],"example":"SV-1, SV-2"},"source":{"t