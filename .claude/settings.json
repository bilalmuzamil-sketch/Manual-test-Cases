{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "R=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$R/build/testing-tools/session_start_recall.sh\" ] && bash \"$R/build/testing-tools/session_start_recall.sh\" 2>/dev/null; exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "R=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$R/build/testing-tools/learning_gate.py\" ] && exec python3 \"$R/build/testing-tools/learning_gate.py\"; exit 0",
            "timeout": 180,
            "statusMessage": "Checking learning is saved and nothing got worse (Rules 127-129)"
          }
        ]
      }
    ]
  }
}
